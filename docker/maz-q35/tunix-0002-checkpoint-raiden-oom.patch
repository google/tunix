+_UNRECOVERABLE_HARDWARE_SIGNATURES = (
+    "detected dead by scheduler",
+    "device set permanently lost",
+)
+
+_UNRECOVERABLE_TRANSPORT_SIGNATURES = (
+    "data_loss",
+    "stream removed",
+)
+
+_FATAL_EXIT_GRACE_SECONDS = 3.0
+_fatal_exit_scheduled = threading.Event()
+
+
+def _is_unrecoverable_runtime_error(exc: BaseException) -> bool:
+  """Returns whether `exc` indicates the accelerator device set is lost."""
+  text = f"{type(exc).__name__}: {exc}".lower()
+  if any(sig in text for sig in _UNRECOVERABLE_HARDWARE_SIGNATURES):
+    return True
+  exc_type = type(exc).__name__.lower()
+  is_runtime_transport = any(
+      t in exc_type or t in text
+      for t in ("pathways", "xla", "grpc", "unavailable", "channel")
+  )
+  if is_runtime_transport and any(
+      sig in text for sig in _UNRECOVERABLE_TRANSPORT_SIGNATURES
+  ):
+    return True
+  return False
+
+
+def _schedule_fatal_exit(exc: BaseException) -> None:
+  """Answers the caller, then exits the process so the JobSet can rebuild it."""
+  if _fatal_exit_scheduled.is_set():
+    return
+  _fatal_exit_scheduled.set()
+
+  logging.error(
+      "Unrecoverable runtime error: accelerator device set lost. Exiting in"
+      " %.0fs to allow clean container restart. Triggering error: %s: %s",
+      _FATAL_EXIT_GRACE_SECONDS,
+      type(exc).__name__,
+      exc,
+  )
+
+  def _exit() -> None:
+    logging.error("Exiting process now with status 1.")
+    os._exit(1)  # pylint: disable=protected-access
+
+  timer = threading.Timer(_FATAL_EXIT_GRACE_SECONDS, _exit)
+  timer.daemon = True
+  timer.start()
+
+
