+      # fallback branch below already drops it for the same reason. The test is
+      # `"metadata" in payload.__dataclass_fields__` rather than `hasattr`, because
+      # `dataclasses.replace` accepts only init fields and a `metadata` property would
+      # raise.
+      if dataclasses.is_dataclass(payload) and "metadata" in payload.__dataclass_fields__:
+        payload = dataclasses.replace(payload, metadata={})
       return self._gen_model_input_fn(payload)
