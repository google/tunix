+  xprof_stop_step="$(grep -a 'phase=update stopped ' "$raw" | sed -n 's/.*step=\([0-9]*\).*/\1/p' | head -1 || true)"
+  xprof_armed_step="$(grep -a 'phase=update armed ' "$raw" | sed -n 's/.*step=\([0-9]*\).*/\1/p' | head -1 || true)"
+fi
