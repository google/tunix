#!/usr/bin/env bash
set -euo pipefail
LABEL="${1:-p56a_update_$(date +%Y%m%d_%H%M%S)}"
ROOT_DIR="/mnt/disks/tunix-data/xprof_out/${LABEL}"
CANON_OUT="/mnt/disks/tunix-data/canon_out_p51"
REPO_DIR="/mnt/disks/tunix-data/tunix_code_rl"
IMAGE="tunix_frozenlake_image:vllm-tpu0.25.0"
SP="/usr/local/lib/python3.12/site-packages/tpu_inference"
echo "[P56.XPROF] Setting up clean canonical overlay for label: $LABEL..."
rm -rf "$CANON_OUT" "$ROOT_DIR"
mkdir -p "$CANON_OUT" "$ROOT_DIR/perf" "$ROOT_DIR/xprof" "$ROOT_DIR/logs" "$ROOT_DIR/wandb"
bash "$REPO_DIR/canon-zero-tim/install.sh" "$CANON_OUT" --from-image "$IMAGE" --model qwen1p7b
echo "[P56.XPROF] Launching official tunix/perf container with phase=update and label $LABEL..."
