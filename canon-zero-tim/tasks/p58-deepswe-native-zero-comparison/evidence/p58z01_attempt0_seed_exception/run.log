+  _CANON_XPROF["completed_steps"] += 1
+  completed = _CANON_XPROF["completed_steps"]
+  _CANON_XPROF["profiler"].maybe_activate(completed)
+  _CANON_XPROF["profiler"].maybe_deactivate(completed)
