[rank0]: tunix.rl.alignment.AlignmentGateError: alignment gate RED mode=train: ['CANON_ENGINE_MODULE_C!=1']; report=/tmp/canon-state/canon-p57-fl-is-i45a-26f9f4a2/alignment.jsonl
