# Contract-only DP16xTP4 FrozenLake profile. Full launch remains fail-closed.

_CANON_PROFILE_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
# shellcheck disable=SC1091
source "$_CANON_PROFILE_DIR/qwen3-8b-dp16-tp4-admission.env"
unset _CANON_PROFILE_DIR

export CANON_PROFILE=qwen3-8b-dp16-tp4-frozenlake
export CANON_P32_WORKLOAD=frozenlake
export CANON_P32_TRAIN_ADMITTED="${CANON_P32_TRAIN_ADMITTED:-0}"
export CANON_P32_DP_REDUCTION_ADMITTED="${CANON_P32_DP_REDUCTION_ADMITTED:-0}"
export CANON_P33_WORKLOAD_LAUNCH_ADMITTED="${CANON_P33_WORKLOAD_LAUNCH_ADMITTED:-0}"
export CANON_P33_NO_COMMIT="${CANON_P33_NO_COMMIT:-0}"
if [ "$CANON_P33_NO_COMMIT" = "1" ]; then
  _CANON_P33_DEFAULT_STAGE=backward-no-commit
else
  _CANON_P33_DEFAULT_STAGE=full
fi
export CANON_P33_RUN_STAGE="${CANON_P33_RUN_STAGE:-$_CANON_P33_DEFAULT_STAGE}"
unset _CANON_P33_DEFAULT_STAGE
export CANON_P33_DISABLE_EVAL=1
export CANON_WANDB_ONLINE_REQUIRED=1
export CANON_P31_MONOTONIC_METRICS=1
export WANDB_MODE=online
export FL_SHARED_MESH="${CANON_P33_SHARED_MESH:-1,4}"
export CANON_P32_DP16_SEGMENTED=1
export CANON_P28_SEGMENTED_FORWARD=1
export CANON_P28_SEGMENTED_VJP=0
export CANON_P28_SEGMENTED_TRAIN=1
export CANON_P28_G6_UPDATE=1
export CANON_P29_FULL_TRAIN=1
export CANON_FROZENLAKE_L3=1
export CANON_FROZENLAKE_P27=1
export CANON_ALIGNMENT_GATE=1
export CANON_ALIGNMENT_GATE_ONLY=0
export CANON_ALIGNMENT_UPDATE_CANARY=0
export CANON_ALIGNMENT_TRAIN=1
export CANON_P30_OPT_STATE_OFFLOAD=1
export CANON_P30_SPARSE_GRAD_ASSEMBLY=1
export CANON_P30_FUSED_PAIR_ACCUMULATION=0
export CANON_P30_REUSE_SEGMENTED_ENGINE=1
export CANON_P30_RELEASE_CAPTURED_STATE=1
export CANON_P30_POST_COMMIT_GC=0
export CANON_P30_DONATE_MODEL=0
export CANON_P30_SHARDING_PROFILE=1
export CANON_P30_RESHARD_ACCUMULATOR=1
export CANON_WANDB_PROJECT=zero-tim-frozenlake-dp16-tp4
export CANON_WANDB_GROUP=qwen3-8b-dp16-tp4
export CANON_WANDB_RUN_NAME="${CANON_WANDB_RUN_NAME:-p33-frozenlake-${CANON_P33_RUN_STAGE}-attempt-${JOBSET_RESTART_ATTEMPT:-unknown}}"
