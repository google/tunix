# P57 TIM study profile. P57.1 calibration derives topology and capacity from
# the P45 carrier, then removes the full zero-TIM numerical bundle. Paired
# training remains phase-gated and is not certified by calibration readiness.

_CANON_P57_PROFILE_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
# shellcheck disable=SC1091
source "$_CANON_P57_PROFILE_DIR/qwen3-8b-dp8-tp8-frozenlake-resident.env"
unset _CANON_P57_PROFILE_DIR

export CANON_PROFILE=qwen3-8b-dp8-tp8-frozenlake-tim

# P57.1 uses the untreated, high-throughput numerical program for calibration
# and the selected M15 stock curve.  The shared P45 profile contributes only
# topology, model/TP overlay, resident optimizer, checkpointing, and telemetry.
# Use `unset` for presence-sensitive switches and literal zero for boolean
# numerical paths.  Training keeps only launch admission and the warning-only
# alignment observer so the mismatch dose is measured without changing the
# program that receives gradients.
if [ "${CANON_P57_INFERENCE_REGIME:-}" = "stock-fast" ]; then
  unset CANON_FIXED_AR CANON_FIXED_AR_EMBED
  unset CANON_RPA_D CANON_RPA_P CANON_RPA_M CANON_LOGPROB_M
  unset CANON_PALLAS_ALL_PROJ CANON_PALLAS_ALL_RMSNORM
  unset CANON_PALLAS_SWIGLU CANON_PALLAS_MPAD
  unset CANON_PALLAS_SWIGLU_MPAD CANON_PALLAS_CANONICAL_VJP
  export XLA_FLAGS="--xla_cpu_max_isa=AVX2"
  export CANON_RPA_VJP2=0
  export CANON_VJP2_MAX_SEQS=0
  export CANON_PROMPT_PROCESSED_LOGPROBS=0
  export CANON_PALLAS_LOGSOFTMAX=0
  export CANON_ENGINE_MODULE_C=0
  export CANON_KV_UNIFIED=0
  export CANON_P32_DP_ADMISSION=0
  export CANON_P32_DP_REDUCTION_ADMITTED=0
  export CANON_P32_DP16_SEGMENTED=0
  export CANON_FROZENLAKE_L3=0
  export CANON_FROZENLAKE_P27=0
  export CANON_P28_SEGMENTED_FORWARD=0
  export CANON_P28_SEGMENTED_VJP=0
  export CANON_P28_SEGMENTED_TRAIN=0
  export CANON_P28_G6_UPDATE=0
  export CANON_P28_BATCHED_REPORT=0
  export CANON_P28_BATCHED_REVERSE=0
  export CANON_BATCHED_EVIDENCE=0
  export CANON_P29_FULL_TRAIN=0
  export CANON_P30_SPARSE_GRAD_ASSEMBLY=0
  export CANON_P30_FUSED_PAIR_ACCUMULATION=0
  export CANON_P30_REUSE_SEGMENTED_ENGINE=0
  export CANON_P30_RELEASE_CAPTURED_STATE=0
  export CANON_P30_RESHARD_ACCUMULATOR=0
  export CANON_ALIGNMENT_GATE_ONLY=0
  export CANON_ALIGNMENT_UPDATE_CANARY=0
  case "${CANON_P57_RUN_KIND:-}:${CANON_P57_TIM_ARM:-}" in
    calibration:mismatch)
      export CANON_P32_TRAIN_ADMITTED=0
      export CANON_P33_WORKLOAD_LAUNCH_ADMITTED=0
      export CANON_ALIGNMENT_GATE=0
      export CANON_ALIGNMENT_TRAIN=0
      export CANON_PRE_ALIGN_GATE=0
      export CANON_FROZENLAKE_ALIGNMENT_WARN_ONLY=0
      ;;
    train:mismatch)
      export CANON_P32_TRAIN_ADMITTED=1
      export CANON_P33_WORKLOAD_LAUNCH_ADMITTED=1
      export CANON_ALIGNMENT_GATE=1
      export CANON_ALIGNMENT_TRAIN=1
      export CANON_PRE_ALIGN_GATE=1
      export CANON_FROZENLAKE_ALIGNMENT_WARN_ONLY=1
      ;;
    eval:mismatch)
      export CANON_P32_TRAIN_ADMITTED=0
      export CANON_P33_WORKLOAD_LAUNCH_ADMITTED=1
      export CANON_ALIGNMENT_GATE=0
      export CANON_ALIGNMENT_TRAIN=0
      export CANON_PRE_ALIGN_GATE=0
      export CANON_FROZENLAKE_ALIGNMENT_WARN_ONLY=0
      ;;
    *)
      echo "[profile] stock-fast is admitted only for calibration or mismatch train/eval" >&2
      return 1 2>/dev/null || exit 1
      ;;
  esac
elif [ -n "${CANON_P57_INFERENCE_REGIME:-}" ]; then
  echo "[profile] unsupported P57 inference regime" >&2
  return 1 2>/dev/null || exit 1
fi

if [ -n "${CANON_P57_WORKLOAD_CANDIDATE:-}" ] || \
   [ -n "${CANON_P57_DATA_SPLIT:-}" ]; then
  case "${CANON_P57_WORKLOAD_CANDIDATE:-}" in
    l0) _canon_p57_max_turns=5 ;;
    m10) _canon_p57_max_turns=10 ;;
    m15) _canon_p57_max_turns=15 ;;
    m20) _canon_p57_max_turns=20 ;;
    *)
      echo "[profile] P57 workload recipe must be l0, m10, m15, or m20" >&2
      return 1 2>/dev/null || exit 1
      ;;
  esac
  case "${CANON_P57_DATA_SPLIT:-}" in
    calibration|selection|main) ;;
    *)
      echo "[profile] P57 data split must be calibration, selection, or main" >&2
      return 1 2>/dev/null || exit 1
      ;;
  esac
  for _canon_p57_workload_arg in \
    "--p57_workload_candidate=${CANON_P57_WORKLOAD_CANDIDATE}" \
    "--p57_data_split=${CANON_P57_DATA_SPLIT}" \
    "--env_max_steps=${_canon_p57_max_turns}"; do
    case " ${CANON_RUN_CMD:-} " in
      *" ${_canon_p57_workload_arg} "*) ;;
      *)
        echo "[profile] P57 materialized workload command drifted" >&2
        return 1 2>/dev/null || exit 1
        ;;
    esac
  done
  if [ "${CANON_P57_DATA_SPLIT}" = "calibration" ] && \
     [ "${CANON_P57_TIM_ARM:-}" != "mismatch" ]; then
    echo "[profile] P57 calibration workloads are stock-only" >&2
    return 1 2>/dev/null || exit 1
  fi
  unset _canon_p57_max_turns
  unset _canon_p57_workload_arg
elif [ -n "${CANON_P57_WORKLOAD_CANDIDATE:-}${CANON_P57_DATA_SPLIT:-}" ]; then
  echo "[profile] P57 workload candidate and data split must be set together" >&2
  return 1 2>/dev/null || exit 1
fi

case " ${CANON_RUN_CMD:-} " in
  *" python3 -u -m examples.frozenlake.train_frozenlake_qwen3 "*) ;;
  *)
    echo "[profile] P57 requires the package-safe FrozenLake module entrypoint" >&2
    return 1 2>/dev/null || exit 1
    ;;
esac

case "${CANON_P57_RUN_KIND:-}" in
  calibration)
    if [ "${CANON_P57_TIM_ARM:-}" != "mismatch" ] || \
       [ "${CANON_P57_INFERENCE_REGIME:-}" != "stock-fast" ] || \
       [ "${CANON_P38_FIXED_LM_HEAD:-0}" != "0" ] || \
       [ "${CANON_FROZENLAKE_ALIGNMENT_WARN_ONLY:-}" != "0" ] || \
       [ "${CANON_P32_TRAIN_ADMITTED:-}" != "0" ] || \
       [ "${CANON_P32_DP_REDUCTION_ADMITTED:-}" != "0" ] || \
       [ "${CANON_P33_WORKLOAD_LAUNCH_ADMITTED:-}" != "0" ] || \
       [ "${CANON_PRE_ALIGN_GATE:-}" != "0" ] || \
       [ "${CANON_P57_EXPECTED_UPDATES:-}" != "1" ] || \
       [ -n "${CANON_P57_WORKLOAD_CANDIDATE:-}" ] || \
       [ -n "${CANON_P57_DATA_SPLIT:-}" ] || \
       [ "${CANON_P57_CALIBRATION_RECIPES:-}" != "m10,m15,m20" ] || \
       [ "${CANON_FROZENLAKE_CKPT_MODE:-}" != "new" ]; then
      echo "[profile] P57 stock-fast/no-update contract drifted" >&2
      return 1 2>/dev/null || exit 1
    fi
    if [ "${CANON_P57_CALIBRATION_MODE:-}" != "stochastic" ]; then
      echo "[profile] P57 calibration mode must be stochastic" >&2
      return 1 2>/dev/null || exit 1
    fi
    _canon_p57_generations=8
    _canon_p57_temperature=0.7
    case "${CANON_P57_CALIBRATION_OUTPUT:-}" in
      /*) ;;
      *)
        echo "[profile] P57 calibration output must be absolute" >&2
        return 1 2>/dev/null || exit 1
        ;;
    esac
    if [ "${CANON_P33_ENABLE_EVAL:-}" != "0" ] || \
       [ "${CANON_P33_DISABLE_EVAL:-}" != "1" ] || \
       [ "${CANON_P31_ENABLE_EVAL:-}" != "0" ]; then
      echo "[profile] P57 calibration forbids in-process train evaluation" >&2
      return 1 2>/dev/null || exit 1
    fi
    for _canon_p57_calibration_arg in \
      "--max_steps=1" \
      "--num_generations=${_canon_p57_generations}" \
      "--temperature=${_canon_p57_temperature}" \
      "--max_prompt_length=16384" \
      "--max_response_length=16384" \
      "--env_max_steps=20" \
      "--num_test_batches=4" \
      "--eval_every_n_steps=0" \
      "--evaluation_only" \
      "--p57_calibration_mode=${CANON_P57_CALIBRATION_MODE}" \
      "--p57_calibration_recipes=m10,m15,m20"; do
      case " ${CANON_RUN_CMD:-} " in
        *" ${_canon_p57_calibration_arg} "*) ;;
        *)
          echo "[profile] P57 calibration command drifted" >&2
          return 1 2>/dev/null || exit 1
          ;;
      esac
    done
    unset _canon_p57_generations
    unset _canon_p57_temperature
    unset _canon_p57_calibration_arg
    ;;
  train)
    if ! [[ "${CANON_P57_EXPECTED_UPDATES:-}" =~ ^[1-9][0-9]*$ ]]; then
      echo "[profile] P57 train requires a positive expected-update horizon" >&2
      return 1 2>/dev/null || exit 1
    fi
    case "${CANON_P57_TIM_ARM:-}" in
      zero)
        if [ "${CANON_P38_FIXED_LM_HEAD:-}" != "1" ] || \
           [ "${CANON_FROZENLAKE_ALIGNMENT_WARN_ONLY:-}" != "0" ]; then
          echo "[profile] P57 zero arm requires fixed head=1 and strict alignment" >&2
          return 1 2>/dev/null || exit 1
        fi
        ;;
      mismatch)
        if [ "${CANON_P57_INFERENCE_REGIME:-}" != "stock-fast" ] || \
           [ "${CANON_P38_FIXED_LM_HEAD:-0}" != "0" ] || \
           [ "${CANON_FROZENLAKE_ALIGNMENT_WARN_ONLY:-}" != "1" ] || \
           [ "${CANON_P57_WORKLOAD_CANDIDATE:-}" != "m15" ] || \
           [ "${CANON_P57_DATA_SPLIT:-}" != "selection" ] || \
           [ "${CANON_P57_EXPECTED_UPDATES:-}" != "200" ]; then
          echo "[profile] P57 stock curve requires stock-fast M15 selection/200" >&2
          return 1 2>/dev/null || exit 1
        fi
        ;;
      *)
        echo "[profile] P57 train arm must be zero or mismatch" >&2
        return 1 2>/dev/null || exit 1
        ;;
    esac
    if [ "${CANON_P33_ENABLE_EVAL:-}" != "0" ] || \
       [ "${CANON_P33_DISABLE_EVAL:-}" != "1" ] || \
       [ "${CANON_P31_ENABLE_EVAL:-}" != "0" ]; then
      echo "[profile] P57 training forbids in-process evaluation" >&2
      return 1 2>/dev/null || exit 1
    fi
    for _canon_p57_train_arg in \
      "--max_steps=${CANON_P57_EXPECTED_UPDATES}" \
      "--max_prompt_length=4096" \
      "--max_response_length=8192" \
      "--eval_every_n_steps=0"; do
      case " ${CANON_RUN_CMD:-} " in
        *" ${_canon_p57_train_arg} "*) ;;
        *)
        echo "[profile] P57 command/horizon contract drifted" >&2
        return 1 2>/dev/null || exit 1
          ;;
      esac
    done
    unset _canon_p57_train_arg
    if ! [[ "${CANON_P57_STOP_AFTER_STEP:-}" =~ ^[1-9][0-9]*$ ]] || \
       (( CANON_P57_STOP_AFTER_STEP % 50 != 0 )) || \
       (( CANON_P57_STOP_AFTER_STEP > CANON_P57_EXPECTED_UPDATES )); then
      echo "[profile] P57 stock segment stop must be 50/100/150/200" >&2
      return 1 2>/dev/null || exit 1
    fi
    ;;
  eval)
    if ! [[ "${CANON_P57_EXPECTED_UPDATES:-}" =~ ^[1-9][0-9]*$ ]] || \
       ! [[ "${CANON_P57_EVAL_CHECKPOINT_STEP:-}" =~ ^(0|[1-9][0-9]*)$ ]]; then
      echo "[profile] P57 eval requires positive horizon and nonnegative step" >&2
      return 1 2>/dev/null || exit 1
    fi
    if (( CANON_P57_EVAL_CHECKPOINT_STEP % 10 != 0 )) || \
       (( CANON_P57_EVAL_CHECKPOINT_STEP > CANON_P57_EXPECTED_UPDATES )); then
      echo "[profile] P57 eval checkpoint must be a retained 10-step boundary" >&2
      return 1 2>/dev/null || exit 1
    fi
    case "${CANON_P57_TIM_ARM:-}" in
      zero)
        [ "${CANON_P38_FIXED_LM_HEAD:-}" = "1" ] || {
          echo "[profile] P57 zero evaluation requires fixed head=1" >&2
          return 1 2>/dev/null || exit 1
        }
        ;;
      mismatch)
        [ "${CANON_P38_FIXED_LM_HEAD:-0}" = "0" ] && \
        [ "${CANON_P57_INFERENCE_REGIME:-}" = "stock-fast" ] && \
        [ "${CANON_P57_WORKLOAD_CANDIDATE:-}" = "m15" ] && \
        [ "${CANON_P57_DATA_SPLIT:-}" = "selection" ] && \
        [ "${CANON_P57_EXPECTED_UPDATES:-}" = "200" ] || {
          echo "[profile] P57 mismatch evaluation requires stock-fast M15 selection/200" >&2
          return 1 2>/dev/null || exit 1
        }
        ;;
      *)
        echo "[profile] P57 eval arm must be zero or mismatch" >&2
        return 1 2>/dev/null || exit 1
        ;;
    esac
    _canon_p57_eval_mode=resume
    [ "$CANON_P57_EVAL_CHECKPOINT_STEP" = "0" ] && _canon_p57_eval_mode=new
    if [ "${CANON_FROZENLAKE_ALIGNMENT_WARN_ONLY:-0}" != "0" ] || \
       [ "${CANON_FROZENLAKE_CKPT_MODE:-}" != "$_canon_p57_eval_mode" ] || \
       [ "${CANON_P33_ENABLE_EVAL:-}" != "0" ] || \
       [ "${CANON_P33_DISABLE_EVAL:-}" != "1" ] || \
       [ "${CANON_P31_ENABLE_EVAL:-}" != "0" ]; then
      echo "[profile] P57 eval requires strict isolated resume mode" >&2
      return 1 2>/dev/null || exit 1
    fi
    unset _canon_p57_eval_mode
    case "${CANON_P57_EVAL_OUTPUT:-}" in
      /*) ;;
      *)
        echo "[profile] P57 eval output must be absolute" >&2
        return 1 2>/dev/null || exit 1
        ;;
    esac
    for _canon_p57_eval_arg in \
      "--max_steps=${CANON_P57_EXPECTED_UPDATES}" \
      "--num_generations=2" \
      "--temperature=0" \
      "--num_test_batches=4" \
      "--eval_every_n_steps=0" \
      "--evaluation_only"; do
      case " ${CANON_RUN_CMD:-} " in
        *" ${_canon_p57_eval_arg} "*) ;;
        *)
        echo "[profile] P57 isolated evaluation command drifted" >&2
        return 1 2>/dev/null || exit 1
          ;;
      esac
    done
    unset _canon_p57_eval_arg
    ;;
  *)
    echo "[profile] CANON_P57_RUN_KIND must be calibration, train, or eval" >&2
    return 1 2>/dev/null || exit 1
    ;;
esac

export CANON_WANDB_PROJECT=zero-tim-p57-frozenlake-tim
export CANON_WANDB_GROUP="p57-${CANON_P57_TIM_ARM}${CANON_P57_WORKLOAD_CANDIDATE:+-${CANON_P57_WORKLOAD_CANDIDATE}-${CANON_P57_DATA_SPLIT}}"
