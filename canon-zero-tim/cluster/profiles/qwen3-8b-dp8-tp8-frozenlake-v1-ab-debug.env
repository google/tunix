# FrozenLake DP8xTP8 pre-backward A/B diagnostic.
#
# This carrier keeps the production serving bundle and selects one bounded
# checked-VMA bisection arm.  It stops after one A/B/C precheck and performs
# no backward or optimizer commit.

_CANON_V1_FL_AB_PROFILE_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
# shellcheck disable=SC1091
source "$_CANON_V1_FL_AB_PROFILE_DIR/qwen3-8b-dp16-tp4-frozenlake.env"
unset _CANON_V1_FL_AB_PROFILE_DIR

export CANON_PROFILE=qwen3-8b-dp8-tp8-frozenlake-v1-ab-debug
export CANON_P32_WORKLOAD=frozenlake-dp8-tp8
export CANON_MODEL_DIR_NAME=qwen8b_tp8
export CANON_QWEN3_TP_SIZE=8
export CANON_DP_SIZE=8
export CANON_TP_SIZE=8
export CANON_TOTAL_DEVICES=64
export CANON_ENGINE_DP_SIZE=8
export CANON_GLOBAL_PROMPTS=32
export CANON_LOCAL_PROMPTS=4
export CANON_NUM_GENERATIONS=8
export CANON_LOCAL_TRAJECTORIES=32
export CANON_GLOBAL_TRAJECTORIES=256
export CANON_DP_PROBE_LOCAL_SAMPLES=32
export CANON_LOGPROB_M=256
export CANON_TARGET_M=256
export CANON_MAX_BATCHED=256
export MIN_TOKEN_BUCKET=2048
export FL_SHARED_MESH=8,8

export CANON_V1_FL_TP8_AB_ARM="${CANON_V1_FL_TP8_AB_ARM:-}"
case "$CANON_V1_FL_TP8_AB_ARM" in
  p66-off)
    export CANON_P59_CHECKED_VMA=0
    export CANON_P66_P59_CHECK_VMA=0
    export CANON_P67_P66_VMA_P59_ONLY=0
    ;;
  serving-scope)
    export CANON_P59_CHECKED_VMA=1
    export CANON_P66_P59_CHECK_VMA=1
    export CANON_P67_P66_VMA_P59_ONLY=1
    ;;
  *)
    echo "[profile] V1 FrozenLake TP8 A/B diagnostic requires arm=p66-off or serving-scope" >&2
    return 1 2>/dev/null || exit 1
    ;;
esac

# Preserve the Attempt-9 serving program except for the single bisection
# variable.  The historical implementation spelling must be absent too.
export CANON_CONTINUE_DECODE=8
export CANON_FIXED_AR_GATHER=1
export CANON_PALLAS_GATHERED_LOGPROBS=1
export CANON_LOGPROB_STEP_FUSION=1
export CANON_VLLM_ENABLE_PREFIX_CACHING=0
export CANON_P59_RANK_PARALLEL_BACKWARD=1
export CANON_V1_HP_FIRST_UPDATE_GATE=0
export CANON_P63_OVERFLOW_SAFE_CLIP=0
export CANON_P28_BATCHED_REPORT=1
export CANON_P28_BATCHED_REVERSE=0
export CANON_BATCHED_EVIDENCE=0
export CANON_FUSED_TREE_OPS=0
export CANON_P45_HOST_MEMORY_TELEMETRY=1
export CANON_P45_HOST_GC_INTERVAL=1
export CANON_WANDB_PROJECT=zero-tim-frozenlake-dp8-tp8-resident
export CANON_WANDB_GROUP=qwen3-8b-dp8-tp8-v1-ab-debug
export CANON_WANDB_RUN_NAME="${CANON_WANDB_RUN_NAME:-v1-fl-tp8-ab-${CANON_V1_FL_TP8_AB_ARM}}"

if [ "${CANON_P33_RUN_STAGE:-}" != "backward-no-commit" ] || \
   [ "${CANON_P33_NO_COMMIT:-}" != "1" ] || \
   [ "${CANON_FROZENLAKE_ALIGNMENT_WARN_ONLY:-}" != "0" ] || \
   [ "${CANON_P38_FIXED_LM_HEAD:-}" != "1" ] || \
   [ "${CANON_P38_PRECHECK_ONLY:-}" != "1" ] || \
   [ "${CANON_P38_CONTROLLED_EXIT:-}" != "1" ] || \
   [ "${CANON_P38_DIAGNOSTIC_ROUNDS:-}" != "1" ] || \
   [ "${CANON_P33_ENABLE_EVAL:-}" != "0" ] || \
   [ "${CANON_P33_DISABLE_EVAL:-}" != "1" ] || \
   [ "${CANON_OPT_STATE_RESIDENT:-}" != "1" ] || \
   [ "${CANON_P30_OPT_STATE_OFFLOAD:-}" != "0" ] || \
   [ "${CANON_V1_HP_FULL:-0}" != "0" ]; then
  echo "[profile] V1 FrozenLake TP8 A/B diagnostic contract drifted" >&2
  return 1 2>/dev/null || exit 1
fi

echo "[V1.FL.AB] profile_resolved arm=${CANON_V1_FL_TP8_AB_ARM} workload=${CANON_P57_WORKLOAD_CANDIDATE:-p45} dp=8 tp=8 checked_vma=${CANON_P59_CHECKED_VMA} vma_p59_only=${CANON_P67_P66_VMA_P59_ONLY} fixed_ar_gather=1 continue_decode=8 prefix_cache=0 backward=0 optimizer_commits=0"
