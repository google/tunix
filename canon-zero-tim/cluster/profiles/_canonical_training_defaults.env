# Full-recipe defaults owned by the shared Python bundle policy. Source only
# after the workload profile has established its exact full-training identity.
# The program is stdlib-only: no JAX import, device discovery or environment dump.
_canon_training_policy="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)/v1_full_system_optimization.py"
_canon_training_defaults="$(python3 "$_canon_training_policy" --profile-defaults)" || {
  unset _canon_training_policy _canon_training_defaults
  return 1 2>/dev/null || exit 1
}
# Output is two allowlisted export statements or empty for an explicit control.
eval "$_canon_training_defaults"
unset _canon_training_policy _canon_training_defaults
