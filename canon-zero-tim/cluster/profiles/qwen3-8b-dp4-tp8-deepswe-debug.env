# Qwen3-8B DeepSWE bring-up: one 4x4x4 slice split into two host-complete
# 32-device roles, each DP4xTP8. This profile is diagnostics-only and does not
# alter the P34 production or P39 Qwen3-32B pilot contracts.

_CANON_P43_PROFILE_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
# shellcheck disable=SC1091
source "$_CANON_P43_PROFILE_DIR/qwen3-32b-dp16-tp8-deepswe.env"
# shellcheck disable=SC1091
source "$_CANON_P43_PROFILE_DIR/qwen3-8b.env"
unset _CANON_P43_PROFILE_DIR

export CANON_PROFILE=qwen3-8b-dp4-tp8-deepswe-debug
export CANON_P39_64CHIP_PILOT=0
export CANON_P39_PILOT_ADMITTED=0
export CANON_P43_DEEPSWE_DEBUG=1
export CANON_P43_DEBUG_ADMITTED=1
if [ "${CANON_P34_RUN_STAGE:-}" = "rollout-only" ]; then
  export CANON_P43_ROLLOUT_ONLY=1
else
  export CANON_P43_ROLLOUT_ONLY=0
fi

export CANON_QWEN3_TP_SIZE=8
export CANON_DP_SIZE=4
export CANON_TP_SIZE=8
export CANON_TOTAL_DEVICES=32
export CANON_ENGINE_DP_SIZE=4
export CANON_GLOBAL_PROMPTS=4
export CANON_NUM_GENERATIONS=4
export CANON_LOCAL_TRAJECTORIES=4
export CANON_GLOBAL_TRAJECTORIES=16
export CANON_TARGET_M=256
export CANON_LOGPROB_M=256
export MIN_TOKEN_BUCKET=1024
export CANON_P34_ABCPROD=256
export FL_SHARED_MESH=4,8

export CANON_P34_PREFIX_CACHE=0
export CANON_P34_MAX_NUM_SEQS=4
export CANON_P34_MAX_BATCHED_TOKENS=256

export CANON_OPT_STATE_RESIDENT=1
export CANON_P30_OPT_STATE_OFFLOAD=0
export CANON_DEEPSWE_ALIGNMENT_WARN_ONLY=1

export CANON_WANDB_PROJECT=zero-tim-deepswe-8b-debug
export CANON_WANDB_GROUP=qwen3-8b-dp4-tp8-debug
export CANON_WANDB_RUN_NAME="${CANON_WANDB_RUN_NAME:-p43-deepswe-debug-${CANON_P34_RUN_STAGE}-${CANON_RUN_ID:-unset}}"
