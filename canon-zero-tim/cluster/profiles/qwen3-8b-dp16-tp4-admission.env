# P32 admission-only profile: 64 devices = replicated DP16 x model TP4.
#
# This file deliberately does NOT admit model training.  The current Tunix shared mesh names
# its first axis ``fsdp`` and the segmented VJP still walks the global trajectory list on the
# host.  Treating that implementation as DP16 would shard parameters and duplicate work, which
# is a different algorithm from the requested replicated-data-parallel contract.

export CANON_PROFILE=qwen3-8b-dp16-tp4-admission
export CANON_MODEL_DIR_NAME=qwen8b

export CANON_QWEN3_HIDDEN_SIZE=4096
export CANON_QWEN3_INTERMEDIATE_SIZE=12288
export CANON_QWEN3_NUM_ATTENTION_HEADS=32
export CANON_QWEN3_NUM_KV_HEADS=8
export CANON_QWEN3_HEAD_DIM=128
export CANON_QWEN3_TP_SIZE=4

# Exact P32 geometry and batch contract.
export CANON_P32_DP_ADMISSION=1
export CANON_P32_TRAIN_ADMITTED=0
export CANON_DP_SIZE=16
export CANON_TP_SIZE=4
export CANON_TOTAL_DEVICES=64
export CANON_ENGINE_DP_SIZE=16
export CANON_GLOBAL_PROMPTS=32
export CANON_LOCAL_PROMPTS=2
export CANON_NUM_GENERATIONS=8
export CANON_LOCAL_TRAJECTORIES=16
export CANON_GLOBAL_TRAJECTORIES=256
export CANON_DP_PROBE_LOCAL_SAMPLES=16
export CANON_TRAIN_DP_SHARDING=replicated-params

# MIN_TOKEN_BUCKET is global.  To keep M=256 per DP replica it must be 16*256=4096.
export MIN_TOKEN_BUCKET=4096
export CANON_TARGET_M=256
export CANON_MAX_BATCHED=256

# The current production trainer is still TP4-only.  P32 training must remain refused until a
# real (dp,tp) adapter exists; setting this to 16,4 today would silently mean FSDP16 x TP4.
export FL_SHARED_MESH=1,4

# First remote run measures topology order.  Pin these from that artifact before any later
# model-bearing gate; never inherit the four-chip host order.
export CANON_EXPECT_MODEL_MESH_IDS="${CANON_P32_EXPECT_MODEL_MESH_IDS:-}"
export CANON_EXPECT_TRAIN_MESH_IDS="${CANON_EXPECT_TRAIN_MESH_IDS:-}"
