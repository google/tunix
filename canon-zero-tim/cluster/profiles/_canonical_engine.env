# The canonical engine switch set.  Shared by every profile; changing any line changes the
# regime and invalidates every bitwise result recorded against it.
#
# Sourced by cluster/steps/00_env.sh.  Values are exported as-is.
#
# Provenance: identical in the two signed release configurations --
#   tasks/logprob_diff_operator_alignment/scripts/run_p26_gsm8k_train.sh  (GSM8K Qwen3-1.7B)
#   the live P31 FrozenLake Qwen3-8B invocation                          (FrozenLake Qwen3-8B)
# The two differ only in model geometry and task switches, never here.

# --- R1: fixed-order TP reduction (row-position invariance) --------------------------------
export CANON_FIXED_AR=1
export CANON_FIXED_AR_EMBED=1

# --- R2: pinned RPA blocks + pinned token bucket (shape/regime invariance) -----------------
export CANON_RPA_D=128,512,128,512
export CANON_RPA_P=128,512,128,512
export CANON_RPA_M=128,512,128,512
export MIN_TOKEN_BUCKET=256

# --- R3: third-program control ------------------------------------------------------------
# --xla_allow_excess_precision=false removes one layer of fwd-vs-fwd+bwd lowering difference;
# CANON_FIXED_AR_EMBED (above) pins the last uncovered 4-way reduction in the forward.
export XLA_FLAGS="--xla_cpu_max_isa=AVX2 --xla_allow_excess_precision=false"

# --- R4: differentiable chunked-cache attention -------------------------------------------
# CANON_RPA_VJP2 is the switch; CANON_VJP2_MAX_SEQS is only its parameter and must be set
# explicitly.  CANON_RPA_VJP (the OLD prefill-only contract, zero kv gradient) is deliberately
# NOT set here -- see KNOWN_FOOTGUNS.md.
export CANON_RPA_VJP2=1
export CANON_VJP2_MAX_SEQS=1

# --- R5: processed-logprob carrier ---------------------------------------------------------
export CANON_LOGPROB_M=256
export CANON_PROMPT_PROCESSED_LOGPROBS=1
export CANON_PALLAS_LOGSOFTMAX=1

# --- promoted Pallas canonical ops ---------------------------------------------------------
export CANON_PALLAS_ALL_PROJ=1
export CANON_PALLAS_ALL_RMSNORM=1
export CANON_PALLAS_SWIGLU=1
export CANON_PALLAS_MPAD=1
export CANON_PALLAS_SWIGLU_MPAD=1
export CANON_PALLAS_CANONICAL_VJP=1

# --- engine-module differentiable forward (the C side of A=B=C) ---------------------------
export CANON_ENGINE_MODULE_C=1

# --- engine plumbing -----------------------------------------------------------------------
export NEW_MODEL_DESIGN=1
export VLLM_ENABLE_V1_MULTIPROCESSING=0
export ROLLOUT_ENGINE=vllm

# --- device order assertion ----------------------------------------------------------------
# Topology-aware create_device_mesh permutes the order you pass in; on the 4-chip probe host
# [0,1,2,3] comes back as [0,2,1,3].  Rollout and trainer must be ASSERTED equal, not assumed.
# Override per topology -- an inherited value from another shape is worse than none.
export CANON_EXPECT_MODEL_MESH_IDS="${CANON_EXPECT_MODEL_MESH_IDS:-0,2,1,3}"
export FL_SHARED_MESH="${FL_SHARED_MESH:-1,4}"

# --- diagnostic switches: explicitly EMPTY -------------------------------------------------
# Under docker/k8s, `-e K=` always sets the key, so os.environ.get(k, default) never sees the
# default -- an empty string reaches int()/float() far from its cause.  Keep them present and
# empty so "absent" is unambiguous.
export CANON_CUT=
export CANON_TAIL=
export CANON_POSTRPA_M=
export CANON_PALLAS_MATMUL=
export CANON_PALLAS_MATERIALIZE=
