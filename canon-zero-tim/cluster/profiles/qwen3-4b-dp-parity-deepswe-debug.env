# Qwen3-4B DeepSWE parity-debug recipe. CANON_P44_TOPOLOGY selects one
# physical slice while every non-topology recipe field remains identical.

_CANON_P44_REQUESTED_TOPOLOGY="${CANON_P44_TOPOLOGY:-}"
_CANON_P44_PROFILE_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
# shellcheck disable=SC1091
source "$_CANON_P44_PROFILE_DIR/qwen3-32b-dp16-tp8-deepswe.env"
# shellcheck disable=SC1091
source "$_CANON_P44_PROFILE_DIR/qwen3-4b.env"
unset _CANON_P44_PROFILE_DIR
export CANON_P44_TOPOLOGY="$_CANON_P44_REQUESTED_TOPOLOGY"
unset _CANON_P44_REQUESTED_TOPOLOGY

export CANON_P39_64CHIP_PILOT=0
export CANON_P39_PILOT_ADMITTED=0
export CANON_P43_DEEPSWE_DEBUG=0
export CANON_P43_DEBUG_ADMITTED=0
export CANON_P43_ROLLOUT_ONLY=0
export CANON_P44_DEEPSWE_PARITY=1
export CANON_P44_PARITY_ADMITTED=1
if [ "${CANON_P34_RUN_STAGE:-}" = "rollout-only" ]; then
  export CANON_P44_ROLLOUT_ONLY=1
else
  export CANON_P44_ROLLOUT_ONLY=0
fi

case "${CANON_P44_TOPOLOGY:-}" in
  64)
    export CANON_PROFILE=qwen3-4b-dp4-tp8-deepswe-parity
    export CANON_DP_SIZE=4
    export CANON_TOTAL_DEVICES=32
    export CANON_ENGINE_DP_SIZE=4
    export CANON_LOCAL_TRAJECTORIES=4
    export MIN_TOKEN_BUCKET=1024
    export CANON_P34_MAX_NUM_SEQS=4
    export FL_SHARED_MESH=4,8
    ;;
  256)
    export CANON_PROFILE=qwen3-4b-dp16-tp8-deepswe-parity
    export CANON_DP_SIZE=16
    export CANON_TOTAL_DEVICES=128
    export CANON_ENGINE_DP_SIZE=16
    export CANON_LOCAL_TRAJECTORIES=1
    export MIN_TOKEN_BUCKET=4096
    export CANON_P34_MAX_NUM_SEQS=1
    export FL_SHARED_MESH=16,8
    ;;
  *)
    echo "P44 profile requires CANON_P44_TOPOLOGY=64 or 256" >&2
    return 1
    ;;
esac

export CANON_QWEN3_TP_SIZE=8
export CANON_TP_SIZE=8
export CANON_GLOBAL_PROMPTS=4
export CANON_NUM_GENERATIONS=4
export CANON_GLOBAL_TRAJECTORIES=16
export CANON_TARGET_M=256
export CANON_LOGPROB_M=256
export CANON_EXPECT_MODEL_MESH_IDS=""
export CANON_P34_ABCPROD=256
export CANON_P34_PREFIX_CACHE=0
export CANON_P34_MAX_BATCHED_TOKENS=256
export CANON_DEEPSWE_CLEANUP_TIMEOUT_SECS=300
export CANON_DEEPSWE_ROLLOUT_BATCH_TIMEOUT_SECS=3600
export CANON_DEEPSWE_PER_TURN_TIMEOUT_SECS=300
export CANON_DEEPSWE_TRAJECTORY_TIMEOUT_SECS=3000
export CANON_DEEPSWE_STEP_TIMEOUT_SECS=600
export CANON_DEEPSWE_REWARD_TIMEOUT_SECS=600
export R2E_ACTIVE_DEADLINE_SECONDS=3300

export CANON_OPT_STATE_RESIDENT=1
export CANON_P30_OPT_STATE_OFFLOAD=0
export CANON_DEEPSWE_ALIGNMENT_WARN_ONLY=1

export CANON_WANDB_PROJECT=zero-tim-deepswe-4b-parity
export CANON_WANDB_GROUP="qwen3-4b-parity-${CANON_P44_TOPOLOGY}chip"
export CANON_WANDB_RUN_NAME="${CANON_WANDB_RUN_NAME:-p44-deepswe-${CANON_P44_TOPOLOGY}-${CANON_P34_RUN_STAGE}-${CANON_RUN_ID:-unset}}"
