# Bounded M15 APC target reproducer: DP8xTP8, forward only, zero commit.
# This profile intentionally does not source either P57 full-training profile.
# It keeps the canonical numerical bundle and exact production serving knobs,
# but stops after the strict A/B/C precheck.

_CANON_APC_M15_PROFILE_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
# shellcheck disable=SC1091
source "$_CANON_APC_M15_PROFILE_DIR/qwen3-8b-dp16-tp4-frozenlake.env"
unset _CANON_APC_M15_PROFILE_DIR

export CANON_PROFILE=qwen3-8b-dp8-tp8-frozenlake-apc-debug
export CANON_P32_WORKLOAD=frozenlake-dp8-tp8
export CANON_MODEL_DIR_NAME=qwen8b_tp8
export CANON_QWEN3_TP_SIZE=8
export CANON_DP_SIZE=8
export CANON_TP_SIZE=8
export CANON_TOTAL_DEVICES=64
export CANON_ENGINE_DP_SIZE=8
export CANON_GLOBAL_PROMPTS=32
export CANON_LOCAL_PROMPTS=4
export CANON_NUM_GENERATIONS=8
export CANON_LOCAL_TRAJECTORIES=32
export CANON_GLOBAL_TRAJECTORIES=256
export CANON_DP_PROBE_LOCAL_SAMPLES=32
export CANON_LOGPROB_M=256
export CANON_TARGET_M=256
export CANON_MAX_BATCHED=256
export MIN_TOKEN_BUCKET=2048
export FL_SHARED_MESH=8,8

# Match the m15i serving program without enabling training or evaluation.
export CANON_CONTINUE_DECODE=8
export CANON_FIXED_AR_GATHER=1
export CANON_PALLAS_GATHERED_LOGPROBS=1
export CANON_LOGPROB_STEP_FUSION=1
export CANON_P59_RANK_PARALLEL_BACKWARD=1
export CANON_P28_BATCHED_REPORT=1
export CANON_P28_BATCHED_REVERSE=0
export CANON_BATCHED_EVIDENCE=0
export CANON_FUSED_TREE_OPS=0
export CANON_P38_FIXED_LM_HEAD=1

case "${CANON_APC_M15_TARGET_DEBUG:-}" in
  off) export CANON_VLLM_ENABLE_PREFIX_CACHING=0 ;;
  on) export CANON_VLLM_ENABLE_PREFIX_CACHING=1 ;;
  *)
    echo "[profile] CANON_APC_M15_TARGET_DEBUG must be off or on" >&2
    return 1 2>/dev/null || exit 1
    ;;
esac

if [ "${CANON_P33_RUN_STAGE:-}" != "backward-no-commit" ] || \
   [ "${CANON_P33_NO_COMMIT:-}" != "1" ] || \
   [ "${CANON_P38_PRECHECK_ONLY:-}" != "1" ] || \
   [ "${CANON_P38_CONTROLLED_EXIT:-}" != "1" ] || \
   [ "${CANON_P38_DIAGNOSTIC_ROUNDS:-}" != "1" ] || \
   [ "${CANON_FROZENLAKE_ALIGNMENT_WARN_ONLY:-}" != "0" ] || \
   [ "${CANON_P33_ENABLE_EVAL:-}" != "0" ] || \
   [ "${CANON_P33_DISABLE_EVAL:-}" != "1" ] || \
   [ "${CANON_P31_ENABLE_EVAL:-}" != "0" ]; then
  echo "[profile] M15 APC target debug requires a strict one-round zero-commit precheck" >&2
  return 1 2>/dev/null || exit 1
fi

for _canon_apc_m15_arg in \
  "--mesh_dp=8" "--mesh_tp=8" "--batch_size=32" \
  "--mini_batch_size=32" "--num_generations=8" \
  "--max_prompt_length=4096" "--max_response_length=8192" \
  "--max_concurrency=256" "--vllm_max_num_seqs=32" \
  "--vllm_max_num_batched_tokens=256" "--env_max_steps=15" \
  "--temperature=0.7" "--seed=42" \
  "--p57_workload_candidate=m15" "--p57_data_split=main"; do
  case " ${CANON_RUN_CMD:-} " in
    *" ${_canon_apc_m15_arg} "*) ;;
    *)
      echo "[profile] M15 APC target command drifted at $_canon_apc_m15_arg" >&2
      return 1 2>/dev/null || exit 1
      ;;
  esac
done
unset _canon_apc_m15_arg

export CANON_WANDB_PROJECT=zero-tim-frozenlake-dp8-tp8-resident
export CANON_WANDB_GROUP=apc-m15-target-debug
