# P64 P45 first-red numerical observer. It reproduces the V1 backward bundle
# on the original FrozenLake workload, performs zero optimizer commits, and
# must never be used as a training profile.

_CANON_P64_PROFILE_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
# Deliberately source the contract-only FrozenLake base, not the committed
# P45 resident profile.  This keeps the production P45 profile closed to all
# no-commit stages and gives the observer its own isolated admission surface.
# shellcheck disable=SC1091
source "$_CANON_P64_PROFILE_DIR/qwen3-8b-dp16-tp4-frozenlake.env"
unset _CANON_P64_PROFILE_DIR

export CANON_PROFILE=qwen3-8b-dp8-tp8-frozenlake-p64-debug
export CANON_P32_WORKLOAD=frozenlake-dp8-tp8
export CANON_MODEL_DIR_NAME=qwen8b_tp8
export CANON_QWEN3_TP_SIZE=8
export CANON_DP_SIZE=8
export CANON_TP_SIZE=8
export CANON_TOTAL_DEVICES=64
export CANON_ENGINE_DP_SIZE=8
export CANON_GLOBAL_PROMPTS=32
export CANON_LOCAL_PROMPTS=4
export CANON_NUM_GENERATIONS=8
export CANON_LOCAL_TRAJECTORIES=32
export CANON_GLOBAL_TRAJECTORIES=256
export CANON_DP_PROBE_LOCAL_SAMPLES=32
export CANON_LOGPROB_M=256
export CANON_TARGET_M=256
export CANON_MAX_BATCHED=256
export MIN_TOKEN_BUCKET=2048
export FL_SHARED_MESH=8,8
export CANON_P45_HOST_MEMORY_TELEMETRY=1
export CANON_P45_HOST_GC_INTERVAL=1
export CANON_CONTINUE_DECODE=8
export CANON_FIXED_AR_GATHER=1
export CANON_PALLAS_GATHERED_LOGPROBS=1
export CANON_LOGPROB_STEP_FUSION=1
export CANON_VLLM_ENABLE_PREFIX_CACHING=0
export CANON_P59_RANK_PARALLEL_BACKWARD=1
export CANON_P64_P45_NUMERIC_DEBUG="${CANON_P64_P45_NUMERIC_DEBUG:-0}"
export CANON_P64_TRAINING_CAPSULE_MODE="${CANON_P64_TRAINING_CAPSULE_MODE:-}"
export CANON_P64_TRAINING_CAPSULE="${CANON_P64_TRAINING_CAPSULE:-}"
export CANON_P64_TRAINING_CAPSULE_GCS_URI="${CANON_P64_TRAINING_CAPSULE_GCS_URI:-}"
export CANON_P64_TRAINING_CAPSULE_SHA256="${CANON_P64_TRAINING_CAPSULE_SHA256:-}"
export CANON_P64_MODEL_BINDING_SHA256="${CANON_P64_MODEL_BINDING_SHA256:-}"
export CANON_P28_BATCHED_REPORT=1
export CANON_P28_BATCHED_REVERSE=0
export CANON_BATCHED_EVIDENCE=0
export CANON_FUSED_TREE_OPS=0
export CANON_P63_OVERFLOW_SAFE_CLIP=0
export CANON_WANDB_PROJECT=zero-tim-frozenlake-dp8-tp8-resident
export CANON_WANDB_GROUP=qwen3-8b-dp8-tp8-p64-debug
export CANON_WANDB_RUN_NAME="${CANON_WANDB_RUN_NAME:-p64-p45-numeric-debug}"

if [ "$CANON_P64_P45_NUMERIC_DEBUG" != "1" ] || \
   [ "${CANON_P32_WORKLOAD:-}" != "frozenlake-dp8-tp8" ] || \
   [ "${CANON_DP_SIZE:-}" != "8" ] || \
   [ "${CANON_TP_SIZE:-}" != "8" ] || \
   [ "${CANON_P33_RUN_STAGE:-}" != "backward-no-commit" ] || \
   [ "${CANON_P33_NO_COMMIT:-}" != "1" ] || \
   [ "${CANON_FROZENLAKE_ALIGNMENT_WARN_ONLY:-}" != "0" ] || \
   [ "${CANON_P38_FIXED_LM_HEAD:-}" != "1" ] || \
   [ "${CANON_OPT_STATE_RESIDENT:-}" != "1" ] || \
   [ "${CANON_P30_OPT_STATE_OFFLOAD:-}" != "0" ] || \
   { [ "$CANON_P64_TRAINING_CAPSULE_MODE" != "capture" ] && \
     [ "$CANON_P64_TRAINING_CAPSULE_MODE" != "replay" ]; } || \
   [[ ! "$CANON_P64_TRAINING_CAPSULE" = /*.npz ]] || \
   [[ ! "$CANON_P64_TRAINING_CAPSULE_GCS_URI" =~ ^gs://yuxzhang-tunix-models/canon-zero-tim/evidence/p64/[a-z0-9][a-z0-9-]*/training-capsule\.npz$ ]] || \
   [ "${CANON_V1_HP_FULL:-0}" != "0" ]; then
  echo "[profile] P64 requires strict P45 DP8xTP8 P59 fixed-head backward-no-commit" >&2
  return 1 2>/dev/null || exit 1
fi

case "$CANON_P64_TRAINING_CAPSULE_MODE" in
  capture)
    if [ -n "$CANON_P64_TRAINING_CAPSULE_SHA256" ] || \
       [ -n "$CANON_P64_MODEL_BINDING_SHA256" ]; then
      echo "[profile] P64 capture mode forbids replay hashes" >&2
      return 1 2>/dev/null || exit 1
    fi
    ;;
  replay)
    if [[ ! "$CANON_P64_TRAINING_CAPSULE_SHA256" =~ ^[0-9a-f]{64}$ ]] || \
       [[ ! "$CANON_P64_MODEL_BINDING_SHA256" =~ ^[0-9a-f]{64}$ ]]; then
      echo "[profile] P64 replay requires exact capsule and model-binding hashes" >&2
      return 1 2>/dev/null || exit 1
    fi
    ;;
esac

echo "[P64.NUMERIC] profile_resolved workload=frozenlake-dp8-tp8 dp=8 tp=8 stage=backward-no-commit optimizer_commits=0 capsule_mode=$CANON_P64_TRAINING_CAPSULE_MODE"
