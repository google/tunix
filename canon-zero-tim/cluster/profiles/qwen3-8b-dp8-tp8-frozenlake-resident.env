# FrozenLake Qwen3-8B full/eval profile for one 64-chip v5p slice.
# This is an isolated P45 carrier: DP8xTP8 with device-resident optimizer
# state.  The existing DP16xTP4 P33/P38 profiles remain unchanged.

_CANON_P45_PROFILE_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
# shellcheck disable=SC1091
source "$_CANON_P45_PROFILE_DIR/qwen3-8b-dp16-tp4-frozenlake.env"
unset _CANON_P45_PROFILE_DIR

export CANON_PROFILE=qwen3-8b-dp8-tp8-frozenlake-resident
export CANON_P32_WORKLOAD=frozenlake-dp8-tp8
export CANON_MODEL_DIR_NAME=qwen8b_tp8
export CANON_QWEN3_TP_SIZE=8
export CANON_DP_SIZE=8
export CANON_TP_SIZE=8
export CANON_TOTAL_DEVICES=64
export CANON_ENGINE_DP_SIZE=8
export CANON_GLOBAL_PROMPTS=32
export CANON_LOCAL_PROMPTS=4
export CANON_NUM_GENERATIONS=8
export CANON_LOCAL_TRAJECTORIES=32
export CANON_GLOBAL_TRAJECTORIES=256
export CANON_DP_PROBE_LOCAL_SAMPLES=32
export CANON_LOGPROB_M=256
export CANON_TARGET_M=256
export CANON_MAX_BATCHED=256
export MIN_TOKEN_BUCKET=2048
export FL_SHARED_MESH=8,8
export CANON_P45_HOST_MEMORY_TELEMETRY=1
export CANON_P45_HOST_GC_INTERVAL=1
# P50 grouped report-window consolidation is wired into the P32 DP reverse
# path used by this carrier.  The evidence and reverse-loop flags are not
# enabled here because their P32 grouped mirrors are not implemented yet.
export CANON_P28_BATCHED_REPORT=1

if [ "${CANON_P33_RUN_STAGE:-}" != "full" ] || \
   [ "${CANON_P33_NO_COMMIT:-}" != "0" ]; then
  echo "[profile] P45 resident carrier requires committed full training" >&2
  return 1 2>/dev/null || exit 1
fi
if [ "${CANON_OPT_STATE_RESIDENT:-}" != "1" ] || \
   [ "${CANON_P30_OPT_STATE_OFFLOAD:-}" != "0" ]; then
  echo "[profile] P45 requires resident=1 and optimizer offload=0" >&2
  return 1 2>/dev/null || exit 1
fi

if [ "${CANON_FROZENLAKE_CKPT_MODE:-}" = "disabled" ]; then
  case "${CANON_PROFILE_FILE:-}:${CANON_V1_HP_FULL:-0}:${CANON_P57_RUN_KIND:-}:${CANON_P57_TIM_ARM:-}:${CANON_P57_WORKLOAD_CANDIDATE:-}:${CANON_P57_DATA_SPLIT:-}:${CANON_P57_EXPECTED_UPDATES:-}:${CANON_P33_ENABLE_EVAL:-}:${CANON_P33_DISABLE_EVAL:-}:${CANON_P31_ENABLE_EVAL:-}" in
    cluster/profiles/qwen3-8b-dp8-tp8-frozenlake-v1-hp.env:1:train:zero:::300:0:1:0|\
    cluster/profiles/qwen3-8b-dp8-tp8-frozenlake-v1-hp.env:1:train:zero:m15:main:300:0:1:0) ;;
    *)
      echo "[profile] P45 checkpoint-disabled mode is isolated to the optimized P45/M15 zero concept run" >&2
      return 1 2>/dev/null || exit 1
      ;;
  esac
  if [ -n "${CANON_FROZENLAKE_CKPT_ROOT:-}${CANON_FROZENLAKE_CKPT_TAG:-}${CANON_FROZENLAKE_CKPT_INTERVAL:-}${CANON_FROZENLAKE_CKPT_MAX_TO_KEEP:-}${CANON_FROZENLAKE_CKPT_MILESTONE_INTERVAL:-}" ]; then
    echo "[profile] P45 disabled checkpoint contract retained residual fields" >&2
    return 1 2>/dev/null || exit 1
  fi
else
  case "${CANON_FROZENLAKE_CKPT_MODE:-}" in
    new|resume) ;;
    *)
      echo "[profile] P45 requires checkpoint mode disabled, new, or resume" >&2
      return 1 2>/dev/null || exit 1
      ;;
  esac
  if [ "${CANON_FROZENLAKE_CKPT_ROOT:-}" != \
       "gs://yuxzhang-tunix-models/canon-zero-tim/checkpoints/frozenlake" ]; then
    echo "[profile] P45 checkpoint root drifted" >&2
    return 1 2>/dev/null || exit 1
  fi
  if ! [[ "${CANON_FROZENLAKE_CKPT_TAG:-}" =~ ^[a-z0-9]([a-z0-9-]{0,61}[a-z0-9])?$ ]]; then
    echo "[profile] P45 checkpoint tag is invalid" >&2
    return 1 2>/dev/null || exit 1
  fi
  _canon_p45_expected_checkpoint_interval=10
  case "${CANON_P57_RUN_KIND:-}:${CANON_P57_TIM_ARM:-}:${CANON_P57_WORKLOAD_CANDIDATE:-}:${CANON_P57_DATA_SPLIT:-}:${CANON_P57_EXPECTED_UPDATES:-}" in
    train:zero:::300|train:mismatch:::300|train:is:::300|\
    eval:zero:::300|eval:mismatch:::300|eval:is:::300|\
    train:zero:m15:main:300|train:mismatch:m15:main:300|train:is:m15:main:300|\
    eval:zero:m15:main:300|eval:mismatch:m15:main:300|eval:is:m15:main:300)
      _canon_p45_expected_checkpoint_interval=300
      ;;
  esac
  if [ "${CANON_FROZENLAKE_CKPT_INTERVAL:-}" != \
       "$_canon_p45_expected_checkpoint_interval" ] || \
     [ "${CANON_FROZENLAKE_CKPT_MAX_TO_KEEP:-}" != "1" ]; then
    echo "[profile] FrozenLake checkpoint cadence drifted: expected interval=${_canon_p45_expected_checkpoint_interval} max_to_keep=1" >&2
    return 1 2>/dev/null || exit 1
  fi
  unset _canon_p45_expected_checkpoint_interval
fi
export ENABLE_PATHWAYS_PERSISTENCE="${ENABLE_PATHWAYS_PERSISTENCE:-1}"
if [ "${ENABLE_PATHWAYS_PERSISTENCE}" != "1" ]; then
  echo "[profile] P45 checkpointing requires Pathways persistence" >&2
  return 1 2>/dev/null || exit 1
fi
if [ "${CANON_P45_HOST_MEMORY_TELEMETRY:-}" != "1" ] || \
   [ "${CANON_P45_HOST_GC_INTERVAL:-}" != "1" ]; then
  echo "[profile] P45 requires host-memory telemetry and per-step cyclic GC" >&2
  return 1 2>/dev/null || exit 1
fi
if [ "${CANON_P28_BATCHED_REPORT:-}" != "1" ]; then
  echo "[profile] P45 requires the grouped batched-report path" >&2
  return 1 2>/dev/null || exit 1
fi

export CANON_WANDB_PROJECT=zero-tim-frozenlake-dp8-tp8-resident
export CANON_WANDB_GROUP=qwen3-8b-dp8-tp8-resident
export CANON_WANDB_RUN_NAME="${CANON_WANDB_RUN_NAME:-p45-frozenlake-full-attempt-${JOBSET_RESTART_ATTEMPT:-unknown}}"
