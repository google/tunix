# FrozenLake Qwen3-8B full/eval profile for one 64-chip v5p slice.
# This is an isolated P45 carrier: DP8xTP8 with device-resident optimizer
# state.  The existing DP16xTP4 P33/P38 profiles remain unchanged.

_CANON_P45_PROFILE_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
# shellcheck disable=SC1091
source "$_CANON_P45_PROFILE_DIR/qwen3-8b-dp16-tp4-frozenlake.env"
unset _CANON_P45_PROFILE_DIR

export CANON_PROFILE=qwen3-8b-dp8-tp8-frozenlake-resident
export CANON_P32_WORKLOAD=frozenlake-dp8-tp8
export CANON_MODEL_DIR_NAME=qwen8b_tp8
export CANON_QWEN3_TP_SIZE=8
export CANON_DP_SIZE=8
export CANON_TP_SIZE=8
export CANON_TOTAL_DEVICES=64
export CANON_ENGINE_DP_SIZE=8
export CANON_GLOBAL_PROMPTS=32
export CANON_LOCAL_PROMPTS=4
export CANON_NUM_GENERATIONS=8
export CANON_LOCAL_TRAJECTORIES=32
export CANON_GLOBAL_TRAJECTORIES=256
export CANON_DP_PROBE_LOCAL_SAMPLES=32
export CANON_LOGPROB_M=256
export CANON_TARGET_M=256
export CANON_MAX_BATCHED=256
export MIN_TOKEN_BUCKET=2048
export FL_SHARED_MESH=8,8

if [ "${CANON_P33_RUN_STAGE:-}" != "full" ] || \
   [ "${CANON_P33_NO_COMMIT:-}" != "0" ]; then
  echo "[profile] P45 resident carrier requires committed full training" >&2
  return 1 2>/dev/null || exit 1
fi
if [ "${CANON_OPT_STATE_RESIDENT:-}" != "1" ] || \
   [ "${CANON_P30_OPT_STATE_OFFLOAD:-}" != "0" ]; then
  echo "[profile] P45 requires resident=1 and optimizer offload=0" >&2
  return 1 2>/dev/null || exit 1
fi

export CANON_WANDB_PROJECT=zero-tim-frozenlake-dp8-tp8-resident
export CANON_WANDB_GROUP=qwen3-8b-dp8-tp8-resident
export CANON_WANDB_RUN_NAME="${CANON_WANDB_RUN_NAME:-p45-frozenlake-full-attempt-${JOBSET_RESTART_ATTEMPT:-unknown}}"
