# Qwen3-4B-Instruct-2507 clean-data evaluation profile. No trainer is admitted.

_CANON_P46_REQUESTED_TOPOLOGY="${CANON_P46_TOPOLOGY:-}"
_CANON_P46_REQUESTED_EVALUATION_MODE="${CANON_P46_EVALUATION_MODE:-reward_only}"
_CANON_P46_REQUESTED_PARITY_CANARY="${CANON_P46_PARITY_CANARY:-0}"
_CANON_P46_PROFILE_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
# shellcheck disable=SC1091
source "$_CANON_P46_PROFILE_DIR/qwen3-32b-dp16-tp8-deepswe.env"
# shellcheck disable=SC1091
source "$_CANON_P46_PROFILE_DIR/qwen3-4b.env"
unset _CANON_P46_PROFILE_DIR
export CANON_P46_TOPOLOGY="$_CANON_P46_REQUESTED_TOPOLOGY"
export CANON_P46_EVALUATION_MODE="$_CANON_P46_REQUESTED_EVALUATION_MODE"
export CANON_P46_PARITY_CANARY="$_CANON_P46_REQUESTED_PARITY_CANARY"
unset _CANON_P46_REQUESTED_TOPOLOGY
unset _CANON_P46_REQUESTED_EVALUATION_MODE
unset _CANON_P46_REQUESTED_PARITY_CANARY

case "$CANON_P46_TOPOLOGY" in
  64|256) ;;
  *)
    echo "P46 evaluation profile requires topology 64 or 256" >&2
    return 1
    ;;
esac

export CANON_PROFILE="qwen3-4b-instruct-16k-eval-${CANON_P46_TOPOLOGY}"
export CANON_P34_DEEPSWE=0
export CANON_P46_DEEPSWE_TRAIN=0
export CANON_P46_EVALUATION=1
export CANON_P34_TOPOLOGY_ADMITTED=0
export CANON_P34_TP8_ADMITTED=0
export CANON_P34_TRAJECTORY_ADMITTED=0
export CANON_P34_UPDATE_ADMITTED=0
export CANON_P34_TRAJECTORY_CAPTURE=0
export CANON_P32_TRAIN_ADMITTED=0
export CANON_P32_DP_REDUCTION_ADMITTED=0
export CANON_P33_WORKLOAD_LAUNCH_ADMITTED=0
export CANON_WANDB_ONLINE_REQUIRED=0
export WANDB_MODE=disabled
export CANON_EXPECT_MODEL_MESH_IDS=""

# The evaluation mode is a single source of truth. reward_only is the only
# production value; logprob_observer is admitted only for its 64-chip parity
# canary. These are derived invariants, not independently configurable flags.
export CANON_PROMPT_PROCESSED_LOGPROBS=0
export CANON_PALLAS_LOGSOFTMAX=0
export CANON_ENGINE_MODULE_C=0
export CANON_RPA_VJP2=0
export CANON_ALIGNMENT_GATE=0
export CANON_ALIGNMENT_GATE_ONLY=0
export CANON_ALIGNMENT_UPDATE_CANARY=0
export CANON_ALIGNMENT_TRAIN=0
export CANON_PRE_ALIGN_GATE=0
export CANON_DEEPSWE_ALIGNMENT_WARN_ONLY=0
export CANON_P28_SEGMENTED_FORWARD=0
export CANON_P28_SEGMENTED_VJP=0
export CANON_P28_SEGMENTED_TRAIN=0
export CANON_P28_G6_UPDATE=0
export CANON_P29_FULL_TRAIN=0
export CANON_OPT_STATE_RESIDENT=0
export CANON_P30_SPARSE_GRAD_ASSEMBLY=0
export CANON_P30_FUSED_PAIR_ACCUMULATION=0
export CANON_P30_REUSE_SEGMENTED_ENGINE=0
export CANON_P30_RELEASE_CAPTURED_STATE=0
export CANON_P30_RESHARD_ACCUMULATOR=0
