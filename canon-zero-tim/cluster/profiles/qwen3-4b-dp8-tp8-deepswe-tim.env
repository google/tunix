# P58 paired Qwen3-4B DeepSWE training profile.  Both arms use one 4x4x8
# slice split into rollout DP8xTP8 and trainer DP8xTP8 roles.  The only
# registered treatment is the numerical runtime selected by CANON_P58_TIM_ARM.

_CANON_P58_PROFILE_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
# shellcheck disable=SC1091
source "$_CANON_P58_PROFILE_DIR/qwen3-32b-dp16-tp8-deepswe.env"
# shellcheck disable=SC1091
source "$_CANON_P58_PROFILE_DIR/qwen3-4b.env"
unset _CANON_P58_PROFILE_DIR

export CANON_PROFILE=qwen3-4b-dp8-tp8-deepswe-tim
export CANON_P39_64CHIP_PILOT=0
export CANON_P39_PILOT_ADMITTED=0
export CANON_P43_DEEPSWE_DEBUG=0
export CANON_P43_DEBUG_ADMITTED=0
export CANON_P43_ROLLOUT_ONLY=0
export CANON_P44_DEEPSWE_PARITY=0
export CANON_P44_PARITY_ADMITTED=0
export CANON_P44_TOPOLOGY=none
export CANON_P44_ROLLOUT_ONLY=0
export CANON_P46_DEEPSWE_TRAIN=0
export CANON_P46_EVALUATION=0
export CANON_P46_TOPOLOGY=none
export CANON_P58_DEEPSWE_TIM=1
export CANON_P58_TIM_ADMITTED=1

# DeepSWE must not inherit FrozenLake-only training or alignment regimes.  Keep
# these zeros explicit because 00_env.sh treats a signed stock arm differently
# from an unset/underspecified environment.
export CANON_FROZENLAKE_L3=0
export CANON_FROZENLAKE_P27=0
export CANON_FROZENLAKE_ALIGNMENT_WARN_ONLY=0

export CANON_DP_SIZE=8
export CANON_TP_SIZE=8
export CANON_TOTAL_DEVICES=64
export CANON_ENGINE_DP_SIZE=8
export CANON_GLOBAL_PROMPTS=8
export CANON_NUM_GENERATIONS=16
export CANON_LOCAL_TRAJECTORIES=16
export CANON_GLOBAL_TRAJECTORIES=128
export CANON_TARGET_M=256
export MIN_TOKEN_BUCKET=2048
export CANON_P34_ABCPROD=256
export CANON_P34_MAX_NUM_SEQS=16
export CANON_P34_MAX_BATCHED_TOKENS=256
export FL_SHARED_MESH=8,8
export CANON_EXPECT_MODEL_MESH_IDS=""

export CANON_P34_TRAJECTORY_CAPTURE=0
export CANON_P34_CLEAN_ROWS=1012
export CANON_DEEPSWE_CLEANUP_TIMEOUT_SECS=300
export CANON_DEEPSWE_ROLLOUT_BATCH_TIMEOUT_SECS=3600
export CANON_DEEPSWE_PER_TURN_TIMEOUT_SECS=300
export CANON_DEEPSWE_TRAJECTORY_TIMEOUT_SECS=3000
export CANON_DEEPSWE_STEP_TIMEOUT_SECS=600
export CANON_DEEPSWE_REWARD_TIMEOUT_SECS=600
export R2E_ACTIVE_DEADLINE_SECONDS=3300
export NODE_SELECTOR_VAL=cpu-np
export CANON_OPT_STATE_RESIDENT=1
export CANON_P30_OPT_STATE_OFFLOAD=0

# Alignment is observer-only in the native arm and strict in the zero arm.
# Native permits finite decode-vs-prefill drift only; B-C and all structural
# failures remain blocking in tunix.rl.alignment.
export CANON_ALIGNMENT_GATE=1
export CANON_ALIGNMENT_GATE_ONLY=0
export CANON_ALIGNMENT_UPDATE_CANARY=0
export CANON_ALIGNMENT_TRAIN=1
export CANON_PRE_ALIGN_GATE=1

case "${CANON_P58_TIM_ARM:-}" in
  native)
    # Presence activates several engine shims even when their value is zero.
    # Remove presence-sensitive switches and explicitly zero boolean gates.
    unset CANON_FIXED_AR CANON_FIXED_AR_EMBED
    unset CANON_RPA_D CANON_RPA_P CANON_RPA_M CANON_LOGPROB_M
    unset CANON_PALLAS_ALL_PROJ CANON_PALLAS_ALL_RMSNORM
    unset CANON_PALLAS_SWIGLU CANON_PALLAS_MPAD
    unset CANON_PALLAS_SWIGLU_MPAD CANON_PALLAS_CANONICAL_VJP
    export XLA_FLAGS="--xla_cpu_max_isa=AVX2"
    export CANON_RPA_VJP2=0
    export CANON_VJP2_MAX_SEQS=0
    export CANON_PROMPT_PROCESSED_LOGPROBS=0
    export CANON_PALLAS_LOGSOFTMAX=0
    export CANON_ENGINE_MODULE_C=0
    export CANON_KV_UNIFIED=0
    export CANON_P32_DP_ADMISSION=0
    export CANON_P32_TRAIN_ADMITTED=1
    export CANON_P32_DP_REDUCTION_ADMITTED=0
    export CANON_P33_WORKLOAD_LAUNCH_ADMITTED=1
    export CANON_P32_DP16_SEGMENTED=0
    export CANON_P28_SEGMENTED_FORWARD=0
    export CANON_P28_SEGMENTED_VJP=0
    export CANON_P28_SEGMENTED_TRAIN=0
    export CANON_P28_G6_UPDATE=0
    export CANON_P28_BATCHED_REPORT=0
    export CANON_P28_BATCHED_REVERSE=0
    export CANON_BATCHED_EVIDENCE=0
    export CANON_P29_FULL_TRAIN=0
    export CANON_P30_SPARSE_GRAD_ASSEMBLY=0
    export CANON_P30_FUSED_PAIR_ACCUMULATION=0
    export CANON_P30_REUSE_SEGMENTED_ENGINE=0
    export CANON_P30_RELEASE_CAPTURED_STATE=0
    export CANON_P30_RESHARD_ACCUMULATOR=0
    export CANON_DEEPSWE_ALIGNMENT_WARN_ONLY=1
    ;;
  zero)
    export CANON_P32_TRAIN_ADMITTED=1
    export CANON_P32_DP_REDUCTION_ADMITTED=1
    export CANON_P33_WORKLOAD_LAUNCH_ADMITTED=1
    export CANON_DEEPSWE_ALIGNMENT_WARN_ONLY=0
    ;;
  *)
    echo "[profile] P58 requires CANON_P58_TIM_ARM=native or zero" >&2
    return 1 2>/dev/null || exit 1
    ;;
esac

case "${CANON_P34_RUN_STAGE:-}" in
  three-update)
    [ "${CANON_P58_EXPECTED_UPDATES:-}" = "3" ] || {
      echo "[profile] P58 canary requires exactly three expected updates" >&2
      return 1 2>/dev/null || exit 1
    }
    ;;
  full)
    [ "${CANON_P58_EXPECTED_UPDATES:-}" = "1000" ] || {
      echo "[profile] P58 full run requires exactly 1000 expected updates" >&2
      return 1 2>/dev/null || exit 1
    }
    ;;
  *)
    echo "[profile] P58 admits only three-update or full" >&2
    return 1 2>/dev/null || exit 1
    ;;
esac

export CANON_WANDB_PROJECT=zero-tim-deepswe-4b-native-zero
export CANON_WANDB_GROUP="qwen3-4b-p58-${CANON_P34_RUN_STAGE}"
export CANON_WANDB_RUN_NAME="${CANON_WANDB_RUN_NAME:-p58-${CANON_P58_TIM_ARM}-${CANON_P34_RUN_STAGE}-${CANON_RUN_ID:-unset}}"
