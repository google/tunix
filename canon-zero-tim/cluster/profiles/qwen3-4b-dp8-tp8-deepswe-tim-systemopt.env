# P58 Qwen3-4B 128-chip split-role system-optimization admission profile.
#
# Rollout and trainer each own DP8xTP8 on disjoint 64-device meshes. Control is
# a three-update diagnostic arm; treatment may also select the explicit full
# candidate. The numerical treatment matches the 64split profile, while row
# groups and global M remain those of this DP8 geometry.

case "${CANON_DEEPSWE_SYSTEM_OPTIMIZATION_ARM:-}" in
  control|treatment) ;;
  *)
    echo "[profile] P58 128 systemopt arm must be control or treatment" >&2
    return 1 2>/dev/null || exit 1
    ;;
esac

_CANON_P58_EXPECT_P78=0
if [ "$CANON_DEEPSWE_SYSTEM_OPTIMIZATION_ARM" = "treatment" ]; then
  _CANON_P58_EXPECT_P78=1
fi
if [[ -v CANON_P78_SEGMENTED_ACTOR_LOGPS ]] && \
   [ "$CANON_P78_SEGMENTED_ACTOR_LOGPS" != "$_CANON_P58_EXPECT_P78" ]; then
  echo "[profile] P58 128 P78 selector contradicts the systemopt arm" >&2
  return 1 2>/dev/null || exit 1
fi
export CANON_P78_SEGMENTED_ACTOR_LOGPS="$_CANON_P58_EXPECT_P78"
unset _CANON_P58_EXPECT_P78

if [ "${CANON_P58_TOPOLOGY:-}" != "128" ] || \
   [ "${CANON_P58_TIM_ARM:-}" != "zero" ] || \
   [ "${CANON_P34_NO_COMMIT:-}" != "0" ]; then
  echo "[profile] P58 128 systemopt requires committed Zero training" >&2
  return 1 2>/dev/null || exit 1
fi
case "${CANON_DEEPSWE_SYSTEM_OPTIMIZATION_ARM}:${CANON_P34_RUN_STAGE:-}:${CANON_P58_EXPECTED_UPDATES:-}" in
  control:three-update:3|treatment:three-update:3|treatment:full:1000) ;;
  *)
    echo "[profile] P58 128 systemopt stage/arm horizon drifted" >&2
    return 1 2>/dev/null || exit 1
    ;;
esac

_CANON_P58_SYSTEMOPT_PROFILE_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
# shellcheck disable=SC1091
source "$_CANON_P58_SYSTEMOPT_PROFILE_DIR/qwen3-4b-dp8-tp8-deepswe-tim.env"
unset _CANON_P58_SYSTEMOPT_PROFILE_DIR

if [ "${CANON_DP_SIZE:-}" != "8" ] || \
   [ "${CANON_TP_SIZE:-}" != "8" ] || \
   [ "${CANON_TOTAL_DEVICES:-}" != "64" ] || \
   [ "${CANON_LOCAL_TRAJECTORIES:-}" != "16" ] || \
   [ "${CANON_GLOBAL_TRAJECTORIES:-}" != "128" ] || \
   [ "${MIN_TOKEN_BUCKET:-}" != "2048" ] || \
   [ "${CANON_P34_MAX_NUM_SEQS:-}" != "16" ] || \
   [ "${FL_SHARED_MESH:-}" != "8,8" ] || \
   [ "${CANON_DEEPSWE_ALIGNMENT_WARN_ONLY:-}" != "0" ] || \
   [ "${CANON_ALIGNMENT_AUDIT_EVERY:-}" != "10" ] || \
   [ "${CANON_P38_FIXED_LM_HEAD:-}" != "1" ] || \
   [ "${CANON_P59_RANK_PARALLEL_BACKWARD:-}" != "1" ] || \
   [ "${CANON_P59_CHECKED_VMA:-}" != "1" ] || \
   [ "${CANON_P67_P66_VMA_P59_ONLY:-}" != "1" ] || \
   [ "${CANON_V1_HP_FIRST_UPDATE_GATE:-}" != "1" ] || \
   [ "${CANON_DP_COMPARE_MODE:-}" != "fingerprint-hybrid" ] || \
   [ "${CANON_DP_DISTINCT_SCHEDULE:-}" != "first-group-warmup" ] || \
   [ "${CANON_DP_FINITE_FETCH:-}" != "batched-commit" ] || \
   [ "${CANON_P71_SCAN:-}" != "fwd" ] || \
   [ "${CANON_V1_HP_FULL:-0}" != "0" ]; then
  echo "[profile] P58 128 systemopt common tuple drifted" >&2
  return 1 2>/dev/null || exit 1
fi

if [[ -v CANON_DP_COLLECTIVE_REDUCE ]] || \
   [[ -v CANON_P63_OVERFLOW_SAFE_CLIP ]]; then
  echo "[profile] P58 128 systemopt inherited an unadmitted selector" >&2
  return 1 2>/dev/null || exit 1
fi

case "$CANON_DEEPSWE_SYSTEM_OPTIMIZATION_ARM" in
  control)
    if [ "${CANON_P78_SEGMENTED_ACTOR_LOGPS:-}" != "0" ] || \
       [[ -v CANON_P32_KEEP_TAPE ]] || \
       [[ -v CANON_DP_REDUCE_ONCE ]] || \
       [[ -v CANON_P32_LENGTH_SORT ]]; then
      echo "[profile] P58 128 control leaked treatment selectors" >&2
      return 1 2>/dev/null || exit 1
    fi
    ;;
  treatment)
    if [ "${CANON_P78_SEGMENTED_ACTOR_LOGPS:-}" != "1" ] || \
       [ "${CANON_P32_KEEP_TAPE:-}" != "stream" ] || \
       [ "${CANON_DP_REDUCE_ONCE:-}" != "1" ] || \
       [ "${CANON_P32_LENGTH_SORT:-}" != "1" ]; then
      echo "[profile] P58 128 treatment requires stream, reduce-once and length-sort" >&2
      return 1 2>/dev/null || exit 1
    fi
    ;;
esac

export CANON_PROFILE=qwen3-4b-dp8-tp8-deepswe-tim-systemopt
