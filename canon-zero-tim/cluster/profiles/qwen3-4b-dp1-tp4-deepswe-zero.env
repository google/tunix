# P58.20 direct-v5p Qwen3-4B full-stack strict Zero-TIM admission.
# This profile is intentionally separate from the TP8 production profile.

[ "${CANON_P58_Q4_TP4_ZERO_ADMISSION:-0}" = "1" ] || {
  echo "[profile] P58.20 requires CANON_P58_Q4_TP4_ZERO_ADMISSION=1" >&2
  return 1 2>/dev/null || exit 1
}
[ "${CANON_P58_ONEHOST_XPROF_ARM:-}" = "zero-hp" ] || {
  echo "[profile] P58.20 requires the one-host Zero-HP arm" >&2
  return 1 2>/dev/null || exit 1
}
case "${CANON_P58_Q4_TP4_CARRIER_SCREEN:-0}" in
  0)
    [ "${CANON_DEEPSWE_ONEHOST_SMOKE:-0}:${CANON_DEEPSWE_ONEHOST_STAGE:-}:${CANON_DEEPSWE_ONEHOST_NO_COMMIT:-0}:${CANON_DEEPSWE_ONEHOST_ROLLOUT_ONLY:-0}" = \
      "1:backward-no-commit:1:0" ] || {
      echo "[profile] P58.20 requires exact backward-no-commit one-host identity" >&2
      return 1 2>/dev/null || exit 1
    }
    ;;
  1)
    [ "${CANON_DEEPSWE_ONEHOST_SMOKE:-0}:${CANON_DEEPSWE_ONEHOST_STAGE:-}:${CANON_DEEPSWE_ONEHOST_NO_COMMIT:-0}:${CANON_DEEPSWE_ONEHOST_ROLLOUT_ONLY:-0}" = \
      "1:rollout-only:0:1" ] || {
      echo "[profile] P58.22 carrier screen requires exact rollout-only identity" >&2
      return 1 2>/dev/null || exit 1
    }
    ;;
  *)
    echo "[profile] P58.22 carrier screen must be 0 or 1" >&2
    return 1 2>/dev/null || exit 1
    ;;
esac
[ "${CANON_P58_DEEPSWE_TIM:-0}:${CANON_P58_TIM_ADMITTED:-0}" = "0:0" ] || {
  echo "[profile] P58.20 cannot overlap production P58" >&2
  return 1 2>/dev/null || exit 1
}
case "${CANON_P58_Q4_TP4_SEAM_DIAGNOSTIC:-}" in
  ""|standard-decode) ;;
  *)
    echo "[profile] P58.21 seam diagnostic must be empty or standard-decode" >&2
    return 1 2>/dev/null || exit 1
    ;;
esac
case "${CANON_P58_Q4_TP4_CONTINUE_KV_DIAGNOSTIC:-0}" in
  0|1) ;;
  *)
    echo "[profile] P58.22 continue-KV diagnostic must be 0 or 1" >&2
    return 1 2>/dev/null || exit 1
    ;;
esac
case "${CANON_P58_Q4_TP4_SHORT_BACKWARD:-0}" in
  0|1) ;;
  *)
    echo "[profile] P58.22 short backward must be 0 or 1" >&2
    return 1 2>/dev/null || exit 1
    ;;
esac
if [ "${CANON_P58_Q4_TP4_CONTINUE_KV_DIAGNOSTIC:-0}" = 1 ] && \
   [ -n "${CANON_P58_Q4_TP4_SEAM_DIAGNOSTIC:-}" ]; then
  echo "[profile] P58.22 continue-KV and P58.21 standard-decode are exclusive" >&2
  return 1 2>/dev/null || exit 1
fi
if [ "${CANON_P58_Q4_TP4_SHORT_BACKWARD:-0}" = 1 ] && \
   { [ "${CANON_P58_Q4_TP4_CONTINUE_KV_DIAGNOSTIC:-0}" != 0 ] || \
     [ -n "${CANON_P58_Q4_TP4_SEAM_DIAGNOSTIC:-}" ]; }; then
  echo "[profile] P58.22 short backward excludes diagnostics and standard decode" >&2
  return 1 2>/dev/null || exit 1
fi
if [ "${CANON_P58_Q4_TP4_CARRIER_SCREEN:-0}" = 1 ] && \
   [ "${CANON_P58_Q4_TP4_SHORT_BACKWARD:-0}" != 1 ]; then
  echo "[profile] P58.22 carrier screen requires the short carrier" >&2
  return 1 2>/dev/null || exit 1
fi
case "${CANON_P58_Q4_TP4_TRAJECTORY_REPLAY:-0}" in
  0) ;;
  1)
    [ "${CANON_P58_Q4_TP4_SHORT_BACKWARD:-0}:${CANON_P58_Q4_TP4_CARRIER_SCREEN:-0}" = \
      "1:0" ] || {
      echo "[profile] P58.23 B2xG2 replay requires short backward and forbids carrier screen" >&2
      return 1 2>/dev/null || exit 1
    }
    ;;
  *)
    echo "[profile] P58.23 trajectory replay must be 0 or 1" >&2
    return 1 2>/dev/null || exit 1
    ;;
esac

_CANON_P58_Q4_TP4_PROFILE_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
# shellcheck disable=SC1091
source "$_CANON_P58_Q4_TP4_PROFILE_DIR/_canonical_engine.env"
unset _CANON_P58_Q4_TP4_PROFILE_DIR

export CANON_PROFILE=qwen3-4b-dp1-tp4-deepswe-zero
export CANON_PROFILE_FILE=cluster/profiles/qwen3-4b-dp1-tp4-deepswe-zero.env
export CANON_MODEL_DIR_NAME=qwen4b_tp4
export CANON_QWEN3_HIDDEN_SIZE=2560
export CANON_QWEN3_INTERMEDIATE_SIZE=9728
export CANON_QWEN3_NUM_ATTENTION_HEADS=32
export CANON_QWEN3_NUM_KV_HEADS=8
export CANON_QWEN3_HEAD_DIM=128
export CANON_QWEN3_TP_SIZE=4
export CANON_DP_SIZE=1
export CANON_TP_SIZE=4
export CANON_TOTAL_DEVICES=4
export CANON_ENGINE_DP_SIZE=1
export FL_SHARED_MESH=1,4
export CANON_EXPECT_MODEL_MESH_IDS=0,2,1,3

export CANON_P58_NATIVE_STOCK_PROMPT_OBSERVER=0
export CANON_PROMPT_PROCESSED_LOGPROBS=1
export CANON_ENGINE_MODULE_C=1
export CANON_DEEPSWE_ALIGNMENT_WARN_ONLY=0
export CANON_VLLM_ENABLE_PREFIX_CACHING=0
export CANON_P38_FIXED_LM_HEAD=1
export CANON_P59_RANK_PARALLEL_BACKWARD=0
export CANON_P59_CHECKED_VMA=0
export CANON_P66_P59_CHECK_VMA=0
export CANON_P67_P66_VMA_P59_ONLY=0
if [ "${CANON_P58_Q4_TP4_SEAM_DIAGNOSTIC:-}" = standard-decode ]; then
  export CANON_CONTINUE_DECODE=
else
  export CANON_CONTINUE_DECODE=8
fi
export CANON_FIXED_AR_GATHER=1
export CANON_PALLAS_GATHERED_LOGPROBS=1
export CANON_LOGPROB_STEP_FUSION=1
export CANON_FUSED_TREE_OPS=0
export CANON_PALLAS_NORM_MATMUL=0
export CANON_PALLAS_INPUT_FUSION=0
export CANON_SAMPLE_SPLIT_FUSION=0
export CANON_ENGINE_LOGPROB_READBACK=0
export CANON_ANCHOR_OVERLAP=0
export CANON_P63_OVERFLOW_SAFE_CLIP=0
export CANON_V1_HP_FIRST_UPDATE_GATE=0
export CANON_OPT_STATE_RESIDENT=1
export CANON_P30_OPT_STATE_OFFLOAD=0

if [ "${CANON_P58_Q4_TP4_TRAJECTORY_REPLAY:-0}" = 1 ]; then
  # P58.23 uses the current segmented system-optimization carrier. DP1 cannot
  # execute P59 rank-parallel backward, so the one-host admission keeps P59
  # off while exercising P28/P30 plus the hardware-certified P71 forward scan.
  export CANON_P28_SEGMENTED_FORWARD=1
  export CANON_P28_SEGMENTED_VJP=0
  export CANON_P28_SEGMENTED_TRAIN=1
  export CANON_P28_G6_UPDATE=1
  export CANON_P29_FULL_TRAIN=1
  export CANON_P30_SPARSE_GRAD_ASSEMBLY=1
  export CANON_P30_FUSED_PAIR_ACCUMULATION=0
  export CANON_P30_REUSE_SEGMENTED_ENGINE=1
  export CANON_P30_RELEASE_CAPTURED_STATE=1
  export CANON_P30_RESHARD_ACCUMULATOR=1
  export CANON_P28_BATCHED_REPORT=1
  export CANON_P28_BATCHED_REVERSE=0
  export CANON_BATCHED_EVIDENCE=0
  export CANON_P71_SCAN=fwd
  unset CANON_P28_LAYER_SCAN CANON_P66_BACKWARD_ARM
fi
