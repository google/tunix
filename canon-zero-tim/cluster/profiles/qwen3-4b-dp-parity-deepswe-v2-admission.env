# Strict Qwen3-4B DeepSWE system-optimization admission. The renderer owns
# CANON_DEEPSWE_SYSTEM_OPTIMIZATION_ARM and every subordinate value; this
# profile validates the resolved tuple without rewriting a conflicting input.

_CANON_P44_V2_PROFILE_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
# shellcheck disable=SC1091
source "$_CANON_P44_V2_PROFILE_DIR/qwen3-4b-dp-parity-deepswe-debug.env"
unset _CANON_P44_V2_PROFILE_DIR

case "${CANON_DEEPSWE_SYSTEM_OPTIMIZATION_ARM:-}" in
  control|treatment) ;;
  *)
    echo "P44 v2 admission requires system-optimization arm control or treatment" >&2
    return 1
    ;;
esac

if [ "${CANON_P34_RUN_STAGE:-}" != "three-update" ] || \
   [ "${CANON_P34_NO_COMMIT:-}" != "0" ] || \
   [ "${CANON_P44_DEEPSWE_PARITY:-}" != "1" ] || \
   [ "${CANON_P44_PARITY_ADMITTED:-}" != "1" ] || \
   [ "${CANON_P44_ROLLOUT_ONLY:-}" != "0" ] || \
   [ "${CANON_DEEPSWE_ALIGNMENT_WARN_ONLY:-}" != "0" ] || \
   [ "${CANON_P38_FIXED_LM_HEAD:-}" != "1" ] || \
   [ "${CANON_P59_RANK_PARALLEL_BACKWARD:-}" != "1" ] || \
   [ "${CANON_P59_CHECKED_VMA:-}" != "1" ] || \
   [ "${CANON_P67_P66_VMA_P59_ONLY:-}" != "1" ] || \
   [ "${CANON_V1_HP_FIRST_UPDATE_GATE:-}" != "1" ] || \
   [ "${CANON_DP_COMPARE_MODE:-}" != "fingerprint-hybrid" ] || \
   [ "${CANON_DP_DISTINCT_SCHEDULE:-}" != "first-group-warmup" ] || \
   [ "${CANON_DP_FINITE_FETCH:-}" != "batched-commit" ] || \
   [ "${CANON_P71_SCAN:-}" != "fwd" ]; then
  echo "P44 v2 admission common system-optimization tuple drifted" >&2
  return 1
fi

if [[ -v CANON_V1_HP_FULL ]] || [[ -v CANON_P63_OVERFLOW_SAFE_CLIP ]] || \
   [[ -v CANON_P66_P59_CHECK_VMA ]] || \
   [[ -v CANON_DP_COLLECTIVE_REDUCE ]] || \
   [[ -v CANON_P32_LENGTH_SORT ]]; then
  echo "P44 v2 admission inherited a forbidden production or experiment selector" >&2
  return 1
fi

case "$CANON_DEEPSWE_SYSTEM_OPTIMIZATION_ARM" in
  control)
    if [[ -v CANON_P32_KEEP_TAPE ]] || [[ -v CANON_DP_REDUCE_ONCE ]]; then
      echo "P44 v2 control arm must keep stream and reduce-once absent" >&2
      return 1
    fi
    ;;
  treatment)
    if [ "${CANON_P32_KEEP_TAPE:-}" != "stream" ] || \
       [ "${CANON_DP_REDUCE_ONCE:-}" != "1" ]; then
      echo "P44 v2 treatment arm requires stream and reduce-once" >&2
      return 1
    fi
    ;;
esac

case "${CANON_P44_TOPOLOGY:-}" in
  64) export CANON_PROFILE=qwen3-4b-dp4-tp8-deepswe-v2-admission ;;
  128) export CANON_PROFILE=qwen3-4b-dp8-tp8-deepswe-v2-admission ;;
  *)
    echo "P44 v2 admission requires topology 64 or 128" >&2
    return 1
    ;;
esac
