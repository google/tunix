# P58 Qwen3-4B 64-chip split-role profile.
#
# One physical 4x4x4 slice is divided into disjoint rollout and trainer halves;
# each role owns 32 devices as DP4xTP8.  The scientific batch remains B8xG16.
# This profile deliberately does not admit the DP8-only P58 high-performance or
# diagnostic overlays.

if [ "${CANON_P58_TOPOLOGY:-}" != "64split" ]; then
  echo "[profile] P58 split profile requires CANON_P58_TOPOLOGY=64split" >&2
  return 1 2>/dev/null || exit 1
fi
if [ "${CANON_V1_HP_FULL:-0}" != "0" ] || \
   [ -n "${CANON_P58_CHECKED_VMA_DIAGNOSTIC:-}" ] || \
   [ -n "${CANON_P58_SEAM_LOCALIZATION:-}" ]; then
  echo "[profile] P58 64split does not admit the DP8 high-performance/diagnostic bundle" >&2
  return 1 2>/dev/null || exit 1
fi

_CANON_P58_SPLIT_PROFILE_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
# shellcheck disable=SC1091
source "$_CANON_P58_SPLIT_PROFILE_DIR/qwen3-4b-dp8-tp8-deepswe-tim.env"
unset _CANON_P58_SPLIT_PROFILE_DIR

export CANON_PROFILE=qwen3-4b-dp4-tp8-deepswe-tim-split
export CANON_P58_TOPOLOGY=64split
export CANON_DP_SIZE=4
export CANON_TP_SIZE=8
export CANON_TOTAL_DEVICES=32
export CANON_ENGINE_DP_SIZE=4
export CANON_LOCAL_TRAJECTORIES=32
export CANON_GLOBAL_TRAJECTORIES=128
export CANON_TARGET_M=256
export MIN_TOKEN_BUCKET=1024
export CANON_P34_ABCPROD=256
export CANON_P34_MAX_NUM_SEQS=32
export CANON_P34_MAX_BATCHED_TOKENS=256
export FL_SHARED_MESH=4,8

# Native remains an observer arm.  Zero is strict on the unadmitted topology;
# in particular, it cannot inherit the 128-only full-HP warning policy.
case "${CANON_P58_TIM_ARM:-}" in
  native)
    export CANON_DEEPSWE_ALIGNMENT_WARN_ONLY=1
    ;;
  zero)
    export CANON_DEEPSWE_ALIGNMENT_WARN_ONLY=0
    ;;
  *)
    echo "[profile] P58 64split requires CANON_P58_TIM_ARM=native or zero" >&2
    return 1 2>/dev/null || exit 1
    ;;
esac
