# Qwen3-32B 16K full-training profile shared by the 64/256 P46 topologies.

_CANON_P46_REQUESTED_TOPOLOGY="${CANON_P46_TOPOLOGY:-}"
_CANON_P46_PROFILE_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
# shellcheck disable=SC1091
source "$_CANON_P46_PROFILE_DIR/qwen3-32b-dp16-tp8-deepswe.env"
unset _CANON_P46_PROFILE_DIR
export CANON_P46_TOPOLOGY="$_CANON_P46_REQUESTED_TOPOLOGY"
unset _CANON_P46_REQUESTED_TOPOLOGY

export CANON_P46_DEEPSWE_TRAIN=1
export CANON_P46_EVALUATION=0
export CANON_P39_64CHIP_PILOT=0
export CANON_P39_PILOT_ADMITTED=0
export CANON_P43_DEEPSWE_DEBUG=0
export CANON_P43_DEBUG_ADMITTED=0
export CANON_P43_ROLLOUT_ONLY=0
export CANON_P44_DEEPSWE_PARITY=0
export CANON_P44_PARITY_ADMITTED=0
export CANON_P44_TOPOLOGY=none
export CANON_P44_ROLLOUT_ONLY=0

case "$CANON_P46_TOPOLOGY" in
  64)
    export CANON_PROFILE=qwen3-32b-dp4-tp8-deepswe-full
    export CANON_DP_SIZE=4
    export CANON_TOTAL_DEVICES=32
    export CANON_ENGINE_DP_SIZE=4
    export CANON_LOCAL_TRAJECTORIES=16
    export MIN_TOKEN_BUCKET=1024
    export CANON_P34_MAX_NUM_SEQS=16
    export FL_SHARED_MESH=4,8
    ;;
  256)
    export CANON_PROFILE=qwen3-32b-dp16-tp8-deepswe-full
    export CANON_DP_SIZE=16
    export CANON_TOTAL_DEVICES=128
    export CANON_ENGINE_DP_SIZE=16
    export CANON_LOCAL_TRAJECTORIES=4
    export MIN_TOKEN_BUCKET=4096
    export CANON_P34_MAX_NUM_SEQS=4
    export FL_SHARED_MESH=16,8
    ;;
  *)
    echo "P46 Qwen3-32B profile requires topology 64 or 256" >&2
    return 1
    ;;
esac

export CANON_P34_RUN_STAGE=full
export CANON_P34_NO_COMMIT=0
export CANON_P34_TRAJECTORY_CAPTURE=1
export CANON_P34_CLEAN_ROWS=1851
export CANON_WANDB_PROJECT=zero-tim-deepswe-qwen32b-16k
export CANON_WANDB_GROUP="qwen3-32b-16k-${CANON_P46_TOPOLOGY}chip"
export CANON_WANDB_RUN_NAME="${CANON_WANDB_RUN_NAME:-p46-q32-${CANON_P46_TOPOLOGY}-${CANON_RUN_ID:-unset}}"
