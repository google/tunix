# Qwen3-32B DeepSWE candidate: two 128-device roles, each DP16xTP8.

_CANON_PROFILE_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
# shellcheck disable=SC1091
source "$_CANON_PROFILE_DIR/qwen3-32b.env"
unset _CANON_PROFILE_DIR

export CANON_PROFILE=qwen3-32b-dp16-tp8-deepswe
export CANON_P34_DEEPSWE=1
export CANON_P34_TOPOLOGY_ADMITTED="${CANON_P34_TOPOLOGY_ADMITTED:-0}"
export CANON_P34_TP8_ADMITTED="${CANON_P34_TP8_ADMITTED:-0}"
export CANON_P34_TRAJECTORY_ADMITTED="${CANON_P34_TRAJECTORY_ADMITTED:-0}"
export CANON_P34_UPDATE_ADMITTED="${CANON_P34_UPDATE_ADMITTED:-0}"
export CANON_P34_RUN_STAGE="${CANON_P34_RUN_STAGE:-full}"
export CANON_P34_NO_COMMIT="${CANON_P34_NO_COMMIT:-0}"

export CANON_P32_TRAIN_ADMITTED="${CANON_P32_TRAIN_ADMITTED:-0}"
export CANON_P32_DP_REDUCTION_ADMITTED="${CANON_P32_DP_REDUCTION_ADMITTED:-0}"
export CANON_P33_WORKLOAD_LAUNCH_ADMITTED="${CANON_P33_WORKLOAD_LAUNCH_ADMITTED:-0}"
export CANON_P32_DP16_SEGMENTED=1
export CANON_P28_SEGMENTED_FORWARD=1
export CANON_P28_SEGMENTED_VJP=0
export CANON_P28_SEGMENTED_TRAIN=1
export CANON_P28_G6_UPDATE=1
export CANON_P29_FULL_TRAIN=1
export CANON_ALIGNMENT_GATE=1
export CANON_ALIGNMENT_GATE_ONLY=0
export CANON_ALIGNMENT_UPDATE_CANARY=0
export CANON_ALIGNMENT_TRAIN=1
export CANON_PRE_ALIGN_GATE=1

export CANON_DP_SIZE=16
export CANON_TP_SIZE=8
export CANON_TOTAL_DEVICES=128
export CANON_ENGINE_DP_SIZE=16
export CANON_GLOBAL_PROMPTS=8
export CANON_NUM_GENERATIONS=8
export CANON_LOCAL_TRAJECTORIES=4
export CANON_GLOBAL_TRAJECTORIES=64
export CANON_TARGET_M=256
export CANON_LOGPROB_M=256
export MIN_TOKEN_BUCKET=4096
export CANON_P34_ABCPROD=256
export CANON_VJP2_MAX_SEQS=1
# Interactive DeepSWE stages require R2E-Gym; step 35 installs this pinned
# checkout with the vendored patch and fails closed on any drift.
export CANON_R2EGYM_INSTALL=1
export CANON_R2EGYM_COMMIT=0d94c4eb9431cd195c55a7ea3abd54006c9a1735
# Whole-slice device expectation for the step-65 session admission probe
# Unset to prevent temporary client disconnect from killing Cloud Pathways server workers
# export CANON_EXPECTED_SLICE_DEVICES=256
export CANON_TRAIN_DP_SHARDING=replicated-params
export FL_SHARED_MESH=16,8

export CANON_P34_PREFIX_CACHE=0
# TPU inference interprets both limits per DP rank.  DP16 therefore gives the
# signed global capacities of 64 requests and 4096 tokens while preserving one
# local canonical M256 backbone program.
export CANON_P34_MAX_NUM_SEQS=4
export CANON_P34_MAX_BATCHED_TOKENS=256
export CANON_P34_STRICT_CLI=1
export CANON_P34_DISABLE_SAMPLER_IS=1
export CANON_P34_DISABLE_TIS=1

export CANON_P30_OPT_STATE_OFFLOAD=1
export CANON_P30_SPARSE_GRAD_ASSEMBLY=1
export CANON_P30_FUSED_PAIR_ACCUMULATION=0
export CANON_P30_REUSE_SEGMENTED_ENGINE=1
export CANON_P30_RELEASE_CAPTURED_STATE=1
export CANON_P30_RESHARD_ACCUMULATOR=1
export CANON_WANDB_ONLINE_REQUIRED=1
export CANON_P31_MONOTONIC_METRICS=1
export WANDB_MODE=online
export CANON_WANDB_PROJECT=zero-tim-deepswe-dp16-tp8
export CANON_WANDB_GROUP=qwen3-32b-dp16-tp8
export CANON_WANDB_RUN_NAME="${CANON_WANDB_RUN_NAME:-p34-deepswe-${CANON_P34_RUN_STAGE}-${CANON_RUN_ID:-unset}}"
