# Gemma 4 E4B-IT P1 stock-admission profile.
#
# This profile does not enable a canonical numerical path. The caller must
# select exactly one bounded admission workload; missing/empty/0 is the global
# default-off state outside this profile.

case "${CANON_GEMMA4_E4B_P1_ADMISSION:-}" in
  p45|m15) ;;
  *)
    echo "Gemma E4B P1 profile requires p45 or m15 admission" >&2
    return 2 2>/dev/null || exit 2
    ;;
esac

export CANON_PROFILE=gemma4-e4b-dp1-tp4-frozenlake
export CANON_EXPECT_JAX_VERSION=0.10.2
export CANON_EXPECT_PATHWAYS_RELEASE=20260730-jax_0.10.2
export CANON_EXPECT_VISIBLE_DEVICES=4
export CANON_DP_SIZE=1
export CANON_TP_SIZE=4
export FL_ROLLOUT_MESH=1,4
export FL_TRAINER_MESH=1,4

# Stock P1 only: no Gemma canonical adapter and no cached-prefix treatment.
export CANON_ENGINE_MODULE_C=0
export CANON_VLLM_ENABLE_PREFIX_CACHING=0

# The Python entrypoint independently checks these invariants and refuses
# checkpointing, training, backward, or optimizer commits.
export ROLLOUT_ENGINE=vllm
export WANDB_MODE=disabled
export NEW_MODEL_DESIGN=1
export VLLM_ENABLE_V1_MULTIPROCESSING=0
