# Shared body for the exact Qwen3-8B FrozenLake four-chip one-host profiles.
#
# Callers must set the private _CANON_FL4_* tuple before sourcing this file.
# Only DP4xTP1 and DP1xTP4 are accepted here; the previously certified
# DP2xTP2 profile remains an independent frozen neighbor.

case "${_CANON_FL4_PROFILE_REL:-}:${_CANON_FL4_DP:-}:${_CANON_FL4_TP:-}:${_CANON_FL4_MODEL_DIR:-}:${_CANON_FL4_CHECK_VMA:-}:${_CANON_FL4_MESH_IDS:-}" in
  "cluster/profiles/qwen3-8b-dp4-tp1-frozenlake-onehost.env:4:1:qwen8b_tp1:0:0,2,1,3") ;;
  "cluster/profiles/qwen3-8b-dp1-tp4-frozenlake-onehost.env:1:4:qwen8b:1:0,1,2,3") ;;
  *)
    echo "[profile] unregistered FrozenLake four-chip profile tuple" >&2
    return 1 2>/dev/null || exit 1
    ;;
esac
if [ "${CANON_PROFILE_FILE:-}" != "$_CANON_FL4_PROFILE_REL" ]; then
  echo "[profile] FrozenLake four-chip carrier requires its exact profile path" >&2
  return 1 2>/dev/null || exit 1
fi

export CANON_P33_SHARED_MESH="$_CANON_FL4_DP,$_CANON_FL4_TP"
export CANON_OPT_STATE_RESIDENT=0
export CANON_P30_OPT_STATE_OFFLOAD=1
export CANON_P32_TRAIN_ADMITTED=1
export CANON_P32_DP_REDUCTION_ADMITTED=1
export CANON_P33_WORKLOAD_LAUNCH_ADMITTED=1
export CANON_P33_NO_COMMIT=1
export CANON_P33_RUN_STAGE=backward-no-commit

_CANON_FL4_PROFILE_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
# shellcheck disable=SC1091
source "$_CANON_FL4_PROFILE_DIR/qwen3-8b-dp16-tp4-frozenlake.env"
unset _CANON_FL4_PROFILE_DIR

export CANON_PROFILE="qwen3-8b-dp${_CANON_FL4_DP}-tp${_CANON_FL4_TP}-frozenlake-onehost"
export CANON_MODEL_DIR_NAME="$_CANON_FL4_MODEL_DIR"
export CANON_QWEN3_TP_SIZE="$_CANON_FL4_TP"
export CANON_DP_SIZE="$_CANON_FL4_DP"
export CANON_TP_SIZE="$_CANON_FL4_TP"
export CANON_TOTAL_DEVICES=4
export CANON_ENGINE_DP_SIZE="$_CANON_FL4_DP"
export CANON_GLOBAL_PROMPTS=4
export CANON_LOCAL_PROMPTS=$((4 / _CANON_FL4_DP))
export CANON_NUM_GENERATIONS=4
export CANON_LOCAL_TRAJECTORIES=$((16 / _CANON_FL4_DP))
export CANON_GLOBAL_TRAJECTORIES=16
export CANON_DP_PROBE_LOCAL_SAMPLES=32
export CANON_LOGPROB_M=256
export MIN_TOKEN_BUCKET=$((_CANON_FL4_DP * 256))
export CANON_TARGET_M=256
export CANON_MAX_BATCHED=256
export FL_SHARED_MESH="$_CANON_FL4_DP,$_CANON_FL4_TP"
export CANON_EXPECT_MODEL_MESH_IDS="$_CANON_FL4_MESH_IDS"
export CANON_EXPECT_TRAIN_MESH_IDS="$_CANON_FL4_MESH_IDS"
export CANON_REQUIRE_TRAIN_MESH_PIN=1

case "${CANON_P57_WORKLOAD_CANDIDATE:-}:${CANON_P57_DATA_SPLIT:-}" in
  ":")
    export CANON_P32_WORKLOAD="frozenlake-p45-onehost-dp${_CANON_FL4_DP}-tp${_CANON_FL4_TP}"
    export FL_VLLM_HBM_UTIL="$_CANON_FL4_P45_HBM"
    export CANON_WANDB_PROJECT="zero-tim-frozenlake-p45-onehost-dp${_CANON_FL4_DP}-tp${_CANON_FL4_TP}"
    export CANON_WANDB_GROUP="qwen3-8b-p45-onehost-dp${_CANON_FL4_DP}-tp${_CANON_FL4_TP}"
    ;;
  "m15:main")
    export CANON_P32_WORKLOAD="frozenlake-m15-onehost-dp${_CANON_FL4_DP}-tp${_CANON_FL4_TP}"
    export FL_VLLM_HBM_UTIL="$_CANON_FL4_M15_HBM"
    export CANON_WANDB_PROJECT="zero-tim-frozenlake-m15-onehost-dp${_CANON_FL4_DP}-tp${_CANON_FL4_TP}"
    export CANON_WANDB_GROUP="qwen3-8b-m15-onehost-dp${_CANON_FL4_DP}-tp${_CANON_FL4_TP}"
    ;;
  *)
    echo "[profile] FrozenLake four-chip carrier admits only P45 or m15:main" >&2
    return 1 2>/dev/null || exit 1
    ;;
esac
if [ -n "${CANON_P57_RUN_KIND:-}${CANON_P57_TIM_ARM:-}" ]; then
  echo "[profile] FrozenLake four-chip proxy cannot impersonate a P57 target arm" >&2
  return 1 2>/dev/null || exit 1
fi
export CANON_WANDB_RUN_NAME="${CANON_WANDB_RUN_NAME:-fl-dp${_CANON_FL4_DP}-tp${_CANON_FL4_TP}-${CANON_P33_RUN_STAGE}-attempt-${JOBSET_RESTART_ATTEMPT:-0}}"

export CANON_FIXED_AR=1
export CANON_FIXED_AR_EMBED=1
export CANON_FIXED_AR_GATHER=1
export CANON_RPA_D=128,512,128,512
export CANON_RPA_P=128,512,128,512
export CANON_RPA_M=128,512,128,512
export CANON_RPA_VJP2=1
export CANON_VJP2_MAX_SEQS=1
export CANON_PROMPT_PROCESSED_LOGPROBS=1
export CANON_PALLAS_LOGSOFTMAX=1
export CANON_PALLAS_ALL_PROJ=1
export CANON_PALLAS_ALL_RMSNORM=1
export CANON_PALLAS_SWIGLU=1
export CANON_PALLAS_MPAD=1
export CANON_PALLAS_SWIGLU_MPAD=1
export CANON_PALLAS_CANONICAL_VJP=1
export CANON_ENGINE_MODULE_C=1
export CANON_KV_UNIFIED=0
export CANON_CONTINUE_DECODE=8
export CANON_PALLAS_GATHERED_LOGPROBS=1
export CANON_LOGPROB_STEP_FUSION=1
export CANON_VLLM_ENABLE_PREFIX_CACHING=0
export CANON_P59_KIND=v1
export CANON_P59_RANK_PARALLEL_BACKWARD=1
export CANON_P66_P59_CHECK_VMA="$_CANON_FL4_CHECK_VMA"
export CANON_P59_CHECKED_VMA=0
export CANON_V1_HP_FIRST_UPDATE_GATE=0
export CANON_V1_HP_FULL=0
export CANON_P67_P66_VMA_P59_ONLY="$_CANON_FL4_CHECK_VMA"
export CANON_P71_SCAN=fwd
export CANON_DP_COMPARE_MODE=fingerprint-hybrid
export CANON_DP_DISTINCT_SCHEDULE=first-group-warmup
export CANON_DP_FINITE_FETCH=batched-commit
export CANON_P28_BATCHED_REPORT=1
export CANON_BATCHED_EVIDENCE=1
export CANON_P38_FIXED_LM_HEAD=0
export CANON_WANDB_ONLINE_REQUIRED=0
export WANDB_MODE=disabled

export CANON_P32_KEEP_TAPE="${CANON_P32_KEEP_TAPE:-0}"
export CANON_DP_REDUCE_ONCE="${CANON_DP_REDUCE_ONCE:-0}"
export CANON_P32_LENGTH_SORT="${CANON_P32_LENGTH_SORT:-0}"
export CANON_P75_REPORT_ADJOINT_BUCKETS="${CANON_P75_REPORT_ADJOINT_BUCKETS:-0}"
export CANON_P76_CHUNK_DEPENDENCY_TICKET="${CANON_P76_CHUNK_DEPENDENCY_TICKET:-0}"
export CANON_P77_CHUNK_BACKPRESSURE="${CANON_P77_CHUNK_BACKPRESSURE:-0}"
if [ "$CANON_P75_REPORT_ADJOINT_BUCKETS:$CANON_P76_CHUNK_DEPENDENCY_TICKET:$CANON_P77_CHUNK_BACKPRESSURE" != "0:0:0" ]; then
  echo "[profile] P45-DP2 capacity diagnostics do not cross topology" >&2
  return 1 2>/dev/null || exit 1
fi
case "$_CANON_FL4_DP:$CANON_P32_KEEP_TAPE:$CANON_DP_REDUCE_ONCE:$CANON_P32_LENGTH_SORT" in
  4:0:0:0|4:stream:0:0|4:stream:1:0|4:stream:1:1) ;;
  1:0:0:0|1:stream:0:0|1:stream:0:1) ;;
  *)
    echo "[profile] FrozenLake four-chip optimization arm is not registered" >&2
    return 1 2>/dev/null || exit 1
    ;;
esac

export CANON_FROZENLAKE_CKPT_MODE=disabled
unset CANON_FROZENLAKE_CKPT_ROOT CANON_FROZENLAKE_CKPT_TAG
unset CANON_FROZENLAKE_CKPT_INTERVAL CANON_FROZENLAKE_CKPT_MAX_TO_KEEP
unset CANON_FROZENLAKE_CKPT_MILESTONE_INTERVAL
export ENABLE_PATHWAYS_PERSISTENCE=0

if [ "${CANON_P33_RUN_STAGE:-}" != "backward-no-commit" ] || \
   [ "${CANON_P33_NO_COMMIT:-}" != "1" ] || \
   [ "${CANON_P32_TRAIN_ADMITTED:-}" != "1" ] || \
   [ "${CANON_P32_DP_REDUCTION_ADMITTED:-}" != "1" ] || \
   [ "${CANON_P33_WORKLOAD_LAUNCH_ADMITTED:-}" != "1" ] || \
   [ "${CANON_DP_SIZE:-}" != "$_CANON_FL4_DP" ] || \
   [ "${CANON_TP_SIZE:-}" != "$_CANON_FL4_TP" ] || \
   [ "${CANON_TOTAL_DEVICES:-}" != "4" ]; then
  echo "[profile] FrozenLake four-chip carrier requires exact no-commit admission" >&2
  return 1 2>/dev/null || exit 1
fi
