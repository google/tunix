# FrozenLake exact-TiTO rollout-only evidence carrier.
# It constructs production DP8xTP8 serving geometry but executes no backward
# pass and no optimizer commit.

export CANON_P32_TRAIN_ADMITTED=1
export CANON_P32_DP_REDUCTION_ADMITTED=1
export CANON_P33_WORKLOAD_LAUNCH_ADMITTED=1
export CANON_P33_NO_COMMIT=1
export CANON_P33_RUN_STAGE=rollout-only
export CANON_P33_ENABLE_EVAL=0

_CANON_P57_TITO_PROFILE_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
# shellcheck disable=SC1091
source "$_CANON_P57_TITO_PROFILE_DIR/qwen3-8b-dp16-tp4-frozenlake.env"
unset _CANON_P57_TITO_PROFILE_DIR

export CANON_PROFILE=qwen3-8b-dp8-tp8-frozenlake-tito-diagnostic
export CANON_P32_WORKLOAD=frozenlake-dp8-tp8
export CANON_MODEL_DIR_NAME=qwen8b_tp8
export CANON_QWEN3_TP_SIZE=8
export CANON_DP_SIZE=8
export CANON_TP_SIZE=8
export CANON_TOTAL_DEVICES=64
export CANON_ENGINE_DP_SIZE=8
export CANON_GLOBAL_PROMPTS=32
export CANON_LOCAL_PROMPTS=4
export CANON_NUM_GENERATIONS=8
export CANON_LOCAL_TRAJECTORIES=32
export CANON_GLOBAL_TRAJECTORIES=256
export CANON_DP_PROBE_LOCAL_SAMPLES=32
export CANON_LOGPROB_M=256
export CANON_TARGET_M=256
export CANON_MAX_BATCHED=256
export MIN_TOKEN_BUCKET=2048
export FL_SHARED_MESH=8,8

export CANON_P57_RUN_KIND=tito-diagnostic
export CANON_P57_TIM_ARM=zero
export CANON_P57_EXPECTED_UPDATES=1
export CANON_P57_STOP_AFTER_STEP=1
export CANON_P57_TITO_ROLLOUT_ONLY=1
export CANON_P57_TOKEN_CONTINUITY=exact
export CANON_P57_TOKEN_CONTINUITY_DEBUG=collect-64
export CANON_P57_TITO_RUNNER_WITNESS_DIR="${CANON_STATE}/p57_tito_witness/runner"
_canon_p57_tito_job_name="${CANON_STATE##*/}"
_canon_p57_tito_attempt="${JOBSET_RESTART_ATTEMPT:-direct}"
if [[ ! "$_canon_p57_tito_attempt" =~ ^(direct|[0-9]+)$ ]]; then
  echo "[profile] TiTO diagnostic restart attempt is invalid" >&2
  return 1 2>/dev/null || exit 1
fi
export CANON_P57_TITO_GCS_PREFIX="gs://yuxzhang-tunix-models/canon-zero-tim/evidence/p57-tito/${_canon_p57_tito_job_name}/attempt-${_canon_p57_tito_attempt}"
export CANON_P57_TITO_GCS_INTERVAL_SECONDS=30
export CANON_P57_TITO_GCS_READY="${CANON_STATE}/p57_tito_gcs/ready"
export CANON_P57_TITO_GCS_STOP_FILE="${CANON_STATE}/p57_tito_gcs/stop"
export CANON_P57_TITO_GCS_FINALIZE_FILE="${CANON_STATE}/p57_tito_gcs/finalize"
export CANON_P57_TITO_GCS_FINAL_ACK="${CANON_STATE}/p57_tito_gcs/finalize.ack"
export CANON_P57_TITO_GCS_HEARTBEAT="${CANON_STATE}/p57_tito_gcs/heartbeat"
export CANON_P57_TITO_GCS_WORKER_LOG="${CANON_STATE}/p57_tito_gcs/worker.log"
unset _canon_p57_tito_job_name
unset _canon_p57_tito_attempt
export CANON_FROZENLAKE_CKPT_MODE=disabled
unset CANON_FROZENLAKE_CKPT_ROOT CANON_FROZENLAKE_CKPT_TAG
unset CANON_FROZENLAKE_CKPT_INTERVAL CANON_FROZENLAKE_CKPT_MAX_TO_KEEP
unset CANON_FROZENLAKE_CKPT_MILESTONE_INTERVAL
export CANON_FROZENLAKE_ALIGNMENT_WARN_ONLY=0
export CANON_VLLM_ENABLE_PREFIX_CACHING=0
export CANON_V1_HP_FULL=0

# Match the optimized serving half. Backward-only P59/P66 selectors stay off.
export CANON_CONTINUE_DECODE=8
export CANON_FIXED_AR_GATHER=1
export CANON_PALLAS_GATHERED_LOGPROBS=1
export CANON_LOGPROB_STEP_FUSION=1
export CANON_P38_FIXED_LM_HEAD=1
export CANON_P59_RANK_PARALLEL_BACKWARD=0
export CANON_P59_CHECKED_VMA=0
export CANON_P67_P66_VMA_P59_ONLY=0
export CANON_P28_BATCHED_REPORT=1
export CANON_P28_BATCHED_REVERSE=0
export CANON_BATCHED_EVIDENCE=0
export CANON_FUSED_TREE_OPS=0

export CANON_WANDB_PROJECT=zero-tim-frozenlake-dp8-tp8-resident
export CANON_WANDB_GROUP=qwen3-8b-dp8-tp8-tito-diagnostic
export CANON_WANDB_RUN_NAME="${CANON_WANDB_RUN_NAME:-p57-tito-diagnostic-${JOBSET_RESTART_ATTEMPT:-unknown}}"

case "${CANON_P57_WORKLOAD_CANDIDATE:-}:${CANON_P57_DATA_SPLIT:-}" in
  :)
    _canon_p57_tito_response=2048
    _canon_p57_tito_turns=5
    ;;
  m15:main)
    _canon_p57_tito_response=8192
    _canon_p57_tito_turns=15
    ;;
  *)
    echo "[profile] TiTO diagnostic admits only P45 or M15/main" >&2
    return 1 2>/dev/null || exit 1
    ;;
esac

for _canon_p57_tito_arg in \
  "python3 -u -m examples.frozenlake.train_frozenlake_qwen3" \
  "--mesh_dp=8" \
  "--mesh_tp=8" \
  "--max_steps=1" \
  "--seed=42" \
  "--num_generations=8" \
  "--temperature=0.7" \
  "--max_prompt_length=4096" \
  "--max_response_length=${_canon_p57_tito_response}" \
  "--env_max_steps=${_canon_p57_tito_turns}" \
  "--num_test_batches=1" \
  "--eval_every_n_steps=0" \
  "--sampler_is=none" \
  "--evaluation_only"; do
  case " ${CANON_RUN_CMD:-} " in
    *" ${_canon_p57_tito_arg} "*) ;;
    *)
      echo "[profile] TiTO diagnostic command lacks ${_canon_p57_tito_arg}" >&2
      return 1 2>/dev/null || exit 1
      ;;
  esac
done
if [ -n "${CANON_P57_WORKLOAD_CANDIDATE:-}" ]; then
  for _canon_p57_tito_arg in \
    "--p57_workload_candidate=m15" \
    "--p57_data_split=main"; do
    case " ${CANON_RUN_CMD:-} " in
      *" ${_canon_p57_tito_arg} "*) ;;
      *)
        echo "[profile] M15 TiTO diagnostic command drifted" >&2
        return 1 2>/dev/null || exit 1
        ;;
    esac
  done
fi
unset _canon_p57_tito_arg
unset _canon_p57_tito_response
unset _canon_p57_tito_turns
