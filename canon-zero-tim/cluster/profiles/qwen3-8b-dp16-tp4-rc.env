# P32 real-checkpoint release-candidate profile. Production training remains refused.

_CANON_PROFILE_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
# shellcheck disable=SC1091
source "$_CANON_PROFILE_DIR/qwen3-8b-dp16-tp4-admission.env"
unset _CANON_PROFILE_DIR

export CANON_PROFILE=qwen3-8b-dp16-tp4-rc
export CANON_P32_RC=1
export CANON_P32_RC_STAGE="${CANON_P32_RC_STAGE:-checkpoint-forward}"
export CANON_P32_CHECKPOINT_DIR="${CANON_P32_CHECKPOINT_DIR:-/tmp/models/Qwen3-8B}"
export CANON_P32_OPTIMIZER_MEMORY_KIND=pinned_host

# Non-secret identity is recorded even though the RC does not initialize W&B.
export CANON_WANDB_PROJECT=canon-zero-tim-p32
export CANON_WANDB_GROUP=qwen3-8b-dp16-tp4-rc
export CANON_WANDB_RUN_NAME="p32-rc-${CANON_P32_RC_STAGE}-attempt-0"
