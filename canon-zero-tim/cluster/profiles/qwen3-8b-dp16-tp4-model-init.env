# P32 model-init-only profile. This sources the bounded admission contract and
# enables exactly one additional stage: structural state materialization.

_CANON_PROFILE_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
# shellcheck disable=SC1091
source "$_CANON_PROFILE_DIR/qwen3-8b-dp16-tp4-admission.env"
unset _CANON_PROFILE_DIR

export CANON_PROFILE=qwen3-8b-dp16-tp4-model-init
export CANON_P32_MODEL_INIT_ONLY=1
export CANON_P32_MODEL_STATE_KIND=zero-structural
export CANON_P32_OPTIMIZER_MEMORY_KIND=pinned_host

# Non-secret W&B identity is admitted, but this gate never opens a network run.
export CANON_WANDB_PROJECT=canon-zero-tim-p32
export CANON_WANDB_GROUP=qwen3-8b-dp16-tp4-model-init
export CANON_WANDB_RUN_NAME=p32-model-init-attempt-0
