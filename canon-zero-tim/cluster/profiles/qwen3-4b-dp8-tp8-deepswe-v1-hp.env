# P58 high-performance Qwen3-4B DeepSWE convergence profile.
# The renderer is the only production entrypoint. It pins the existing P58
# scientific recipe, then adds the target-only performance and trace bundle.

_CANON_P58_HP_PROFILE_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
# shellcheck disable=SC1091
source "$_CANON_P58_HP_PROFILE_DIR/qwen3-4b-dp8-tp8-deepswe-tim.env"
unset _CANON_P58_HP_PROFILE_DIR

export CANON_PROFILE=qwen3-4b-dp8-tp8-deepswe-v1-hp
export CANON_P38_FIXED_LM_HEAD=1
export CANON_CONTINUE_DECODE=8
export CANON_FIXED_AR_GATHER=1
export CANON_PALLAS_GATHERED_LOGPROBS=1
export CANON_LOGPROB_STEP_FUSION=1
export CANON_VLLM_ENABLE_PREFIX_CACHING=0
export CANON_P59_RANK_PARALLEL_BACKWARD=1
case "${CANON_P58_CHECKED_VMA_DIAGNOSTIC:-}" in
  "")
    export CANON_P59_CHECKED_VMA=1
    unset CANON_P66_P59_CHECK_VMA
    # FrozenLake Wave 5 proved that the process-wide P66 compatibility alias
    # can perturb ordinary serving even though checked VMA is owned by P59
    # backward. Preserve the historical serving graph and expose VMA metadata
    # only inside the exact outer manual data/model P59 pullback.
    export CANON_P67_P66_VMA_P59_ONLY=1
    export CANON_V1_HP_FIRST_UPDATE_GATE=1
    export CANON_P63_OVERFLOW_SAFE_CLIP=1
    ;;
  off)
    # P58.17 exact-geometry discriminator.  This one selector derives every
    # subordinate value and forces a durable stop after Step-0 pre-alignment.
    # It never admits backward or an optimizer commit.
    export CANON_P59_CHECKED_VMA=0
    export CANON_P66_P59_CHECK_VMA=0
    export CANON_P67_P66_VMA_P59_ONLY=0
    export CANON_V1_HP_FIRST_UPDATE_GATE=0
    export CANON_P63_OVERFLOW_SAFE_CLIP=0
    ;;
  on)
    # Matched ABA control.  Preserve the production checked-VMA/P67 serving
    # treatment while retaining the same pre-backward, zero-commit carrier as
    # the off arm.  First-update and clip are inert and held at zero because
    # this diagnostic must never enter backward.
    export CANON_P59_CHECKED_VMA=1
    export CANON_P66_P59_CHECK_VMA=1
    export CANON_P67_P66_VMA_P59_ONLY=1
    export CANON_V1_HP_FIRST_UPDATE_GATE=0
    export CANON_P63_OVERFLOW_SAFE_CLIP=0
    ;;
  *)
    echo "[profile] CANON_P58_CHECKED_VMA_DIAGNOSTIC must be absent, off, or on" >&2
    return 1 2>/dev/null || exit 1
    ;;
esac
# P59 owns the report-adjoint and DP pullback path. Keep the common V1
# selector at 1 for bundle identity; DeepSWE's P59 path does not execute the
# serial P28 batched-report implementation.
export CANON_P28_BATCHED_REPORT=1
export CANON_P28_BATCHED_REVERSE=0
export CANON_BATCHED_EVIDENCE=0
export CANON_FUSED_TREE_OPS=0
export CANON_PALLAS_NORM_MATMUL=0
export CANON_PALLAS_INPUT_FUSION=0
export CANON_SAMPLE_SPLIT_FUSION=0
export CANON_ENGINE_LOGPROB_READBACK=0
export CANON_ANCHOR_OVERLAP=0
# A 1,000-update P58 campaign is a training carrier, not a profiling carrier.
# K29 proved that making XProf implicit can kill a healthy Step-1 batch before
# backward when Pathways rejects a head-local path.  Keep production full
# training profiler-free and use the separately admitted one-host/P59 XProf
# launchers when a trace is actually requested.  Unset rather than export 0:
# CANON_XPROF_DIR is presence/value-sensitive and any non-empty value arms the
# learner's update-entry hook.
unset CANON_XPROF_DIR
unset CANON_XPROF_SKIP_STEPS
unset CANON_XPROF_STEPS
unset CANON_XPROF_PHASE
unset CANON_XPROF_PYTHON_TRACER
unset CANON_XPROF_HOST_TRACER
unset CANON_XPROF_TPU_TRACE_MODE
unset CANON_XPROF_LABELS
unset CANON_PERF_TRACE_DIR
unset CANON_PERF_TRACE_EXPORT_STEP

_CANON_P58_HP_EXPECTED_ALIGNMENT_WARNING=1
if [ "${CANON_P38_PRECHECK_ONLY:-0}" = "1" ]; then
  _CANON_P58_HP_EXPECTED_ALIGNMENT_WARNING=0
fi

if [ "${CANON_V1_HP_FULL:-0}" != "1" ] || \
   [ "${CANON_P58_DEEPSWE_TIM:-0}" != "1" ] || \
   [ "${CANON_P58_TIM_ADMITTED:-0}" != "1" ] || \
   [ "${CANON_P58_TIM_ARM:-}" != "zero" ] || \
   [ "${CANON_P34_RUN_STAGE:-}" != "full" ] || \
   [ "${CANON_P34_NO_COMMIT:-}" != "0" ] || \
   [ "${CANON_P58_EXPECTED_UPDATES:-}" != "1000" ] || \
   [ "${CANON_DEEPSWE_ALIGNMENT_WARN_ONLY:-}" != \
     "${_CANON_P58_HP_EXPECTED_ALIGNMENT_WARNING}" ] || \
   [ "${CANON_P38_FIXED_LM_HEAD:-}" != "1" ] || \
   [ "${CANON_OPT_STATE_RESIDENT:-}" != "1" ] || \
   [ "${CANON_P30_OPT_STATE_OFFLOAD:-}" != "0" ]; then
  echo "[profile] P58 v1-hp requires committed 1000-update Zero training with narrow A-B warnings, fixed head, and resident optimizer" >&2
  return 1 2>/dev/null || exit 1
fi
unset _CANON_P58_HP_EXPECTED_ALIGNMENT_WARNING

if [ -n "${CANON_P58_CHECKED_VMA_DIAGNOSTIC:-}" ] && \
   [ -n "${CANON_P58_SEAM_LOCALIZATION:-}" ]; then
  echo "[profile] P58 checked-VMA and seam diagnostics are mutually exclusive" >&2
  return 1 2>/dev/null || exit 1
fi

if [ -n "${CANON_P58_CHECKED_VMA_DIAGNOSTIC:-}" ]; then
  if [ "${CANON_P38_PRECHECK_ONLY:-0}" != "1" ] || \
     [ "${CANON_P38_CONTROLLED_EXIT:-0}" != "1" ] || \
     [ "${CANON_P38_DIAGNOSTIC_ROUNDS:-0}" != "1" ] || \
     [ -z "${CANON_P38_DIAGNOSTIC_ROUND_FILE:-}" ]; then
    echo "[profile] P58 checked-VMA diagnostic requires one controlled precheck round" >&2
    return 1 2>/dev/null || exit 1
  fi
  echo "[P58.VMA.DIAGNOSTIC] profile_resolved selector=${CANON_P58_CHECKED_VMA_DIAGNOSTIC} dp=8 tp=8 checked_vma=${CANON_P59_CHECKED_VMA} compatibility_alias=${CANON_P66_P59_CHECK_VMA} vma_p59_only=${CANON_P67_P66_VMA_P59_ONLY} fixed_ar_gather=1 continue_decode=8 prefix_cache=0 backward=0 optimizer_commits=0"
fi

case "${CANON_P58_SEAM_LOCALIZATION:-}" in
  "") ;;
  coarse)
    if [ "${CANON_P38_PRECHECK_ONLY:-0}" != "1" ] || \
       [ "${CANON_P38_CONTROLLED_EXIT:-0}" != "1" ] || \
       [ "${CANON_P38_DIAGNOSTIC_ROUNDS:-0}" != "3" ] || \
       [ "${CANON_P38_DURABILITY_PROFILE:-}" != "p58-seam-v1" ] || \
       [ "${CANON_P38_SEAM_OBSERVER:-}" != "layer" ] || \
       [ "${CANON_P38_TAIL_OBSERVER:-0}" != "1" ] || \
       [ -z "${CANON_P38_DIAGNOSTIC_ROUND_FILE:-}" ] || \
       [ -z "${CANON_P38_SEAM_OBSERVER_DIR:-}" ] || \
       [ -z "${CANON_P38_SEAM_CLASSIFICATION:-}" ]; then
      echo "[profile] P58 coarse seam localization requires the complete three-round observer tuple" >&2
      return 1 2>/dev/null || exit 1
    fi
    echo "[P58.SEAM] profile_resolved mode=coarse rounds=3 dp=8 tp=8 checked_vma=${CANON_P59_CHECKED_VMA} fixed_head=1 continue_decode=8 prefix_cache=0 backward=0 optimizer_commits=0"
    ;;
  *)
    echo "[profile] CANON_P58_SEAM_LOCALIZATION must be absent or coarse" >&2
    return 1 2>/dev/null || exit 1
    ;;
esac

for _canon_p58_hp_name in \
  CANON_CONTINUE_DECODE \
  CANON_FIXED_AR_GATHER \
  CANON_PALLAS_GATHERED_LOGPROBS \
  CANON_LOGPROB_STEP_FUSION \
  CANON_P59_RANK_PARALLEL_BACKWARD \
  CANON_P28_BATCHED_REPORT \
  CANON_P38_FIXED_LM_HEAD; do
  _canon_p58_hp_value="${!_canon_p58_hp_name}"
  case "$_canon_p58_hp_name:$_canon_p58_hp_value" in
    CANON_CONTINUE_DECODE:8|*:1) ;;
    *)
      echo "[profile] P58 v1-hp bundle drifted at $_canon_p58_hp_name" >&2
      return 1 2>/dev/null || exit 1
      ;;
  esac
done
unset _canon_p58_hp_name
unset _canon_p58_hp_value

case "${CANON_P58_CHECKED_VMA_DIAGNOSTIC:-}" in
  "")
    [ "${CANON_P59_CHECKED_VMA:-0}:${CANON_P67_P66_VMA_P59_ONLY:-0}:${CANON_V1_HP_FIRST_UPDATE_GATE:-0}:${CANON_P63_OVERFLOW_SAFE_CLIP:-0}" = \
      "1:1:1:1" ] || {
      echo "[profile] P58 production checked-VMA bundle drifted" >&2
      return 1 2>/dev/null || exit 1
    }
    ;;
  off)
    [ "${CANON_P59_CHECKED_VMA:-1}:${CANON_P66_P59_CHECK_VMA:-1}:${CANON_P67_P66_VMA_P59_ONLY:-1}:${CANON_V1_HP_FIRST_UPDATE_GATE:-1}:${CANON_P63_OVERFLOW_SAFE_CLIP:-1}" = \
      "0:0:0:0:0" ] || {
      echo "[profile] P58 checked-VMA-off diagnostic bundle drifted" >&2
      return 1 2>/dev/null || exit 1
    }
    ;;
  on)
    [ "${CANON_P59_CHECKED_VMA:-0}:${CANON_P66_P59_CHECK_VMA:-0}:${CANON_P67_P66_VMA_P59_ONLY:-0}:${CANON_V1_HP_FIRST_UPDATE_GATE:-1}:${CANON_P63_OVERFLOW_SAFE_CLIP:-1}" = \
      "1:1:1:0:0" ] || {
      echo "[profile] P58 checked-VMA-on diagnostic bundle drifted" >&2
      return 1 2>/dev/null || exit 1
    }
    ;;
esac
