# Qwen3-8B FrozenLake DP4xTP1 one-host backward carrier.
# Capacity rejection is an admitted result; the 90% HBM gate is not relaxed.

_CANON_FL4_PROFILE_REL=cluster/profiles/qwen3-8b-dp4-tp1-frozenlake-onehost.env
_CANON_FL4_DP=4
_CANON_FL4_TP=1
_CANON_FL4_MODEL_DIR=qwen8b_tp1
_CANON_FL4_CHECK_VMA=0
_CANON_FL4_MESH_IDS=0,2,1,3
_CANON_FL4_P45_HBM=0.65
_CANON_FL4_M15_HBM=0.66
_CANON_FL4_WRAPPER_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
# shellcheck disable=SC1091
source "$_CANON_FL4_WRAPPER_DIR/_qwen3-8b-frozenlake-four-chip-onehost.env"
unset _CANON_FL4_WRAPPER_DIR
unset _CANON_FL4_PROFILE_REL _CANON_FL4_DP _CANON_FL4_TP
unset _CANON_FL4_MODEL_DIR _CANON_FL4_CHECK_VMA
unset _CANON_FL4_MESH_IDS
unset _CANON_FL4_P45_HBM _CANON_FL4_M15_HBM
