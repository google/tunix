# P58 Qwen3-4B 64-chip split-role system-optimization admission profile.
#
# The two roles each own DP4xTP8.  Control admits the common DeepSWE tuple;
# treatment adds the already-implemented streamed tape and reduce-once knives.
# Control remains a three-update arm. Treatment may also select the explicit
# full candidate; neither changes a default recipe.

case "${CANON_DEEPSWE_SYSTEM_OPTIMIZATION_ARM:-}" in
  control|treatment) ;;
  *)
    echo "[profile] P58 64split systemopt arm must be control or treatment" >&2
    return 1 2>/dev/null || exit 1
    ;;
esac

if [ "${CANON_P58_TOPOLOGY:-}" != "64split" ] || \
   [ "${CANON_P58_TIM_ARM:-}" != "zero" ] || \
   [ "${CANON_P34_NO_COMMIT:-}" != "0" ]; then
  echo "[profile] P58 64split systemopt requires committed Zero training" >&2
  return 1 2>/dev/null || exit 1
fi
case "${CANON_DEEPSWE_SYSTEM_OPTIMIZATION_ARM}:${CANON_P34_RUN_STAGE:-}:${CANON_P58_EXPECTED_UPDATES:-}" in
  control:three-update:3|treatment:three-update:3|treatment:full:1000) ;;
  *)
    echo "[profile] P58 64split systemopt stage/arm horizon drifted" >&2
    return 1 2>/dev/null || exit 1
    ;;
esac

_CANON_P58_SYSTEMOPT_PROFILE_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
# shellcheck disable=SC1091
source "$_CANON_P58_SYSTEMOPT_PROFILE_DIR/qwen3-4b-dp4-tp8-deepswe-tim-split.env"
unset _CANON_P58_SYSTEMOPT_PROFILE_DIR

if [ "${CANON_DEEPSWE_ALIGNMENT_WARN_ONLY:-}" != "0" ] || \
   [ "${CANON_P38_FIXED_LM_HEAD:-}" != "1" ] || \
   [ "${CANON_P59_RANK_PARALLEL_BACKWARD:-}" != "1" ] || \
   [ "${CANON_P59_CHECKED_VMA:-}" != "1" ] || \
   [ "${CANON_P67_P66_VMA_P59_ONLY:-}" != "1" ] || \
   [ "${CANON_V1_HP_FIRST_UPDATE_GATE:-}" != "1" ] || \
   [ "${CANON_DP_COMPARE_MODE:-}" != "fingerprint-hybrid" ] || \
   [ "${CANON_DP_DISTINCT_SCHEDULE:-}" != "first-group-warmup" ] || \
   [ "${CANON_DP_FINITE_FETCH:-}" != "batched-commit" ] || \
   [ "${CANON_P71_SCAN:-}" != "fwd" ] || \
   [ "${CANON_V1_HP_FULL:-0}" != "0" ]; then
  echo "[profile] P58 64split systemopt common tuple drifted" >&2
  return 1 2>/dev/null || exit 1
fi

if [[ -v CANON_DP_COLLECTIVE_REDUCE ]] || \
   [[ -v CANON_P63_OVERFLOW_SAFE_CLIP ]]; then
  echo "[profile] P58 64split systemopt inherited an unadmitted selector" >&2
  return 1 2>/dev/null || exit 1
fi

case "$CANON_DEEPSWE_SYSTEM_OPTIMIZATION_ARM" in
  control)
    if [[ -v CANON_P32_KEEP_TAPE ]] || \
       [[ -v CANON_DP_REDUCE_ONCE ]] || \
       [[ -v CANON_P32_LENGTH_SORT ]]; then
      echo "[profile] P58 64split control leaked treatment selectors" >&2
      return 1 2>/dev/null || exit 1
    fi
    ;;
  treatment)
    if [ "${CANON_P32_KEEP_TAPE:-}" != "stream" ] || \
       [ "${CANON_DP_REDUCE_ONCE:-}" != "1" ] || \
       [ "${CANON_P32_LENGTH_SORT:-}" != "1" ]; then
      echo "[profile] P58 64split treatment requires stream, reduce-once and length-sort" >&2
      return 1 2>/dev/null || exit 1
    fi
    ;;
esac

export CANON_PROFILE=qwen3-4b-dp4-tp8-deepswe-tim-systemopt
