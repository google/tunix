# Qwen3-32B DeepSWE bounded pilot: one 4x4x4 slice split into two
# host-complete 32-device roles, each DP4xTP8.

_CANON_PROFILE_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
# shellcheck disable=SC1091
source "$_CANON_PROFILE_DIR/qwen3-32b-dp16-tp8-deepswe.env"
unset _CANON_PROFILE_DIR

export CANON_PROFILE=qwen3-32b-dp4-tp8-deepswe-pilot
export CANON_P39_64CHIP_PILOT=1
export CANON_P39_PILOT_ADMITTED=1

export CANON_DP_SIZE=4
export CANON_TP_SIZE=8
export CANON_TOTAL_DEVICES=32
export CANON_ENGINE_DP_SIZE=4
export CANON_GLOBAL_PROMPTS=8
export CANON_NUM_GENERATIONS=8
export CANON_LOCAL_TRAJECTORIES=16
export CANON_GLOBAL_TRAJECTORIES=64
export CANON_TARGET_M=256
export CANON_LOGPROB_M=256
export MIN_TOKEN_BUCKET=1024
export CANON_P34_ABCPROD=256
export CANON_EXPECTED_SLICE_DEVICES=64
export FL_SHARED_MESH=4,8

export CANON_P34_PREFIX_CACHE=0
export CANON_P34_MAX_NUM_SEQS=16
export CANON_P34_MAX_BATCHED_TOKENS=256

# The pilot's primary question is whether the Qwen3-32B optimizer can remain
# resident on the trainer's TP8 device mesh with a measured HBM reserve.
export CANON_OPT_STATE_RESIDENT=1
export CANON_P30_OPT_STATE_OFFLOAD=0
export CANON_DEEPSWE_ALIGNMENT_WARN_ONLY=1

export CANON_WANDB_PROJECT=zero-tim-deepswe-dp4-tp8-pilot
export CANON_WANDB_GROUP=qwen3-32b-dp4-tp8-resident
export CANON_WANDB_RUN_NAME="${CANON_WANDB_RUN_NAME:-p39-deepswe-pilot-${CANON_P34_RUN_STAGE}-${CANON_RUN_ID:-unset}}"
