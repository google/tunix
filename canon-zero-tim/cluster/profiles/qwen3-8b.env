# Profile: Qwen3-8B.  Geometry as used by the live FrozenLake P31 invocation.
#
# Model geometry travels as environment, not as config file, because the canonical engine
# module is built from it directly.  A mismatch here does not raise -- it silently builds a
# different model, so treat these as part of the contract.

export CANON_PROFILE=qwen3-8b
export CANON_MODEL_DIR_NAME=qwen8b             # selects src/engine_shims/models/<dir>

export CANON_QWEN3_HIDDEN_SIZE=4096
export CANON_QWEN3_INTERMEDIATE_SIZE=12288
export CANON_QWEN3_NUM_ATTENTION_HEADS=32
export CANON_QWEN3_NUM_KV_HEADS=8
export CANON_QWEN3_HEAD_DIM=128
export CANON_QWEN3_TP_SIZE=4
