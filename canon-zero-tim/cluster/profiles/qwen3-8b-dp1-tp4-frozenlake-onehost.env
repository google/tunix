# Qwen3-8B FrozenLake DP1xTP4 one-host backward carrier.
# DP reduce-once is structurally N/A and rejected; checked-VMA stays mandatory.

_CANON_FL4_PROFILE_REL=cluster/profiles/qwen3-8b-dp1-tp4-frozenlake-onehost.env
_CANON_FL4_DP=1
_CANON_FL4_TP=4
_CANON_FL4_MODEL_DIR=qwen8b
_CANON_FL4_CHECK_VMA=1
_CANON_FL4_MESH_IDS=0,2,1,3
# The existing Qwen3-8B DP1xTP4 M15/token-continuity vehicles use 0.56.
_CANON_FL4_P45_HBM=0.56
_CANON_FL4_M15_HBM=0.56
_CANON_FL4_WRAPPER_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
# shellcheck disable=SC1091
source "$_CANON_FL4_WRAPPER_DIR/_qwen3-8b-frozenlake-four-chip-onehost.env"
unset _CANON_FL4_WRAPPER_DIR
unset _CANON_FL4_PROFILE_REL _CANON_FL4_DP _CANON_FL4_TP
unset _CANON_FL4_MODEL_DIR _CANON_FL4_CHECK_VMA
unset _CANON_FL4_MESH_IDS
unset _CANON_FL4_P45_HBM _CANON_FL4_M15_HBM
