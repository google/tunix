# V1 high-performance strict Zero-TIM FrozenLake full-train profile.
# It preserves the P57 P45/M15 scientific contracts while enabling the
# registered performance bundle. APC remains admitted for P45; the M15/main
# target red reverts APC for that exact workload while keeping strict Zero-TIM.

_CANON_V1_HP_PROFILE_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
# shellcheck disable=SC1091
source "$_CANON_V1_HP_PROFILE_DIR/qwen3-8b-dp8-tp8-frozenlake-tim.env"
unset _CANON_V1_HP_PROFILE_DIR

export CANON_PROFILE=qwen3-8b-dp8-tp8-frozenlake-v1-hp
export CANON_CONTINUE_DECODE=8
export CANON_FIXED_AR_GATHER=1
export CANON_PALLAS_GATHERED_LOGPROBS=1
export CANON_LOGPROB_STEP_FUSION=1
case "${CANON_P57_WORKLOAD_CANDIDATE:-}:${CANON_P57_DATA_SPLIT:-}" in
  ":"|"m15:main") export CANON_VLLM_ENABLE_PREFIX_CACHING=0 ;;
  *)
    echo "[profile] FrozenLake v1-hp supports only P45 readiness or m15:main" >&2
    return 1 2>/dev/null || exit 1
    ;;
esac
export CANON_P59_RANK_PARALLEL_BACKWARD=1
export CANON_P63_OVERFLOW_SAFE_CLIP=1
export CANON_P28_BATCHED_REPORT=1
export CANON_P28_BATCHED_REVERSE=0
export CANON_BATCHED_EVIDENCE=0
export CANON_FUSED_TREE_OPS=0
export CANON_XPROF_DIR="${CANON_STATE}/xprof-update"
export CANON_XPROF_SKIP_STEPS=2
export CANON_XPROF_STEPS=1
export CANON_XPROF_PHASE=update
export CANON_XPROF_PYTHON_TRACER=0
export CANON_XPROF_HOST_TRACER=1
export CANON_XPROF_TPU_TRACE_MODE=TRACE_COMPUTE
export CANON_XPROF_LABELS=1
export CANON_PERF_TRACE_DIR="${CANON_STATE}/perfetto"
export CANON_PERF_TRACE_EXPORT_STEP=2

if [ "${CANON_V1_HP_FULL:-0}" != "1" ] || \
   [ "${CANON_P32_WORKLOAD:-}" != "frozenlake-dp8-tp8" ] || \
   [ "${CANON_P57_RUN_KIND:-}" != "train" ] || \
   [ "${CANON_P57_TIM_ARM:-}" != "zero" ] || \
   [ "${CANON_P57_EXPECTED_UPDATES:-}" != "300" ] || \
   [ "${CANON_P33_RUN_STAGE:-}" != "full" ] || \
   [ "${CANON_P33_NO_COMMIT:-}" != "0" ] || \
   [ "${CANON_P33_ENABLE_EVAL:-}" != "1" ] || \
   [ "${CANON_P33_DISABLE_EVAL:-}" != "0" ] || \
   [ "${CANON_P31_ENABLE_EVAL:-}" != "1" ] || \
   [ "${CANON_FROZENLAKE_ALIGNMENT_WARN_ONLY:-}" != "0" ] || \
   [ "${CANON_P38_FIXED_LM_HEAD:-}" != "1" ] || \
   [ "${CANON_OPT_STATE_RESIDENT:-}" != "1" ] || \
   [ "${CANON_P30_OPT_STATE_OFFLOAD:-}" != "0" ]; then
  echo "[profile] FrozenLake v1-hp requires a strict 300-update zero arm with rollout-only evaluation, fixed head, and resident optimizer" >&2
  return 1 2>/dev/null || exit 1
fi

for _canon_v1_hp_name in \
  CANON_CONTINUE_DECODE \
  CANON_FIXED_AR_GATHER \
  CANON_PALLAS_GATHERED_LOGPROBS \
  CANON_LOGPROB_STEP_FUSION \
  CANON_VLLM_ENABLE_PREFIX_CACHING \
  CANON_P59_RANK_PARALLEL_BACKWARD \
  CANON_P63_OVERFLOW_SAFE_CLIP \
  CANON_P28_BATCHED_REPORT \
  CANON_XPROF_LABELS; do
  _canon_v1_hp_value="${!_canon_v1_hp_name}"
  case "$_canon_v1_hp_name:$_canon_v1_hp_value" in
    CANON_VLLM_ENABLE_PREFIX_CACHING:0) ;;
    CANON_CONTINUE_DECODE:8|*:1) ;;
    *)
      echo "[profile] FrozenLake v1-hp performance bundle drifted at $_canon_v1_hp_name" >&2
      return 1 2>/dev/null || exit 1
      ;;
  esac
done
unset _canon_v1_hp_name
unset _canon_v1_hp_value
