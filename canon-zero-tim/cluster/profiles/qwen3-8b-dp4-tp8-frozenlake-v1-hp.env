# Explicit 32-chip/B128 variant. Shared code retains the complete HP bundle;
# the geometry helper rejects absent/malformed/mixed selectors before loading.
_P57_SMALL_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
source "$_P57_SMALL_DIR/../steps/p57_training_geometry.sh"
p57_training_geometry_init || return 1
source "$_P57_SMALL_DIR/qwen3-8b-dp8-tp8-frozenlake-v1-hp.env" || return 1
# Reject duplicate/contradictory CLI values before connecting to Pathways.
read -r -a _p57_small_command <<< "${CANON_RUN_CMD:-}"
for _p57_small_arg in --mesh_dp=4 --mesh_tp=8 --batch_size=16 \
    --mini_batch_size=16 --train_trajectory_micro_batch_size=4 \
    --num_generations=8 --max_concurrency=128 --vllm_max_num_seqs=32 \
    --vllm_max_num_batched_tokens=256; do
  _p57_small_count=0
  for _p57_small_actual in "${_p57_small_command[@]}"; do
    if [[ "$_p57_small_actual" == "${_p57_small_arg%%=*}="* ]]; then
      if [[ "$_p57_small_actual" != "$_p57_small_arg" ]]; then
        echo "[P57.GEOMETRY] FATAL: command geometry contradicts $_p57_small_arg" >&2
        return 1
      fi
      _p57_small_count=$((_p57_small_count + 1))
    fi
  done
  if [[ "$_p57_small_count" != 1 ]]; then
    echo "[P57.GEOMETRY] FATAL: command requires exactly one $_p57_small_arg" >&2
    return 1
  fi
done
unset _p57_small_command _p57_small_arg _p57_small_actual _p57_small_count
export CANON_WANDB_GROUP="${CANON_WANDB_GROUP}-dp4-b128"
unset _P57_SMALL_DIR
