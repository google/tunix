+#   CANON_ENGINE_STEP_LOG_SYNC_EVERY     perf receipt v2 (tasks/deepswe_4b_perf): every K-th
+#                                        step blocks on the dispatched model output and records
+#                                        dev_model_ms, so device time separates from host and
+#                                        controller time; 0 = never.  Diagnostic only.
+_ENGINE_STEP_LOG_SYNC_EVERY = int(
+    os.environ.get("CANON_ENGINE_STEP_LOG_SYNC_EVERY", "0") or "0")
+
+
+def _engine_step_launch(runner, name, t_start):
+    """Adds one named launch's host wall (dispatch only) to the open receipt."""
+    rec = getattr(runner, "_perf3_step_rec", None)
+    if rec is None or t_start is None:
+        return
+    try:
+        rec.setdefault("launch", []).append(
+            (name, (time.perf_counter() - t_start) * 1e3))
+    except Exception:  # pylint: disable=broad-except
+        pass
+
+
+def _engine_step_sync_sample(runner, rec, value):
+    """Every SYNC_EVERY-th step blocks on the dispatched model output (dev_model_ms).
+
+    It changes when the host waits on that one step, never what the device computes.
+    """
+    if rec is None or _ENGINE_STEP_LOG_SYNC_EVERY <= 0:
+        return
+    try:
+        if (_ENGINE_STEP_STATE["n"] + 1) % _ENGINE_STEP_LOG_SYNC_EVERY:
+            return
+        t_sync = time.perf_counter()
+        jax.block_until_ready(value)
+        rec["dev_model_ms"] = (time.perf_counter() - t_sync) * 1e3
+        rec["synced"] = 1
+    except Exception:  # pylint: disable=broad-except
+        pass
+
+
+def _engine_step_launch_text(launch):
+    totals = {}
+    for name, ms in launch or ():
+        totals[name] = totals.get(name, 0.0) + ms
+    return "/".join("%s:%.2f" % (k, v) for k, v in totals.items()) if totals else "-"
 _ENGINE_STEP_STATE = {"n": 0, "prev_end": None, "t0": None, "announced": False,
                       "proc": None, "win": None}
 
