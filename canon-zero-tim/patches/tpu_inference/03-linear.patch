+def _canon_fixed_einsum(einsum_str, inputs, weight, mm_kwargs, prefix):
+    from jax.experimental.shard_map import shard_map
+    from jax.sharding import PartitionSpec as _P
+    mesh = _CANON_MESH
+    n = int(mesh.shape[_CANON_TP_AXIS])
+    in_spec, w_spec = _CANON_FIXED_SPECS[einsum_str]
+
+    def _local(a_, w_):
+        if einsum_str == "mn,np->mp" and _canon_os.environ.get("CANON_MM_KBLOCK") == "1":
+            print(f"[PATHTRACE] CANON_MM_KBLOCK=1 fixed-K(640)-f32 down GEMM at {prefix} "
+                  f"(M={a_.shape[0]}, K={a_.shape[-1]})", flush=True)
+            # P19.K2 fix probe: fixed-K-block, fixed-order f32 accumulation for the per-chip
+            # down GEMM -- makes the K-loop grouping independent of M (= bucket).  Both X.1
+            # arms use the same variant, so the cross-bucket compare stays single-variable.
