+# reaches the einsums INSIDE Pallas kernels, and Mosaic's lowering rule assumes `precision` is a
+# 2-tuple -- `jax/_src/pallas/mosaic/lowering.py:2855 if precision[0] != precision[1]` raises
+# TypeError: 'DotAlgorithmPreset' object is not subscriptable (measured, via RPA
+# kernel.py:456).  So the algorithm is pinned only at the model's own linear/MLP/lm_head einsums,
+# leaving kernel-internal dots on the default.  rope.py's einsums are deliberately NOT touched:
+# they are f32 outer products for which a bf16 algorithm would be wrong.
+import os as _canon_os
