+# ---- P19.F4: opt-in fixed-order TP reduction (CANON_FIXED_AR=1) -----------------------------
+# Root cause proven 2026-07-31 (phase19 v6d/v6e/v6f): the bf16 all-reduce that completes a
+# contract-dim-sharded projection sums the per-chip partials in a ROW-POSITION-DEPENDENT order
+# (ring chunking), and bf16 addition is non-associative, so the same token at a different padded
+# row gets different bits -- the decode-vs-prefill (A-vs-B) seed.  Under CANON_FIXED_AR=1 the two
+# value-path reductions (attn .o_proj, mlp .down_proj) are computed instead as an explicit
+# fixed-order tree (((p0+p1)+p2)+p3) via shard_map+ppermute: same addends, one row-independent
+# order.  Measured: f32-cast AR does NOT fix this (v6e F1); the fixed tree does (v6f all-SAME).
+# Default OFF: with the env unset this file's __call__ is byte-identical in behavior to stock.
+_CANON_MESH = None          # stashed by tpu_runner._init_mesh on the mounted copy
+_CANON_TP_AXIS = "model"
+_canon_fixed_ar_logged = set()
+
