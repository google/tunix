+def _p38_terminal_gather(raw_logits, processed_logits, row_indices):
+    count = int(row_indices.size)
+    if not _P38_TERMINAL_ENABLED:
+        return None
+    if count <= 0:
+        raise RuntimeError("P38 terminal gather received no rows")
+    checkpoint_names = (
+        "logit_signatures",
+        "block_max",
+        "block_exp_sum",
+        "row_max",
+        "block_observer_log_normalizer",
+    )
+    names = tuple(
+        f"{prefix}_{name}"
+        for prefix in ("raw", "processed")
+        for name in checkpoint_names
+    )
+    gathered_results = []
+    source_rows = int(raw_logits.shape[0])
+    gather_fn = _P38_TERMINAL_ROW_GATHER_FNS.get(source_rows)
+    if gather_fn is None:
+        @jax.jit
+        def gather_fn(raw, processed, indices):
+            return (
+                jnp.take(raw, indices, axis=0),
+                jnp.take(processed, indices, axis=0),
+            )
+        _P38_TERMINAL_ROW_GATHER_FNS[source_rows] = gather_fn
+    for start in range(0, count, P38_TERMINAL_ROW_BUCKET):
+        stop = min(start + P38_TERMINAL_ROW_BUCKET, count)
+        indices = np.full(
+            (P38_TERMINAL_ROW_BUCKET,), int(row_indices[stop - 1]),
+            dtype=np.int32)
+        indices[:stop - start] = row_indices[start:stop]
+        raw_rows, processed_rows = gather_fn(
+            raw_logits, processed_logits,
+            jnp.asarray(indices, dtype=jnp.int32))
+        gathered_results.append(
+            _P38_TERMINAL_FINGERPRINT_FN(raw_rows, processed_rows))
+    host_results = jax.device_get(gathered_results)
+    return {
+        name: np.concatenate(
+            [np.asarray(result[field]) for result in host_results], axis=0
+        )[:count]
+        for field, name in enumerate(names)
+    }
+
+
