+def _p38_pad_sampled_tokens(sampled_token_ids):
+    """Encode ragged sampled-token rows without object arrays."""
+    rows = [np.asarray(row, dtype=np.int32).reshape(-1)
+            for row in sampled_token_ids]
+    width = max((row.size for row in rows), default=0)
+    result = np.full((len(rows), width), -1, dtype=np.int32)
+    for index, row in enumerate(rows):
+        result[index, :row.size] = row
+    return result
+
+
+def _p38_serving_finish_standard(seq, attn_metadata, output):
+    """Finish a standard execute_model/sample_tokens capture."""
+    if seq is None:
+        return
+    if isinstance(output, AsyncTPUModelRunnerOutput):
+        raise RuntimeError(
+            "P38 standard serving capture does not admit async scheduling")
+    logprobs = getattr(output, "logprobs", None)
+    if logprobs is None:
+        raise RuntimeError(
+            "P38 standard serving capture requires sampled-token logprobs")
+    final_positions, final_seq_lens = jax.device_get((
+        attn_metadata.input_positions,
+        attn_metadata.seq_lens,
+    ))
+    payload = {
+        "generated_tokens": _p38_pad_sampled_tokens(
+            output.sampled_token_ids).T,
+        "final_input_positions": np.asarray(final_positions),
+        "final_seq_lens": np.asarray(final_seq_lens),
+        "logprob_token_ids": np.asarray(
+            logprobs.logprob_token_ids)[None, ...],
+        "logprob_values": np.asarray(logprobs.logprobs)[None, ...],
+        "logprob_ranks": np.asarray(
+            logprobs.sampled_token_ranks)[None, ...],
+    }
+    _p38_serving_dump("post", seq, payload, {
+        "actual_steps": 1,
+        "completed_records": seq + 1,
+        "expected_max_records": _P38_SERVING_CAPTURE_MAX_CALLS,
+        "program_path": "standard",
