+def _p38_jsonable(value):
+    """Convert small host-side scheduler values to stable JSON data."""
+    if value is None or isinstance(value, (str, int, float, bool)):
+        return value
+    if isinstance(value, np.generic):
+        return value.item()
+    if isinstance(value, dict):
+        return {str(k): _p38_jsonable(v) for k, v in value.items()}
+    if isinstance(value, (list, tuple)):
+        return [_p38_jsonable(v) for v in value]
+    if isinstance(value, np.ndarray):
+        return value.tolist()
+    return str(value)
+
+
+def _p38_callable_identity(value):
+    """Describe a callable without unstable memory-address representations."""
+    import hashlib as _hashlib
+    from pathlib import Path as _Path
+
+    current = value
+    chain = []
+    seen = set()
+    for _ in range(8):
+        if id(current) in seen:
+            break
+        seen.add(id(current))
+        chain.append({
+            "type_module": type(current).__module__,
+            "type_name": type(current).__qualname__,
+            "module": getattr(current, "__module__", None),
+            "qualname": getattr(current, "__qualname__", None),
+        })
+        next_value = getattr(current, "__wrapped__", None)
+        if next_value is None and hasattr(current, "func"):
+            next_value = getattr(current, "func")
+        if next_value is None or next_value is current:
+            break
+        current = next_value
+
+    code = getattr(current, "__code__", None)
+    source_file = getattr(code, "co_filename", None)
+    source_sha256 = None
+    if source_file:
+        source_path = _Path(source_file)
+        if source_path.is_file():
+            source_sha256 = _hashlib.sha256(source_path.read_bytes()).hexdigest()
+    return {
+        "chain": chain,
+        "source_file": source_file,
+        "source_sha256": source_sha256,
+    }
+
