+def _p38_serving_dump(stage, seq, payload, meta):
+    """Persist one bounded serving record without overwriting prior evidence."""
+    import hashlib as _hashlib
+    import json as _json
+    from pathlib import Path as _Path
+    import shutil as _shutil
+
+    if stage not in ("pre", "post"):
+        raise RuntimeError(f"unsupported P38 serving stage: {stage!r}")
+    directory = _Path(_P38_SERVING_CAPTURE_DIR)
+    directory.mkdir(parents=True, exist_ok=True)
+    base = directory / f"p38_serving_{seq:04d}_{stage}"
+    npz_path = _Path(str(base) + ".npz")
+    json_path = _Path(str(base) + ".json")
+    if npz_path.exists() or json_path.exists():
+        raise RuntimeError(f"P38 serving evidence collision at {base}")
+
+    arrays = {}
+    describe = {}
+    for key, value in payload.items():
+        if isinstance(value, dict) and "array" in value:
+            arrays[key] = value["array"]
+            describe[key] = {
+                name: field for name, field in value.items() if name != "array"
+            }
+        elif isinstance(value, np.ndarray):
+            arrays[key] = value
+            describe[key] = {
+                "shape": tuple(value.shape),
+                "dtype": str(value.dtype),
+                "sharding": "host",
+            }
+        elif value is not None:
+            describe[key] = _p38_jsonable(value)
+
+    payload_bytes = sum(int(np.asarray(value).nbytes) for value in arrays.values())
+    estimated_total_bytes = payload_bytes * _P38_SERVING_CAPTURE_MAX_CALLS
+    required_free_bytes = (
+        estimated_total_bytes * _P38_SERVING_CAPTURE_FREE_SPACE_MULTIPLIER)
+    free_bytes = int(_shutil.disk_usage(directory).free)
+    if free_bytes < required_free_bytes:
+        raise RuntimeError(
+            "P38 serving capture lacks the required free-space margin: "
+            f"free={free_bytes} required={required_free_bytes}")
+    storage_guard = {
+        "payload_bytes": payload_bytes,
+        "estimated_total_bytes": estimated_total_bytes,
+        "free_bytes": free_bytes,
+        "required_free_bytes": required_free_bytes,
+        "multiplier": _P38_SERVING_CAPTURE_FREE_SPACE_MULTIPLIER,
+    }
+
+    with npz_path.open("xb") as stream:
+        np.savez(stream, **arrays)
+    npz_sha256 = _hashlib.sha256(npz_path.read_bytes()).hexdigest()
+    record = {
+        "schema_version": 2,
+        "stage": stage,
+        "seq": seq,
+        "arrays": sorted(arrays),
+        "describe": describe,
+        "meta": _p38_jsonable(meta),
+        "storage_guard": storage_guard,
+        "npz_sha256": npz_sha256,
+    }
+    with json_path.open("x", encoding="utf-8") as stream:
+        _json.dump(record, stream, indent=2, sort_keys=True)
+    json_sha256 = _hashlib.sha256(json_path.read_bytes()).hexdigest()
+    print(
+        "[CANON_P38_SERVING_CAPTURE] "
+        + _json.dumps({
+            "stage": stage,
+            "seq": seq,
+            "arrays": len(arrays),
+            "npz_sha256": npz_sha256,
+            "json_sha256": json_sha256,
+            "base": str(base),
+            "storage_guard": storage_guard,
+        }, sort_keys=True),
+        flush=True,
+    )
+
