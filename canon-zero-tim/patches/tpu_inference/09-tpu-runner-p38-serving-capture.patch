+def _p38_jsonable(value):
+    """Convert small host-side scheduler values to stable JSON data."""
+    if value is None or isinstance(value, (str, int, float, bool)):
+        return value
+    if isinstance(value, np.generic):
+        return value.item()
+    if isinstance(value, dict):
+        return {str(k): _p38_jsonable(v) for k, v in value.items()}
+    if isinstance(value, (list, tuple)):
+        return [_p38_jsonable(v) for v in value]
+    if isinstance(value, np.ndarray):
+        return value.tolist()
+    return str(value)
+
+
+def _p38_serving_dump(stage, seq, payload, meta):
+    """Persist one bounded serving record without overwriting prior evidence."""
+    import hashlib as _hashlib
+    import json as _json
+    from pathlib import Path as _Path
+
+    if stage not in ("pre", "post"):
+        raise RuntimeError(f"unsupported P38 serving stage: {stage!r}")
+    directory = _Path(_P38_SERVING_CAPTURE_DIR)
+    directory.mkdir(parents=True, exist_ok=True)
+    base = directory / f"p38_serving_{seq:04d}_{stage}"
+    npz_path = _Path(str(base) + ".npz")
+    json_path = _Path(str(base) + ".json")
+    if npz_path.exists() or json_path.exists():
+        raise RuntimeError(f"P38 serving evidence collision at {base}")
+
+    arrays = {}
+    describe = {}
+    for key, value in payload.items():
+        if isinstance(value, dict) and "array" in value:
+            arrays[key] = value["array"]
+            describe[key] = {
+                name: field for name, field in value.items() if name != "array"
+            }
+        elif isinstance(value, np.ndarray):
+            arrays[key] = value
+            describe[key] = {
+                "shape": tuple(value.shape),
+                "dtype": str(value.dtype),
+                "sharding": "host",
+            }
+        elif value is not None:
+            describe[key] = _p38_jsonable(value)
+
+    with npz_path.open("xb") as stream:
+        np.savez(stream, **arrays)
+    npz_sha256 = _hashlib.sha256(npz_path.read_bytes()).hexdigest()
+    record = {
+        "schema_version": 1,
+        "stage": stage,
+        "seq": seq,
+        "arrays": sorted(arrays),
+        "describe": describe,
+        "meta": _p38_jsonable(meta),
+        "npz_sha256": npz_sha256,
+    }
+    with json_path.open("x", encoding="utf-8") as stream:
+        _json.dump(record, stream, indent=2, sort_keys=True)
+    json_sha256 = _hashlib.sha256(json_path.read_bytes()).hexdigest()
+    print(
+        "[CANON_P38_SERVING_CAPTURE] "
+        + _json.dumps({
+            "stage": stage,
+            "seq": seq,
+            "arrays": len(arrays),
+            "npz_sha256": npz_sha256,
+            "json_sha256": json_sha256,
+            "base": str(base),
+        }, sort_keys=True),
+        flush=True,
+    )
+
+
+def _p38_serving_request_meta(runner, scheduler_output, req_ids_dp):
+    """Describe the exact logical requests and physical pages in one call."""
+    num_reqs = runner.input_batch.num_reqs
+    request_ids = list(runner.input_batch.req_ids[:num_reqs])
+    requests = []
+    assigned_dp_rank = getattr(scheduler_output, "assigned_dp_rank", None)
+    for req_id in request_ids:
+        req_index = runner.input_batch.req_id_to_index[req_id]
+        request_state = runner.requests.get(req_id)
+        block_ids = getattr(request_state, "block_ids", None)
+        requests.append({
+            "request_id": req_id,
+            "input_batch_index": int(req_index),
+            "assigned_dp_rank": int(
+                assigned_dp_rank.get(req_id, 0)
+                if assigned_dp_rank is not None else 0),
+            "scheduled_tokens": int(
+                scheduler_output.num_scheduled_tokens[req_id]),
+            "num_computed_tokens": int(
+                runner.input_batch.num_computed_tokens_cpu[req_index]),
+            "num_prompt_tokens": int(
+                runner.input_batch.num_prompt_tokens[req_index]),
+            "num_tokens": int(runner.input_batch.num_tokens[req_index]),
+            "token_ids": [
+                int(token_id) for token_id in np.asarray(
+                    runner.input_batch.token_ids_cpu[
+                        req_index, :runner.input_batch.num_tokens[req_index]
+                    ])
+            ],
+            "block_ids": _p38_jsonable(block_ids),
+        })
+    return {
+        "request_ids": request_ids,
+        "request_ids_by_dp": _p38_jsonable(req_ids_dp),
+        "requests": requests,
+        "req_id_to_index": {
+            req_id: int(runner.input_batch.req_id_to_index[req_id])
+            for req_id in request_ids
+        },
+    }
+
+
+def _p38_serving_begin(runner, scheduler_output, req_ids_dp, input_ids,
+                       input_positions, active_mask, attn_metadata,
+                       sampling_metadata, tokens_indices_selector,
+                       max_decode_steps,
