+    """Write the pre-dispatch record and return its sequence number."""
+    if not _P38_SERVING_CAPTURE_DIR:
+        return None
+    seq = _P38_SERVING_CAPTURE_SEQ["n"]
+    if seq >= _P38_SERVING_CAPTURE_MAX_CALLS:
+        return None
+
+    positions_host, active_host = jax.device_get(
+        (input_positions, active_mask))
+    positions_host = np.asarray(positions_host)
+    active_host = np.asarray(active_host, dtype=np.bool_)
+    active_positions = positions_host[active_host]
+    max_prefix = int(active_positions.max()) if active_positions.size else -1
+    if max_prefix < _P38_SERVING_CAPTURE_MIN_PREFIX:
+        return None
+
+    _P38_SERVING_CAPTURE_SEQ["n"] += 1
+    sampling_leaves, sampling_tree = jax.tree_util.tree_flatten(
+        sampling_metadata)
+    payload = {
+        "input_ids": _p18_leaf(input_ids),
+        "input_positions": {
+            "array": positions_host,
+            "shape": tuple(positions_host.shape),
+            "dtype": str(positions_host.dtype),
+            "sharding": str(getattr(input_positions, "sharding", None)),
+        },
+        "active_mask": {
+            "array": active_host,
+            "shape": tuple(active_host.shape),
+            "dtype": str(active_host.dtype),
+            "sharding": str(getattr(active_mask, "sharding", None)),
+        },
+        "md_input_positions": _p18_leaf(attn_metadata.input_positions),
+        "md_block_tables": _p18_leaf(attn_metadata.block_tables),
+        "md_seq_lens": _p18_leaf(attn_metadata.seq_lens),
+        "md_query_start_loc": _p18_leaf(attn_metadata.query_start_loc),
+        "md_request_distribution": _p18_leaf(
+            attn_metadata.request_distribution),
+        "tokens_indices_selector": _p18_leaf(tokens_indices_selector),
+        "rng": _p18_leaf(runner.rng_params_for_sampling),
+    }
+    for index, leaf in enumerate(sampling_leaves):
+        payload[f"sampling_leaf_{index:02d}"] = _p18_leaf(leaf)
+
+    meta = {
+        **_p18_contract_meta(runner.mesh),
+        **_p38_serving_request_meta(
+            runner, scheduler_output, req_ids_dp),
+        "capture_max_calls": _P38_SERVING_CAPTURE_MAX_CALLS,
+        "capture_min_prefix": _P38_SERVING_CAPTURE_MIN_PREFIX,
+        "observed_max_prefix": max_prefix,
+        "sampling_tree": str(sampling_tree),
+        "max_decode_steps": int(max_decode_steps),
+        "static_max_decode_steps": int(runner.static_max_decode_steps),
+        "tokens_per_dp": int(input_ids.shape[0] // runner.dp_size),
+        "padded_num_scheduled_tokens_per_dp_rank": int(
+            padded_num_scheduled_tokens_per_dp_rank),
+        "dp_size": int(runner.dp_size),
+        "block_size": int(runner.block_size),
+        "continue_decode_enabled": bool(runner.enable_continue_decode),
+        "kv_unified": os.environ.get("CANON_KV_UNIFIED") == "1",
+        "caller_update_kv_cache": True,
+        "output_update_kv_cache": os.environ.get("CANON_KV_UNIFIED") != "1",
+        "rpa_block_tuples": {
+            name: os.environ.get(name)
+            for name in ("CANON_RPA_D", "CANON_RPA_P", "CANON_RPA_M")
+        },
+        "kv_caches_spec": [{
+            "shape": tuple(cache.shape),
+            "dtype": str(cache.dtype),
+            "sharding": str(getattr(cache, "sharding", None)),
+        } for cache in runner.kv_caches],
+        "layer_name_to_kvcache_index": list(
+            runner.layer_name_to_kvcache_index.items()),
+    }
+    _p38_serving_dump("pre", seq, payload, meta)
+    return seq
+
