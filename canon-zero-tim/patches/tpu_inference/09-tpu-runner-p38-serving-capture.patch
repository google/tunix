+def _p38_capture_stratum(max_prefix):
+    """Return the configured half-open prefix stratum for one decode call."""
+    for index, (lower, upper) in enumerate(zip(
+            _P38_SERVING_CAPTURE_PREFIX_BOUNDS,
+            _P38_SERVING_CAPTURE_PREFIX_BOUNDS[1:])):
+        if lower <= max_prefix < upper:
+            return index, lower, upper
+    return None
