+def _p38_serving_finish(seq, generated_tokens, actual_steps,
+                        final_state, logprob_token_ids, logprob_values,
+                        logprob_ranks):
+    """Write small post-dispatch outputs for an admitted capture record."""
+    if seq is None:
+        return
+    final_positions, final_seq_lens = jax.device_get((
+        final_state.attn_metadata.input_positions,
+        final_state.attn_metadata.seq_lens,
+    ))
+    payload = {
+        "generated_tokens": np.asarray(generated_tokens),
+        "final_input_positions": np.asarray(final_positions),
+        "final_seq_lens": np.asarray(final_seq_lens),
+    }
+    if logprob_token_ids is not None:
+        payload["logprob_token_ids"] = np.asarray(logprob_token_ids)
+        payload["logprob_values"] = np.asarray(logprob_values)
+        payload["logprob_ranks"] = np.asarray(logprob_ranks)
+    _p38_serving_dump("post", seq, payload, {
+        "actual_steps": int(actual_steps),
+        "completed_records": seq + 1,
+        "expected_max_records": _P38_SERVING_CAPTURE_MAX_CALLS,
+    })
