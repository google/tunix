+def _p38_token_history_sha256(token_ids):
+    """Hash an exact integer token prefix using one portable representation."""
+    import hashlib as _hashlib
+
+    values = np.ascontiguousarray(np.asarray(token_ids, dtype="<i8"))
+    return _hashlib.sha256(values.tobytes()).hexdigest()
