+def _p38_tail_gather(
+        raw_logits, processed_logits, target_ids, production_logprobs,
+        row_indices):
+    count = int(row_indices.size)
+    if count <= 0:
+        raise RuntimeError("P38 tail gather received no rows")
+    bucket = _p38_seam_next_power_of_two(count)
+    padded = np.full((bucket,), int(row_indices[-1]), dtype=np.int32)
+    padded[:count] = row_indices
+    gather_fn = _P38_TAIL_GATHER_FNS.get(bucket)
+    if gather_fn is None:
+        @jax.jit
+        def gather_fn(raw, processed, targets, production, indices):
+            raw_rows = jnp.take(raw, indices, axis=0)
+            processed_rows = jnp.take(processed, indices, axis=0)
+            target_rows = jnp.take(targets.reshape((-1,)), indices, axis=0)
+            production_rows = jnp.take(production, indices, axis=0)
+            raw_target = jnp.take_along_axis(
+                raw_rows, target_rows[:, None], axis=1)[:, 0]
+            processed_target = jnp.take_along_axis(
+                processed_rows, target_rows[:, None], axis=1)[:, 0]
+            raw_normalizer = jax.scipy.special.logsumexp(raw_rows, axis=-1)
+            processed_normalizer = jax.scipy.special.logsumexp(
+                processed_rows, axis=-1)
+            observer_logprob = processed_target - processed_normalizer
+            return jnp.stack((
+                raw_target,
+                raw_normalizer,
+                processed_target,
+                processed_normalizer,
+                observer_logprob,
+                production_rows,
+            ), axis=1), target_rows
+        _P38_TAIL_GATHER_FNS[bucket] = gather_fn
+    values, observed_targets = jax.device_get(gather_fn(
+        raw_logits,
+        processed_logits,
+        target_ids,
+        production_logprobs,
+        jnp.asarray(padded, dtype=jnp.int32),
+    ))
+    return (
+        np.asarray(values)[:count],
+        np.asarray(observed_targets, dtype=np.int32)[:count],
+        bucket,
+    )
+
+
+def _p38_tail_write(selected_offsets, logit_rows, values, target_ids, bucket):
+    global _P38_TAIL_PENDING
+    pending = _P38_TAIL_PENDING
+    if pending is None:
+        raise RuntimeError("P38 tail record has no pending seam context")
+    order = np.argsort(np.asarray(selected_offsets, dtype=np.int32))
+    offsets = np.asarray(selected_offsets, dtype=np.int32)[order]
+    if offsets.size == 0 or np.unique(offsets).size != offsets.size:
+        raise RuntimeError("P38 tail selected offsets are empty or duplicated")
+    row_arrays = pending["row_arrays"]
+    arrays = {
+        name: np.asarray(value)[offsets]
+        for name, value in row_arrays.items()
+    }
+    arrays.update({
+        "logit_row_indices": np.asarray(logit_rows, dtype=np.int32)[order],
+        "target_ids": np.asarray(target_ids, dtype=np.int32)[order],
+        "tail_values": np.asarray(values)[order],
+    })
+    record_index, digest = write_tail_record(
+        _P38_SEAM_OBSERVER_DIR,
+        _P38_TAIL_STATE,
+        arrays,
+        {
+            "arm": pending["arm"],
+            "call_index": pending["call_index"],
+            "checkpoint_names": P38_TAIL_CHECKPOINTS,
+            "diagnostic_round": pending["diagnostic_round"],
+            "gather_bucket": int(bucket),
+            "program_path": "standard",
+            "selected_rows": int(offsets.size),
+        },
+        _P38_TAIL_MAX_BYTES,
+    )
+    print(
+        "[CANON_P38_TAIL_OBSERVER_RECORD] "
+        f"record={record_index} arm={pending['arm']} "
+        f"call={pending['call_index']} rows={offsets.size} "
+        f"npz_sha256={digest}",
+        flush=True,
+    )
+    _P38_TAIL_PENDING = None
+
+
+def _p38_tail_after_decode(
+        runner, raw_logits, processed_logits, target_ids,
+        production_logprobs):
+    global _P38_TAIL_PENDING
+    if not _P38_TAIL_ENABLED:
+        return
+    pending = _P38_TAIL_PENDING
+    if pending is None:
+        return
+    if pending["arm"] != "A":
+        raise RuntimeError("P38 decode tail context is absent or not arm A")
+    if int(raw_logits.shape[0]) % int(runner.dp_size):
+        raise RuntimeError("P38 decode tail logits are not DP divisible")
+    rows_per_dp = int(raw_logits.shape[0]) // int(runner.dp_size)
+    selected_offsets = []
+    logit_rows = []
+    ordinals = pending["row_arrays"]["request_ordinals"]
+    positions = pending["row_arrays"]["positions"]
+    for selected_offset, request_ordinal in enumerate(ordinals):
+        request = pending["requests"][int(request_ordinal)]
+        if int(positions[selected_offset]) != int(request["position_range"][1]) - 1:
+            continue
+        logit_row = (
+            int(request["dp_rank"]) * rows_per_dp
+            + int(request["dp_request_slot"])
+        )
+        if not 0 <= logit_row < int(raw_logits.shape[0]):
+            raise RuntimeError("P38 decode tail logit-row mapping overflowed")
+        selected_offsets.append(selected_offset)
+        logit_rows.append(logit_row)
+    if not selected_offsets:
+        _P38_TAIL_PENDING = None
+        return
+    production = production_logprobs.logprobs[:, 0]
+    values, observed_targets, bucket = _p38_tail_gather(
+        raw_logits,
+        processed_logits,
+        target_ids,
+        production,
+        np.asarray(logit_rows, dtype=np.int32),
+    )
+    _p38_tail_write(
+        selected_offsets, logit_rows, values, observed_targets, bucket)
+
+
+def _p38_tail_prompt_chunk(
+        raw_logits, processed_logits, target_ids, production_logprobs,
+        dp_size, rows_per_dp, start, stop, target_rows):
+    if not _P38_TAIL_ENABLED:
+        return None
+    pending = _P38_TAIL_PENDING
+    if pending is None:
+        return None
+    if pending["arm"] != "B":
+        raise RuntimeError("P38 prompt tail context is absent or not arm B")
+    selected_offsets = []
+    chunk_rows = []
+    for selected_offset, global_row in enumerate(pending["row_indices"]):
+        dp_rank, local_row = divmod(int(global_row), int(rows_per_dp))
+        if start <= local_row < stop:
+            selected_offsets.append(selected_offset)
+            chunk_rows.append(
+                dp_rank * int(target_rows) + local_row - int(start))
+    if not selected_offsets:
+        return None
+    values, observed_targets, bucket = _p38_tail_gather(
+        raw_logits,
+        processed_logits,
+        target_ids,
+        production_logprobs.logprobs[:, 0],
+        np.asarray(chunk_rows, dtype=np.int32),
+    )
+    return selected_offsets, chunk_rows, values, observed_targets, bucket
+
+
+def _p38_tail_finish_prompt(parts):
+    global _P38_TAIL_PENDING
+    if not _P38_TAIL_ENABLED:
+        return
+    if not parts:
+        _P38_TAIL_PENDING = None
+        return
+    selected_offsets = []
+    logit_rows = []
+    values = []
+    target_ids = []
+    bucket = 0
+    for offsets, rows, part_values, part_targets, part_bucket in parts:
+        selected_offsets.extend(offsets)
+        logit_rows.extend(rows)
+        values.append(part_values)
+        target_ids.append(part_targets)
+        bucket = max(bucket, int(part_bucket))
+    _p38_tail_write(
+        selected_offsets,
+        logit_rows,
+        np.concatenate(values, axis=0),
+        np.concatenate(target_ids, axis=0),
+        bucket,
+    )
 
 
