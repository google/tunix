+def _canon_sample_split_fusion() -> bool:
+    value = os.environ.get("CANON_SAMPLE_SPLIT_FUSION", "")
+    if value not in ("", "0", "1"):
+        raise ValueError(
+            f"CANON_SAMPLE_SPLIT_FUSION must be unset/0/1, got {value!r}")
+    return value == "1"
+
+
+@functools.partial(jax.jit, static_argnames=("mesh",))
+def _canon_split_and_sample(
+    rng_state: jax.Array,
+    mesh,
+    logits: jax.Array,
+    tpu_sampling_metadata,
+):
+    """P56: rng split -> f32 cast -> sample as ONE program.
+
+    Verbatim ops inside one jit: the same jax.random.split of the
+    sampling state, the same float32 cast, and the (inlined) sample.
+    Values are bit-identical -- split is a pure function of the state,
+    and the cast and sampler see the exact operands the eager chain
+    produced.  Three per-step launches collapse into one.  The step key
+    is returned as well because the prompt processed-logprob path
+    consumes the same key downstream (the r18 None crash).
+    """
+    new_state, step_rng = jax.random.split(rng_state)
+    logits32 = logits.astype(jnp.float32)
+    next_tokens, processed_logits = sample(
+        step_rng, mesh, logits32, tpu_sampling_metadata)
+    return new_state, step_rng, next_tokens, processed_logits
+
