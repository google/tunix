+def _p38_kv_observer_begin_target_round(diagnostic_round):
+    """Reset only per-round targeted-KV state; never reuse record indices."""
+    global _P38_KV_OBSERVER_ACTIVE_TARGET_ROUND
+    if (not _P38_KV_OBSERVER_TARGET_PREFIX_SHA256
+            or _P38_DURABILITY_PROFILE != "m15-e0-kv-v1"):
+        return
+    diagnostic_round = int(diagnostic_round)
+    previous = _P38_KV_OBSERVER_ACTIVE_TARGET_ROUND
+    if previous is None:
+        if diagnostic_round != 0:
+            raise RuntimeError(
+                "M15 E0 KV observation must begin at diagnostic round 0")
+    elif diagnostic_round == previous:
+        return
+    else:
+        if diagnostic_round != int(previous) + 1:
+            raise RuntimeError(
+                "M15 E0 KV rounds must increase by one: "
+                f"previous={previous} current={diagnostic_round}")
+        previous_records = [
+            record for record in _P38_KV_OBSERVER_A_RECORDS
+            if int(record["diagnostic_round"]) == int(previous)
+        ]
+        previous_indices = {
+            int(record["record_index"]) for record in previous_records
+        }
+        if (len(previous_records) != _P38_KV_OBSERVER_MAX_CANDIDATES
+                or not previous_indices.issubset(
+                    _P38_KV_OBSERVER_MATCHED_A)):
+            raise RuntimeError(
+                "M15 E0 KV round advanced before eight A/B pairs completed: "
+                f"round={previous} A={len(previous_records)} "
+                f"B={len(previous_indices & _P38_KV_OBSERVER_MATCHED_A)}")
+        _P38_KV_OBSERVER_CANDIDATES.clear()
+        _P38_KV_OBSERVER_STATE["bytes"] = 0
+    _P38_KV_OBSERVER_ACTIVE_TARGET_ROUND = diagnostic_round
+    print(
+        "[P38_KV_OBSERVER_ROUND_BUDGET] "
+        f"round={diagnostic_round} "
+        f"records={_P38_KV_OBSERVER_STATE['records']} "
+        f"bytes={_P38_KV_OBSERVER_STATE['bytes']}",
+        flush=True,
+    )
+
