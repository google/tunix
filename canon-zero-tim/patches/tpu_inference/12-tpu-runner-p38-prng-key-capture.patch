+def _p38_capture_leaf(x):
+    """Materialise a P38 leaf without asking NumPy to decode typed keys."""
+    try:
+        is_typed_key = (
+            hasattr(x, "dtype")
+            and jax.dtypes.issubdtype(x.dtype, jax.dtypes.prng_key)
+        )
+    except TypeError:
+        is_typed_key = False
+    if not is_typed_key:
+        return _p18_leaf(x)
+
+    # Typed PRNG keys intentionally have no NumPy representation.  The capture
+    # records their public uint32 payload and logical key metadata, leaving the
+    # live key and the sampling program untouched.
+    raw_key = jax.random.key_data(x)
+    result = _p18_leaf(raw_key)
+    result["logical_dtype"] = str(x.dtype)
+    result["prng_key_impl"] = str(jax.random.key_impl(x))
+    return result
+
