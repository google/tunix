+def _p38_seam_round():
+    from pathlib import Path as _Path
+
+    round_path = _Path(_P38_DIAGNOSTIC_ROUND_FILE)
+    if not round_path.is_file():
+        raise RuntimeError("P38 seam observer diagnostic round file is absent")
+    value = round_path.read_text(encoding="utf-8").strip()
+    if not value.isdigit() or not 0 <= int(value) < 8:
+        raise RuntimeError("P38 seam observer diagnostic round is invalid")
+    return int(value)
+
+
+def _p38_seam_gather(layer_fingerprints, final_fingerprints, row_indices):
+    count = int(row_indices.size)
+    if count <= 0:
+        raise RuntimeError("P38 seam gather received no rows")
+    bucket = _p38_seam_next_power_of_two(count)
+    if bucket > int(layer_fingerprints.shape[0]):
+        raise RuntimeError(
+            f"P38 seam gather bucket exceeds token rows: {bucket}")
+    padded = np.full((bucket,), int(row_indices[-1]), dtype=np.int32)
+    padded[:count] = row_indices
+    gather_fn = _P38_SEAM_GATHER_FNS.get(bucket)
+    if gather_fn is None:
+        @jax.jit
+        def gather_fn(layer_values, final_values, indices):
+            return (
+                jnp.take(layer_values, indices, axis=0),
+                jnp.take(final_values, indices, axis=0),
+            )
+        _P38_SEAM_GATHER_FNS[bucket] = gather_fn
+    layer_rows, final_rows = jax.device_get(gather_fn(
+        layer_fingerprints,
+        final_fingerprints,
+        jnp.asarray(padded, dtype=jnp.int32),
+    ))
+    return np.asarray(layer_rows)[:count], np.asarray(final_rows)[:count], bucket
+
+
+def _p38_seam_after_model(
+        runner, scheduler_output, req_ids_dp, input_ids, input_positions,
+        aux_hidden_states, padded_rows_per_dp):
+    """Persist compact seam fingerprints for every real deep-band token."""
+    if not _P38_SEAM_OBSERVER_DIR:
+        return
+    if not isinstance(aux_hidden_states, (tuple, list)) or len(
+            aux_hidden_states) != 2:
+        raise RuntimeError(
+            "P38 seam observer requires [layer fingerprints, final norm]")
+    layer_fingerprints, final_fingerprints = aux_hidden_states
+    layer_shape = tuple(int(value) for value in layer_fingerprints.shape)
+    final_shape = tuple(int(value) for value in final_fingerprints.shape)
+    checkpoint_names = (
+        P38_LAYER_CHECKPOINTS
+        if _P38_SEAM_OBSERVER == "layer"
+        else P38_SEAM_CHECKPOINTS
+    )
+    expected_layers = (
+        len(runner.kv_caches)
+        if _P38_SEAM_OBSERVER == "layer"
+        else 1
+    )
+    if (len(layer_shape) != 4 or len(final_shape) != 2
+            or layer_shape[0] != int(input_ids.shape[0])
+            or final_shape[0] != int(input_ids.shape[0])
+            or layer_shape[1] != expected_layers
+            or layer_shape[2] != len(checkpoint_names)
+            or layer_shape[3] != final_shape[1]):
+        raise RuntimeError(
+            "P38 seam observer aux geometry drifted: "
+            f"layer={layer_shape} final={final_shape} tokens={input_ids.shape}")
+    row_indices, row_arrays, requests = select_standard_seam_rows(
+        req_ids_dp=req_ids_dp,
+        scheduled_tokens=scheduler_output.num_scheduled_tokens,
+        req_id_to_index=runner.input_batch.req_id_to_index,
+        num_computed_tokens=runner.input_batch.num_computed_tokens_cpu,
+        num_tokens=runner.input_batch.num_tokens,
+        token_ids_cpu=runner.input_batch.token_ids_cpu,
+        padded_rows_per_dp=int(padded_rows_per_dp),
+        total_rows=int(input_ids.shape[0]),
+        min_position=_P38_SEAM_MIN_POSITION,
+        max_position=_P38_SEAM_MAX_POSITION,
+    )
+    if not row_indices.size:
+        return
+    observed_ids, observed_positions = jax.device_get((
+        jnp.take(input_ids, jnp.asarray(row_indices), axis=0),
+        jnp.take(input_positions, jnp.asarray(row_indices), axis=0),
+    ))
+    if not np.array_equal(
+            np.asarray(observed_ids, dtype=np.int32), row_arrays["token_ids"]):
+        raise RuntimeError("P38 seam token-ID row mapping drifted")
+    if not np.array_equal(
+            np.asarray(observed_positions, dtype=np.int32),
+            row_arrays["positions"]):
+        raise RuntimeError("P38 seam position row mapping drifted")
+    layer_rows, final_rows, gather_bucket = _p38_seam_gather(
+        layer_fingerprints, final_fingerprints, row_indices)
+    arrays = {
+        **row_arrays,
+        "layer_fingerprints": layer_rows,
+        "final_norm_fingerprints": final_rows,
+    }
+    arm = "B" if runner.input_batch.num_prompt_logprobs else "A"
+    call_index = int(_P38_REQUEST_JOURNAL_STATE["calls"])
+    record_index, npz_sha256 = write_seam_record(
+        _P38_SEAM_OBSERVER_DIR,
+        _P38_SEAM_STATE,
+        arrays,
+        {
+            "arm": arm,
+            "diagnostic_round": _p38_seam_round(),
+            "call_index": call_index,
+            "program_path": "standard",
+            "checkpoint_names": checkpoint_names,
+            "observer_mode": _P38_SEAM_OBSERVER,
+            "observed_layer": _P38_SEAM_LAYER,
+            "layer_indices": (
+                list(range(expected_layers))
+                if _P38_SEAM_OBSERVER == "layer"
+                else [_P38_SEAM_LAYER]
+            ),
+            "fingerprint_fields": (
+                "xor", "sum", "weighted_sum", "sample_first",
+                "sample_quarter", "sample_middle",
+                "sample_three_quarters", "sample_last",
+            ),
+            "selected_rows": int(row_indices.size),
+            "gather_bucket": int(gather_bucket),
+            "layer_count": int(layer_shape[1]),
+            "layer_fingerprint_shape": list(layer_shape),
+            "final_fingerprint_shape": list(final_shape),
+            "layer_fingerprint_sharding": str(getattr(
+                layer_fingerprints, "sharding", None)),
+            "final_fingerprint_sharding": str(getattr(
+                final_fingerprints, "sharding", None)),
+            "requests": requests,
+            "claim": "diagnostic_non_cryptographic_fingerprint",
+        },
+        _P38_SEAM_MAX_BYTES,
+    )
+    print(
+        "[CANON_P38_SEAM_OBSERVER_RECORD] "
+        f"record={record_index} arm={arm} call={call_index} "
+        f"rows={row_indices.size} bucket={gather_bucket} "
+        f"npz_sha256={npz_sha256}",
+        flush=True,
+    )
