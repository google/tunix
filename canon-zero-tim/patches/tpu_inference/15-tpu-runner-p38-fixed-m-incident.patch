+def _p38_aval_contract(value):
+    """Describe one program input without materialising its device buffer."""
+    if value is None:
+        return None
+    shape = getattr(value, "shape", None)
+    dtype = getattr(value, "dtype", None)
+    if shape is None or dtype is None:
+        raise RuntimeError(
+            "P38 fixed-M attestation requires shaped, typed program inputs")
+    try:
+        sharding = str(getattr(value, "sharding", None))
+    except Exception:
+        sharding = "unknown"
+    return {
+        "shape": [int(dimension) for dimension in shape],
+        "dtype": str(dtype),
+        "sharding": sharding,
+    }
