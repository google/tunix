+def _p57_tito_runner_prompt_witness(
+        runner, scheduler_output, req_ids_dp):
+    """Persist one host-only prompt hash for every new sampling request."""
+    if not _P57_TITO_RUNNER_WITNESS_DIR:
+        return
+    import hashlib as _hashlib
+    import json as _json
+    import os as _os
+    from pathlib import Path as _Path
+
+    dp_ranks = {}
+    for dp_rank, request_ids in req_ids_dp.items():
+        for request_id in request_ids:
+            if request_id in dp_ranks:
+                raise RuntimeError(
+                    f"P57 TiTO request appears on two DP ranks: {request_id}")
+            dp_ranks[request_id] = int(dp_rank)
+
+    for new_request in scheduler_output.scheduled_new_reqs:
+        request_id = str(new_request.req_id)
+        # B/full-rescore requests ask the engine for prompt logprobs but do not
+        # flow through SamplerOutput. They are deliberately outside this A-arm
+        # submit/echo/runner join.
+        if request_id in runner.input_batch.num_prompt_logprobs:
+            continue
+        if request_id not in dp_ranks:
+            raise RuntimeError(
+                f"P57 TiTO request has no DP-rank mapping: {request_id}")
+        state = _P57_TITO_RUNNER_WITNESS_STATE
+        if state["records"] >= _P57_TITO_RUNNER_WITNESS_MAX_RECORDS:
+            raise RuntimeError("P57 TiTO runner witness record bound exceeded")
+        request_index = int(runner.input_batch.req_id_to_index[request_id])
+        prompt_tokens = int(
+            runner.input_batch.num_prompt_tokens[request_index])
+        if prompt_tokens <= 0:
+            raise RuntimeError(
+                f"P57 TiTO request has no prompt tokens: {request_id}")
+        token_ids = np.asarray(
+            runner.input_batch.token_ids_cpu[
+                request_index, :prompt_tokens], dtype="<i8")
+        if token_ids.shape != (prompt_tokens,) or np.any(token_ids < 0):
+            raise RuntimeError(
+                f"P57 TiTO request has malformed prompt IDs: {request_id}")
+        state["records"] += 1
+        record_index = int(state["records"])
+        request_key = _hashlib.sha256(request_id.encode()).hexdigest()[:12]
+        record = {
+            "schema": "canon.p57-tito-runner-input.v1",
+            "record_index": record_index,
+            "request_id": request_id,
+            "dp_rank": dp_ranks[request_id],
+            "input_batch_index": request_index,
+            "prompt_tokens": prompt_tokens,
+            "prompt_sha256": _p38_token_history_sha256(token_ids),
+        }
+        encoded = (_json.dumps(
+            record, sort_keys=True, separators=(",", ":")) + "\n").encode()
+        directory = _Path(_P57_TITO_RUNNER_WITNESS_DIR)
+        directory.mkdir(parents=True, exist_ok=True, mode=0o700)
+        final_path = directory / (
+            f"runner-input-{record_index:06d}-{request_key}.json")
+        temporary_path = directory / (
+            f".{final_path.name}.tmp-{_os.getpid()}")
+        if final_path.exists() or temporary_path.exists():
+            raise RuntimeError(
+                f"P57 TiTO runner witness collision: {final_path.name}")
+        descriptor = _os.open(
+            temporary_path, _os.O_CREAT | _os.O_EXCL | _os.O_WRONLY, 0o600)
+        try:
+            _os.write(descriptor, encoded)
+            _os.fsync(descriptor)
+        finally:
+            _os.close(descriptor)
+        _os.replace(temporary_path, final_path)
+        print(
+            "[CANON_P57_TITO_RUNNER_WITNESS] "
+            f"record={record_index} request={request_id} "
+            f"prompt_tokens={prompt_tokens} "
+            f"prompt_sha256={record['prompt_sha256']}",
+            flush=True,
+        )
+
