+def _p35_metadata_dump(arm, payload, meta):
+    """Write compact, arm-labelled P35 metadata without hidden/logit tensors."""
+    import json as _json
+    import numpy as _np
+    from pathlib import Path as _Path
+    if arm not in ("A", "B"):
+        raise RuntimeError(f"unsupported P35 metadata arm: {arm!r}")
+    directory = _Path(_P35_METADATA_DIR)
+    directory.mkdir(parents=True, exist_ok=True)
+    seq = _P35_METADATA_SEQ["n"]
+    _P35_METADATA_SEQ["n"] += 1
+    arrays, describe = {}, {}
+    for key, value in payload.items():
+        if isinstance(value, dict) and "array" in value:
+            arrays[key] = value["array"]
+            describe[key] = {
+                name: field for name, field in value.items() if name != "array"
+            }
+        else:
+            describe[key] = value
+    base = directory / f"p35_metadata_{seq:04d}"
+    json_path = _Path(str(base) + ".json")
+    npz_path = _Path(str(base) + ".npz")
+    if json_path.exists() or npz_path.exists():
+        raise RuntimeError(f"P35 metadata evidence collision at {base}")
+    _np.savez(npz_path, **arrays)
+    with json_path.open("x", encoding="utf-8") as stream:
+        _json.dump({
+            "schema_version": 1,
+            "arm": arm,
+            "seq": seq,
+            "describe": describe,
+            "meta": meta,
+        }, stream, indent=2, default=str)
+    print(
+        f"[PATHTRACE] P35_METADATA arm={arm} seq={seq} "
+        f"arrays={sorted(arrays)} path={base}",
+        flush=True,
+    )
+
+
 
