+def _p38_kv_observer_effective_sharding(array):
+    """Return a repr-independent device-to-slice sharding contract."""
+    sharding = getattr(array, "sharding", None)
+    if sharding is None or not hasattr(sharding, "devices_indices_map"):
+        raise RuntimeError(
+            "P38 KV observer cache has no inspectable effective sharding")
+    shape = tuple(int(value) for value in array.shape)
+    mapping = sharding.devices_indices_map(shape)
+    devices = []
+    for device, index in mapping.items():
+        normalized_index = []
+        if len(index) != len(shape):
+            raise RuntimeError(
+                "P38 KV observer sharding index rank differs from cache rank")
+        for extent, component in zip(shape, index, strict=True):
+            if isinstance(component, slice):
+                start, stop, step = component.indices(extent)
+                normalized_index.append({
+                    "kind": "slice",
+                    "start": int(start),
+                    "stop": int(stop),
+                    "step": int(step),
+                })
+            else:
+                normalized_index.append({
+                    "kind": "index",
+                    "value": int(component),
+                })
+        coords = getattr(device, "coords", ()) or ()
+        devices.append({
+            "platform": str(getattr(device, "platform", "")),
+            "process_index": int(getattr(device, "process_index", -1)),
+            "id": int(getattr(device, "id", -1)),
+            "coords": [int(value) for value in coords],
+            "core_on_chip": int(getattr(device, "core_on_chip", -1)),
+            "index": normalized_index,
+        })
+    devices.sort(key=lambda item: (
+        item["platform"], item["process_index"], item["id"],
+        item["coords"], item["core_on_chip"]))
+    if not devices:
+        raise RuntimeError("P38 KV observer effective sharding is empty")
+    return {
+        "schema": "p38-effective-device-sharding-v1",
+        "global_shape": list(shape),
+        "devices": devices,
+    }
+
