+            _P58_CONTINUE_KV_MIN_PREFIX <= pre_burst_prefix <
+            _P58_CONTINUE_KV_MAX_PREFIX):
+        dp_rank = _p38_kv_observer_dp_rank(req_ids_dp, request_id)
+        pages = _p38_primary_pages(request_state.block_ids)
+        if not pages:
+            raise RuntimeError("P58 continue-KV candidate has no cache pages")
+        candidate = {
