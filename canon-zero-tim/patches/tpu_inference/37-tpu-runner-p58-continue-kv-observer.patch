+def _p58_continue_kv_after_burst(
+        runner, scheduler_output, req_ids_dp, output):
+    """Fingerprint one live continue-decode request and its clean rescore.
+
+    This hook is deliberately outside the donated while-loop.  It selects the
+    first serial request whose pre-burst logical prefix is inside the signed
+    environment-seam window, then delegates both A and B capture to the
+    existing bounded P38 integer fingerprint implementation.
+    """
+    if _P58_CONTINUE_KV_DIAGNOSTIC != "1":
+        return
+    if not _P38_KV_OBSERVER_DIR:
+        raise RuntimeError("P58 continue-KV diagnostic has no output directory")
+    if _P38_KV_OBSERVER_MAX_CANDIDATES != 1:
+        raise RuntimeError("P58 continue-KV diagnostic requires one candidate")
+    if isinstance(output, AsyncTPUModelRunnerOutput):
+        raise RuntimeError("P58 continue-KV diagnostic forbids async scheduling")
+
+    _P58_CONTINUE_KV_STATE["bursts"] += 1
+    request_ids = [str(value) for value in output.req_ids]
+    if len(request_ids) != 1:
+        raise RuntimeError(
+            "P58 continue-KV diagnostic requires exactly one active request")
+    request_id = request_ids[0]
+    request_state = runner.requests.get(request_id)
+    if request_state is None:
+        raise RuntimeError(
+            f"P58 continue-KV request disappeared: {request_id}")
+    scheduled_tokens = int(
+        scheduler_output.num_scheduled_tokens.get(request_id, 0))
+    if scheduled_tokens <= 0:
+        raise RuntimeError("P58 continue-KV burst has no scheduled tokens")
+    pre_burst_prefix = int(request_state.num_computed_tokens)
