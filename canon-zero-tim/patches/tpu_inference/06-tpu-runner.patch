+def _canon_logprob_m() -> Optional[int]:
+    """Return the opt-in canonical logprob row count, failing closed on bad input."""
+    raw = os.environ.get("CANON_LOGPROB_M", "")
+    if not raw:
+        return None
+    try:
+        value = int(raw)
+    except ValueError as exc:
+        raise ValueError(f"CANON_LOGPROB_M must be an integer, got {raw!r}") from exc
+    if value <= 0:
+        raise ValueError(f"CANON_LOGPROB_M must be positive, got {value}")
+    return value
+
+
+def _canon_pad_logprob_inputs(
+    logits: jax.Array,
+    token_ids: jax.Array,
+    target_rows: int,
+) -> tuple[jax.Array, jax.Array, int]:
+    """Pad decode logprob inputs to one canonical M without changing real rows."""
+    rows = int(logits.shape[0])
+    if int(token_ids.shape[0]) != rows:
+        raise ValueError(
+            f"logprob logits/token row mismatch: {rows} vs {token_ids.shape[0]}")
+    if rows > target_rows:
+        raise ValueError(
+            f"decode logprob rows {rows} exceed CANON_LOGPROB_M={target_rows}")
+    if rows == target_rows:
+        return logits, token_ids, rows
+    pad = target_rows - rows
+    logits = jnp.pad(logits, ((0, pad), (0, 0)), constant_values=0.0)
+    token_pad = [(0, pad)] + [(0, 0)] * (token_ids.ndim - 1)
+    token_ids = jnp.pad(token_ids, token_pad, constant_values=0)
+    return logits, token_ids, rows
+
