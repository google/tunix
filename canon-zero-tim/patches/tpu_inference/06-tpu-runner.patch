+def _p18_dump(tag, payload, meta):
+    """Write one capture record. Arrays go to .npz, everything else to .json."""
+    import json as _json
+    import numpy as _np
+    from pathlib import Path as _Path
+    d = _Path(_P18_CAPTURE_DIR)
+    d.mkdir(parents=True, exist_ok=True)
+    seq = _P18_SEQ["n"]
