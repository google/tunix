+def _p18_weight_fingerprint(state_leaves):
+    """Exact bitwise checksum over the weights, computed on-device (cheap).
+
+    Bitcast each leaf to its unsigned integer view and sum as uint64: this is an EXACT function of
+    the bit patterns, so any single-bit weight difference between two processes changes it.  A
+    float sum would not be exact and a host-side hash would mean transferring ~64 GB.
+    """
+    import jax.numpy as _jnp
+    tot, n_el = 0, 0
+    per = []
+    for i, leaf in enumerate(state_leaves):
+        a = getattr(leaf, "value", leaf)
+        if not hasattr(a, "dtype") or not hasattr(a, "shape"):
+            per.append({"i": i, "kind": type(a).__name__})
+            continue
+        itemsize = _jnp.dtype(a.dtype).itemsize
+        uview = {1: _jnp.uint8, 2: _jnp.uint16, 4: _jnp.uint32, 8: _jnp.uint64}.get(itemsize)
+        if uview is None:
+            per.append({"i": i, "shape": tuple(a.shape), "dtype": str(a.dtype), "sum": None})
+            continue
+        try:
+            v = int(_jnp.sum(jax.lax.bitcast_convert_type(a, uview).astype(_jnp.uint64)))
+        except Exception as e:                       # keep going; report which leaf failed
+            per.append({"i": i, "shape": tuple(a.shape), "dtype": str(a.dtype),
+                        "error": str(e)[:60]})
+            continue
+        tot = (tot + v) % (1 << 64)
+        n_el += int(a.size)
+        if i < 4 or i >= len(state_leaves) - 2:
+            per.append({"i": i, "shape": tuple(a.shape), "dtype": str(a.dtype), "sum": v})
+    return {"n_leaves": len(state_leaves), "n_elements": n_el, "bitsum_u64": tot,
+            "sample_leaves": per}
