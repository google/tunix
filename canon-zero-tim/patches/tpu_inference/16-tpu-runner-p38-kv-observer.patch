+def _p38_kv_observer_note_candidate(incident_record):
+    """Remember one deep, naturally single-active decode request per round."""
+    if not _P38_KV_OBSERVER_DIR:
+        return
+    if int(incident_record["scheduled_request_count"]) != 1:
+        return
+    requests = incident_record["requests"]
+    if len(requests) != 1:
+        raise RuntimeError(
+            "P38 KV observer single-active incident did not map one request")
+    diagnostic_round = int(incident_record["diagnostic_round"])
+    if diagnostic_round in _P38_KV_OBSERVER_CANDIDATE_ROUNDS:
+        return
+    if len(_P38_KV_OBSERVER_CANDIDATES) >= _P38_KV_OBSERVER_MAX_CANDIDATES:
+        return
+    request = requests[0]
+    request_id = str(request["request_id"])
+    if request_id in _P38_KV_OBSERVER_CANDIDATES:
+        return
+    candidate = {
+        "request_id": request_id,
+        "diagnostic_round": diagnostic_round,
+        "tag_call_index": int(incident_record["call_index"]),
+        "tag_prefix": int(request["num_computed_tokens"]),
+        "tag_dp_rank": int(request["dp_rank"]),
+        "tag_physical_pages": [
+            int(value) for value in request["physical_pages"]
+        ],
+    }
+    _P38_KV_OBSERVER_CANDIDATES[request_id] = candidate
+    _P38_KV_OBSERVER_CANDIDATE_ROUNDS.add(diagnostic_round)
+    print(
+        "[CANON_P38_KV_OBSERVER_CANDIDATE] "
+        f"round={diagnostic_round} request={request_id} "
+        f"call={candidate['tag_call_index']} "
+        f"prefix={candidate['tag_prefix']}",
+        flush=True,
+    )
+
