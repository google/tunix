+def _p38_kv_observer_write(arm, arrays, meta):
+    """Persist one bounded, exclusive NPZ+JSON record and return its index."""
+    import hashlib as _hashlib
+    import io as _io
+    import json as _json
+    import os as _os
+    from pathlib import Path as _Path
+
+    if arm not in ("A", "B"):
+        raise RuntimeError(f"unsupported P38 KV observer arm: {arm!r}")
+    state = _P38_KV_OBSERVER_STATE
+    record_index = int(state["records"])
+    base = _Path(_P38_KV_OBSERVER_DIR) / (
+        f"p38_kv_observer_{record_index:04d}_{arm.lower()}")
+    npz_path = _Path(str(base) + ".npz")
+    json_path = _Path(str(base) + ".json")
+    if npz_path.exists() or json_path.exists():
+        raise RuntimeError(f"P38 KV observer evidence collision at {base}")
+
+    payload = _io.BytesIO()
+    np.savez(payload, **arrays)
+    npz_bytes = payload.getvalue()
+    npz_sha256 = _hashlib.sha256(npz_bytes).hexdigest()
+    metadata = {
+        **meta,
+        "schema": "p38-live-kv-prefix-table-v1",
+        "arm": arm,
+        "record_index": record_index,
+        "npz_sha256": npz_sha256,
+        "array_keys": sorted(arrays),
+    }
+    json_bytes = (_json.dumps(
+        metadata, sort_keys=True, indent=2, default=str) + "\n").encode()
+    new_bytes = len(npz_bytes) + len(json_bytes)
+    if int(state["bytes"]) + new_bytes > _P38_KV_OBSERVER_MAX_BYTES:
+        raise RuntimeError(
+            "P38 KV observer exceeded its registered output byte bound")
+
+    npz_fd = _os.open(
+        npz_path, _os.O_CREAT | _os.O_EXCL | _os.O_WRONLY, 0o600)
+    try:
+        written = _os.write(npz_fd, npz_bytes)
+        if written != len(npz_bytes):
+            raise RuntimeError("P38 KV observer NPZ write was incomplete")
+        _os.fsync(npz_fd)
+    finally:
+        _os.close(npz_fd)
+    json_fd = _os.open(
+        json_path, _os.O_CREAT | _os.O_EXCL | _os.O_WRONLY, 0o600)
+    try:
+        written = _os.write(json_fd, json_bytes)
+        if written != len(json_bytes):
+            raise RuntimeError("P38 KV observer JSON write was incomplete")
+        _os.fsync(json_fd)
+    finally:
+        _os.close(json_fd)
+    if _hashlib.sha256(npz_path.read_bytes()).hexdigest() != npz_sha256:
+        raise RuntimeError("P38 KV observer NPZ self-check failed")
+    state["records"] += 1
+    state["bytes"] += new_bytes
+    print(
+        "[CANON_P38_KV_OBSERVER_RECORD] "
+        f"arm={arm} record={record_index} "
+        f"request={metadata['request_id']} "
+        f"tokens={metadata['target_seq_len']} "
+        f"pages={metadata['logical_pages']} bytes={state['bytes']}",
+        flush=True,
+    )
+    return record_index, npz_sha256
+
