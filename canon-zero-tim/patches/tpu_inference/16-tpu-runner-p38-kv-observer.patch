+def _p38_kv_observer_request_finished(
+        request_state, sampled_ids, seq_len, max_model_len):
+    """Return true only at a host-visible EOS, max-token, or model-limit end."""
+    sampled = [int(value) for value in sampled_ids]
+    sampling_params = getattr(request_state, "sampling_params", None)
+    if sampling_params is None:
+        raise RuntimeError("P38 KV observer request has no sampling params")
+    stop_ids = {
+        int(value) for value in getattr(
+            sampling_params, "all_stop_token_ids", ())
+    }
+    eos_done = bool(sampled and sampled[-1] in stop_ids)
+    max_tokens = getattr(sampling_params, "max_tokens", None)
+    max_done = (
+        max_tokens is not None
+        and len(getattr(request_state, "output_token_ids", ())) >=
+        int(max_tokens)
+    )
+    model_done = int(seq_len) >= int(max_model_len)
+    return eos_done or max_done or model_done
+
+
+def _p38_kv_observer_dp_rank(req_ids_dp, request_id):
+    matches = [
+        int(dp_rank) for dp_rank, request_ids in req_ids_dp.items()
+        if request_id in request_ids
+    ]
+    if len(matches) != 1:
+        raise RuntimeError(
+            "P38 KV observer request does not have one DP rank: "
+            f"request={request_id} matches={matches}")
+    return matches[0]
+
+
+def _p38_kv_observer_prefix_matches(full_token_ids, target_token_ids):
+    full = np.asarray(full_token_ids, dtype=np.int32).reshape(-1)
+    target = np.asarray(target_token_ids, dtype=np.int32).reshape(-1)
+    return bool(full.size >= target.size and np.array_equal(
+        full[:target.size], target))
+
+
+def _p38_kv_observer_padded_pages(physical_pages, max_pages):
+    pages = np.asarray(physical_pages)
+    if pages.ndim != 1 or pages.dtype.kind not in "iu" or pages.size == 0:
+        raise RuntimeError(
+            "P38 KV observer physical pages must be a non-empty integer vector")
+    if pages.size > int(max_pages):
+        raise RuntimeError(
+            "P38 KV observer request exceeds its registered page bound: "
+            f"pages={pages.size} bound={max_pages}")
+    pages = pages.astype(np.int32, copy=False)
+    result = np.full((int(max_pages),), pages[-1], dtype=np.int32)
+    result[:pages.size] = pages
+    return result
+
