+def _p38_kv_observer_after_standard(
+        runner, scheduler_output, req_ids_dp, prompt_rescore_req_ids, output):
+    """Capture finished live A candidates and exact-prefix clean B records."""
+    if not _P38_KV_OBSERVER_DIR:
+        return
+    prompt_rescore_req_ids = {
+        str(value) for value in prompt_rescore_req_ids
+    }
+    is_prompt_rescore = bool(prompt_rescore_req_ids)
+    if not is_prompt_rescore:
+        if output is None:
+            raise RuntimeError("P38 KV observer A path requires sampled output")
+        if isinstance(output, AsyncTPUModelRunnerOutput):
+            raise RuntimeError("P38 KV observer does not admit async scheduling")
+        req_ids = [str(value) for value in output.req_ids]
+        sampled_rows = list(output.sampled_token_ids)
+        if len(req_ids) != len(sampled_rows):
+            raise RuntimeError("P38 KV observer sampled-request rows drifted")
+        for request_id, sampled_ids in zip(req_ids, sampled_rows):
+            scheduled_tokens = int(
+                scheduler_output.num_scheduled_tokens.get(request_id, 0))
+            if scheduled_tokens <= 0:
+                continue
+            candidate = _P38_KV_OBSERVER_CANDIDATES.get(request_id)
+            if candidate is None or any(
+                    record["request_id"] == request_id
+                    for record in _P38_KV_OBSERVER_A_RECORDS):
+                continue
+            request_state = runner.requests.get(request_id)
+            if request_state is None:
+                raise RuntimeError(
+                    f"P38 KV observer candidate disappeared: {request_id}")
+            seq_len = (
+                int(request_state.num_computed_tokens) +
+                scheduled_tokens
+            )
+            if not _p38_kv_observer_request_finished(
+                    request_state, sampled_ids, seq_len,
+                    runner.max_model_len):
+                continue
+            request_index = int(runner.input_batch.req_id_to_index[request_id])
+            token_ids = np.asarray(
+                runner.input_batch.token_ids_cpu[
+                    request_index, :seq_len], dtype=np.int32)
+            dp_rank = _p38_kv_observer_dp_rank(req_ids_dp, request_id)
+            pages = _p38_primary_pages(request_state.block_ids)
+            record = _p38_kv_observer_capture(
+                runner, "A", request_id, dp_rank, token_ids, pages,
