+def _p38_kv_observer_capture(
+        runner, arm, request_id, dp_rank, target_token_ids, physical_pages,
+        candidate):
+    """Capture one fixed-shape all-prefix table from every live KV layer."""
+    import time as _time
+
+    global _P38_KV_OBSERVER_FN
+    target_tokens = np.asarray(target_token_ids, dtype=np.int32).reshape(-1)
+    if target_tokens.size < 1:
+        raise RuntimeError("P38 KV observer target token prefix is empty")
+    if not runner.kv_caches:
+        raise RuntimeError("P38 KV observer found no KV cache layers")
+    cache_shapes = [tuple(int(value) for value in cache.shape)
+                    for cache in runner.kv_caches]
+    if len(set(cache_shapes)) != 1:
+        raise RuntimeError("P38 KV observer cache layer shapes drifted")
+    cache_shape = cache_shapes[0]
+    if int(runner.block_size) != int(cache_shape[1]):
+        raise RuntimeError(
+            "P38 KV observer runner/cache page sizes differ: "
+            f"runner={runner.block_size} cache={cache_shape[1]}")
+    logical_pages = (
+        target_tokens.size + int(runner.block_size) - 1
+    ) // int(runner.block_size)
+    pages = [int(value) for value in physical_pages[:logical_pages]]
+    if len(pages) != logical_pages:
+        raise RuntimeError(
+            "P38 KV observer block table is shorter than the target prefix")
+    padded_local_pages = _p38_kv_observer_padded_pages(
+        pages, _P38_KV_OBSERVER_MAX_PAGES)
+    padded_global_pages = global_page_indices(
+        cache_shape, int(runner.dp_size), int(dp_rank), padded_local_pages)
+    read_bytes = estimate_fingerprint_read_bytes(
+        cache_shapes, _P38_KV_OBSERVER_MAX_PAGES)
+    if read_bytes > _P38_KV_OBSERVER_MAX_READ_BYTES:
+        raise RuntimeError(
+            "P38 KV observer exceeds its registered device-read bound: "
+            f"read={read_bytes} bound={_P38_KV_OBSERVER_MAX_READ_BYTES}")
+    valid_tokens = np.full(
+        (logical_pages,), int(runner.block_size), dtype=np.int32)
+    valid_tokens[-1] = (
+        target_tokens.size -
+        (logical_pages - 1) * int(runner.block_size)
+    )
+    if not 1 <= int(valid_tokens[-1]) <= int(runner.block_size):
+        raise RuntimeError("P38 KV observer final page extent is invalid")
+
+    if _P38_KV_OBSERVER_FN is None:
+        _P38_KV_OBSERVER_FN = jax.jit(
+            fingerprint_kv_cache_layer_prefixes)
+    start = _time.monotonic()
+    result = _P38_KV_OBSERVER_FN(
+        tuple(runner.kv_caches),
+        jnp.asarray(padded_global_pages, dtype=jnp.int32),
+    )
+    aggregates, samples = jax.device_get(result)
+    elapsed = _time.monotonic() - start
+    token_sha256 = _p38_token_history_sha256(target_tokens.tolist())
+    arrays = {
+        "aggregates": np.asarray(aggregates),
+        "samples": np.asarray(samples),
+        "token_ids": target_tokens,
+        "physical_pages": np.asarray(pages, dtype=np.int32),
+        "padded_global_pages": np.asarray(
+            padded_global_pages, dtype=np.int32),
+        "valid_tokens": valid_tokens,
+    }
+    meta = {
+        "request_id": str(request_id),
+        "source_a_request_id": str(candidate.get(
+            "source_a_request_id", candidate["request_id"])),
+        "source_a_record_index": candidate.get("source_a_record_index"),
+        "diagnostic_round": int(candidate["diagnostic_round"]),
+        "tag_call_index": int(candidate["tag_call_index"]),
+        "tag_prefix": int(candidate["tag_prefix"]),
+        "dp_rank": int(dp_rank),
+        "target_seq_len": int(target_tokens.size),
+        "token_history_sha256": token_sha256,
+        "block_size": int(runner.block_size),
+        "logical_pages": int(logical_pages),
+        "observer_pages": int(_P38_KV_OBSERVER_MAX_PAGES),
+        "layer_count": int(len(runner.kv_caches)),
+        "cache_shape": list(cache_shape),
+        "cache_dtype": str(runner.kv_caches[0].dtype),
+        "cache_sharding": str(getattr(
+            runner.kv_caches[0], "sharding", None)),
+        "device_read_bytes": int(read_bytes),
+        "elapsed_seconds": float(elapsed),
+        "fingerprint_claim": "diagnostic_non_cryptographic",
+    }
+    record_index, npz_sha256 = _p38_kv_observer_write(arm, arrays, meta)
+    return {
+        **candidate,
+        "record_index": int(record_index),
+        "npz_sha256": npz_sha256,
+        "target_token_ids": target_tokens.copy(),
+        "target_seq_len": int(target_tokens.size),
+        "token_history_sha256": token_sha256,
+        "logical_pages": int(logical_pages),
+    }
+
