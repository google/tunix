+    def observe(self, kv_cache, x, attention_metadata):
+        layer_input = x
+        hidden_states = self.input_layernorm(x)
+        kv_cache, attn_projected, attention_seams = self.self_attn(
+            kv_cache,
+            hidden_states,
+            attention_metadata,
+            p38_observe=True,
+        )
+        attention_residual = attn_projected + x
+        residual = attention_residual
+        post_attention_norm = self.post_attention_layernorm(
+            attention_residual
+        )
+        mlp_output = self.mlp(post_attention_norm)
+        layer_output = residual + mlp_output
+        checkpoints = (
+            fingerprint_tensor_rows(layer_input),
+            fingerprint_tensor_rows(hidden_states),
+            *attention_seams,
+            fingerprint_tensor_rows(attention_residual),
+            fingerprint_tensor_rows(post_attention_norm),
+            fingerprint_tensor_rows(mlp_output),
+            fingerprint_tensor_rows(layer_output),
+        )
+        if len(checkpoints) != len(P38_SEAM_CHECKPOINTS):
+            raise RuntimeError(
+                "P38 seam checkpoint count drifted: "
+                f"{len(checkpoints)} != {len(P38_SEAM_CHECKPOINTS)}"
+            )
+        return kv_cache, layer_output, jnp.stack(checkpoints, axis=1)
+
 
