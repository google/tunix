+def _p38_begin_observer_round(state, diagnostic_round, label):
+    """Give each sealed M15 round its own byte budget without reusing names."""
+    if os.environ.get("CANON_P38_DURABILITY_PROFILE", "") != "m15-wide-v1":
+        return
+    diagnostic_round = int(diagnostic_round)
+    previous = state.get("diagnostic_round")
+    changed = False
+    if previous is None:
+        state["diagnostic_round"] = diagnostic_round
+        changed = True
+    elif diagnostic_round != previous:
+        if diagnostic_round != int(previous) + 1:
+            raise ValueError(
+                "M15 observer diagnostic rounds must increase by one: "
+                f"label={label} previous={previous} current={diagnostic_round}"
+            )
+        state["diagnostic_round"] = diagnostic_round
+        state["bytes"] = 0
+        changed = True
+    if changed:
+        print(
+            "[P38_OBSERVER_ROUND_BUDGET] "
+            f"label={label} round={diagnostic_round} "
+            f"records={state['records']} bytes={state['bytes']}",
+            flush=True,
+        )
