# HBM Peak & Verification measurements for yuxzhang/fix_accum_fp32 on Gemma4-E2B (fsdp=2, tp=2)
# 4 Arms: Depth-1 vs Depth-4, and float32 vs bfloat16 accumulator_dtype

# 1. d1_default (Depth 1, no accumulator allocated -> 0W overhead)
[[COMPILE_REPRO]] arm=d1_default mesh=2x2 train_wall_s=179.9
[[MEM]] arm=d1_default steps=1 dtype=float32 device=0 peak_hbm_gb=11.72 current_hbm_gb=7.36 limit_gb=95.74
[[MEM]] arm=d1_default steps=1 dtype=float32 device=1 peak_hbm_gb=11.71 current_hbm_gb=7.35 limit_gb=95.74
[[MEM]] arm=d1_default steps=1 dtype=float32 device=2 peak_hbm_gb=11.71 current_hbm_gb=7.35 limit_gb=95.74
[[MEM]] arm=d1_default steps=1 dtype=float32 device=3 peak_hbm_gb=11.71 current_hbm_gb=7.35 limit_gb=95.74

# 2. d4_fp32_accum (Depth 4, float32 accumulator -> 2W overhead, bf16 Adam moments via cast-back)
[[COMPILE_REPRO]] arm=d4_fp32_accum mesh=2x2 train_wall_s=242.0
[[MEM]] arm=d4_fp32_accum steps=4 dtype=float32 device=0 peak_hbm_gb=15.46 current_hbm_gb=11.10 limit_gb=95.74
[[MEM]] arm=d4_fp32_accum steps=4 dtype=float32 device=1 peak_hbm_gb=15.45 current_hbm_gb=11.09 limit_gb=95.74
[[MEM]] arm=d4_fp32_accum steps=4 dtype=float32 device=2 peak_hbm_gb=15.45 current_hbm_gb=11.09 limit_gb=95.74
[[MEM]] arm=d4_fp32_accum steps=4 dtype=float32 device=3 peak_hbm_gb=15.45 current_hbm_gb=11.09 limit_gb=95.74

# 3. d4_bf16_accum (Depth 4, bfloat16 accumulator -> 1W overhead, bf16 Adam moments)
[[COMPILE_REPRO]] arm=d4_bf16_accum mesh=2x2 train_wall_s=242.5
[[MEM]] arm=d4_bf16_accum steps=4 dtype=bfloat16 device=0 peak_hbm_gb=13.27 current_hbm_gb=8.91 limit_gb=95.74
[[MEM]] arm=d4_bf16_accum steps=4 dtype=bfloat16 device=1 peak_hbm_gb=13.27 current_hbm_gb=8.91 limit_gb=95.74
[[MEM]] arm=d4_bf16_accum steps=4 dtype=bfloat16 device=2 peak_hbm_gb=13.27 current_hbm_gb=8.91 limit_gb=95.74
[[MEM]] arm=d4_bf16_accum steps=4 dtype=bfloat16 device=3 peak_hbm_gb=13.27 current_hbm_gb=8.91 limit_gb=95.74

