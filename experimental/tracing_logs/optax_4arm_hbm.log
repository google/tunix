# HBM Peak & Parity measurements for official optax.MultiSteps on Gemma4-E2B (fsdp=2, tp=2)
# 4 Arms: Mirroring custom GradientAccumulator arms from fix_accum_fp32_hbm.log

# 1. optax_d1 (Plain adamw, no MultiSteps -> 3W static memory: 1W params + 2W bf16 moments)
[[COMPILE_REPRO]] arm=optax_d1 mesh=2x2 train_wall_s=178.6
[[MEM]] arm=optax_d1 steps=1 dtype=float32 device=0 peak_hbm_gb=7.30 current_hbm_gb=7.30 limit_gb=95.74
[[MEM]] arm=optax_d1 steps=1 dtype=float32 device=1 peak_hbm_gb=7.30 current_hbm_gb=7.30 limit_gb=95.74
[[MEM]] arm=optax_d1 steps=1 dtype=float32 device=2 peak_hbm_gb=7.30 current_hbm_gb=7.30 limit_gb=95.74
[[MEM]] arm=optax_d1 steps=1 dtype=float32 device=3 peak_hbm_gb=7.30 current_hbm_gb=7.30 limit_gb=95.74

# 2. optax_d4_bf16_accum (MultiSteps k=4 -> +1W bf16 accumulator tree, total 4W static memory)
