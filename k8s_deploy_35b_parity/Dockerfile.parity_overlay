# Overlay Dockerfile on top of Yixuan's verified Raiden 35B stack image:
#   gcr.io/cloud-tpu-multipod-dev/yixuannwang_google_com-runner:yixuann-e2e-0917head-v19
#
# Preserves the exact tpu_sync_jax wheel, JAX 0.11.0 / libtpu 0.0.44, and vLLM 51da0ca66,
# while overlaying our 3 parity branches (jfacevedo/k8s-deploy-35b-parity) into both
# /app (on PYTHONPATH) and /opt/venv/lib/python3.12/site-packages/:
#   1. maxtext (GDN left-padding fix + Router Replay + NVIDIA FP32 surgical casts)
#   2. tpu_inference_ref / tpu-inference (attn_gid=3 FullAttentionSpec slot tie-break fix)
#   3. tunix (seq-mask-tis + grpo-loo + distributed vLLM/MaxText Router Replay & FP32 casts)
#
# Build from the parent directory containing maxtext/, tunix/, and tpu_inference_ref/ (or tpu-inference/):
#   docker build --platform linux/amd64 -f Dockerfile.parity_overlay \
#     -t gcr.io/cloud-tpu-multipod-dev/${USER}/tunix_raiden_35b_parity:0918_v1 .

FROM gcr.io/cloud-tpu-multipod-dev/yixuannwang_google_com-runner:yixuann-e2e-0917head-v19

ARG TPU_INF_DIR=tpu_inference_ref

WORKDIR /app

# 1. Overlay MaxText into /app/maxtext and /opt/venv/lib/python3.12/site-packages/
COPY maxtext /app/maxtext
RUN pip install --no-deps -e /app/maxtext && \
    (pip install --no-deps -e /app/maxtext/src/maxtext/integration/vllm 2>/dev/null || true) && \
    mkdir -p /app/maxtext/maxtext && ln -sf /app/maxtext/src /app/maxtext/maxtext/src && \
    cp -rf /app/maxtext/src/maxtext /opt/venv/lib/python3.12/site-packages/

# 2. Overlay Tunix into /app/tunix and /opt/venv/lib/python3.12/site-packages/
COPY tunix/tunix /app/tunix
COPY tunix/pyproject.toml /app/pyproject.toml
RUN (cd /app/tunix && ln -sf . tunix) && \
    pip install --no-deps -e /app && \
    python -m grpc_tools.protoc -I. --python_out=. --grpc_python_out=. tunix/experimental/distributed/runtime/discovery/discovery_service.proto 2>/dev/null || true && \
    cp -rf /app/tunix /opt/venv/lib/python3.12/site-packages/

# 3. Overlay TPU-Inference into /app/tpu-inference and /opt/venv/lib/python3.12/site-packages/
COPY ${TPU_INF_DIR} /app/tpu-inference
RUN cp -rf /app/tpu-inference/tpu_inference /opt/venv/lib/python3.12/site-packages/

ENV PYTHONPATH="/app/maxtext/src:/app:${PYTHONPATH:-}"
ENV ENABLE_ROUTER_REPLAY=1

# Verify vLLM + tpu-inference + tunix + maxtext import compatibility at build time
RUN python3 -c "\
import vllm.model_executor.layers.quantization.modelopt as m; \
import tpu_inference.layers.vllm.quantization.nvfp4; \
import tunix.rl.algo_core; \
import tunix.utils.maxtext_utils; \
print('BUILD CHECK OK: parity overlay installed successfully')"

WORKDIR /app
CMD ["bash"]
