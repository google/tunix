"""Tests for Tunix Vanilla Sampler V2."""

from absl.testing import absltest
import jax
import jax.numpy as jnp
import numpy as np
from tunix.generate import vanilla_sampler_v2


class VanillaSamplerV2Test(absltest.TestCase):

  def test_page_memory_manager_basic(self):
    # Initialize PMM
    pmm = vanilla_sampler_v2.PageMemoryManager(
        num_layers=2,
        num_kv_heads=4,
        head_dim=16,
        page_size=4,
        total_num_pages=10,
        dtype=jnp.float32,
    )
    
    self.assertEqual(len(pmm.free_pages), 10)

    # Allocate pages for request 1
    pages1 = pmm.allocate("req1", 3)
    self.assertEqual(pages1, [0, 1, 2])
    self.assertEqual(len(pmm.free_pages), 7)
    self.assertEqual(pmm.allocations["req1"], [0, 1, 2])

    # Allocate pages for request 2
    pages2 = pmm.allocate("req2", 5)
    self.assertEqual(pages2, [3, 4, 5, 6, 7])
    self.assertEqual(len(pmm.free_pages), 2)

    # Free request 1
    pmm.free("req1")
    self.assertNotIn("req1", pmm.allocations)
    self.assertEqual(len(pmm.free_pages), 5)
    self.assertEqual(pmm.free_pages[-3:], [0, 1, 2])  # Returned to free pool

  def test_page_memory_manager_offload(self):
    pmm = vanilla_sampler_v2.PageMemoryManager(
        num_layers=1,
        num_kv_heads=1,
        head_dim=4,
        page_size=2,
        total_num_pages=5,
        dtype=jnp.float32,
    )

    # Set some initial content to k_pool for pages 0, 1
    pages = pmm.allocate("req1", 2)
    pmm.k_pool = pmm.k_pool.at[0, pages, ...].set(
        jnp.arange(16).reshape(2, 2, 1, 4)
    )

    # Offload to host
    pmm.offload_to_host("req1")
    self.assertIn("req1", pmm.offloaded_caches)
    self.assertNotIn("req1", pmm.allocations)
    self.assertEqual(len(pmm.free_pages), 5)  # Physical pages freed

    # Restore to HBM (will allocate new physical pages)
    new_pages = pmm.restore_to_hbm("req1")
    self.assertEqual(len(pmm.free_pages), 3)
    self.assertEqual(pmm.allocations["req1"], new_pages)

    # Check restored content
    expected_content = jnp.arange(16).reshape(2, 2, 1, 4)
    np.testing.assert_allclose(
        pmm.k_pool[0, new_pages, ...], expected_content, atol=1e-5
    )

  def test_continuous_batcher_scheduler_lifecycle(self):
    pmm = vanilla_sampler_v2.PageMemoryManager(
        num_layers=2,
        num_kv_heads=2,
        head_dim=8,
        page_size=4,
        total_num_pages=20,
        dtype=jnp.float32,
    )
    scheduler = vanilla_sampler_v2.ContinuousBatcherScheduler(
        max_batch_size=2,
        page_size=4,
        pmm=pmm,
        max_pages_per_seq=5,
    )

    # Add 3 requests (queue capacity > max_batch_size)
    scheduler.add_request(
        "req1", prompt_tokens=np.array([1, 2, 3, 4, 5]), max_new_tokens=3, eos_token_id=99
    )
    scheduler.add_request(
        "req2", prompt_tokens=np.array([10, 11]), max_new_tokens=2, eos_token_id=99
    )
    scheduler.add_request(
        "req3", prompt_tokens=np.array([20, 21, 22]), max_new_tokens=4, eos_token_id=99
    )

    self.assertEqual(len(scheduler.queue), 3)

    # Step 1: Slots filled with req1 and req2. Prefill runs.
    # req1 gets 2 pages (5 tokens), req2 gets 1 page (2 tokens).
    completed = scheduler.step(model_step_fn=None)
    self.assertEmpty(completed)
    self.assertEqual(len(scheduler.queue), 1)  # req3 still queued
    self.assertIsNotNone(scheduler.slots[0])
    self.assertIsNotNone(scheduler.slots[1])
    self.assertEqual(scheduler.slots[0].request_id, "req1")
    self.assertEqual(scheduler.slots[1].request_id, "req2")

    # Check that req1 has 1 generated token (42) and is now in decode stage
    self.assertEqual(scheduler.slots[0].generated_tokens, [42])
    self.assertFalse(scheduler.slots[0].is_prefill)

    # Step 2: req2 generates 2nd token and finishes (max_new_tokens=2)
    # req1 generates 2nd token
    completed = scheduler.step(model_step_fn=None)
    self.assertEqual(completed, [("req2", [42, 43])])
    self.assertIsNone(scheduler.slots[1])  # req2 slot is now empty

    # Step 3: req3 should be pulled from queue into slot 1.
    # req1 generates 3rd token and finishes (max_new_tokens=3)
    completed = scheduler.step(model_step_fn=None)
    self.assertEqual(completed, [("req1", [42, 43, 44])])
    self.assertIsNone(scheduler.slots[0])  # req1 slot is now empty
    self.assertIsNotNone(scheduler.slots[1])
    self.assertEqual(scheduler.slots[1].request_id, "req3")

  def test_paged_attention_wrapper_jax(self):
    # Build dummy tensors for the attention pass
    B = 2
    T_q = 1
    num_heads = 4
    head_dim = 8
    num_kv_heads = 2
    page_size = 4
    total_num_pages = 5
    max_pages = 3

    q = jax.random.normal(
        jax.random.PRNGKey(0), (B, T_q, num_heads, head_dim)
    )
    k_pool = jax.random.normal(
        jax.random.PRNGKey(1), (1, total_num_pages, page_size, num_kv_heads, head_dim)
    )
    v_pool = jax.random.normal(
        jax.random.PRNGKey(2), (1, total_num_pages, page_size, num_kv_heads, head_dim)
    )

    block_table = jnp.array([
        [0, 1, 0],
        [2, 3, 4],
    ])
    lengths = jnp.array([5, 10])  # req 1 has 5 active tokens, req 2 has 10

    # Execute JIT attention wrapper using standard fallback path
    attn_out = jax.jit(
        vanilla_sampler_v2.paged_attention_wrapper,
        static_argnames=("page_size",),
    )(
        q=q,
        k_pool=k_pool,
        v_pool=v_pool,
        block_table=block_table,
        lengths=lengths,
        page_size=page_size,
    )

    self.assertEqual(attn_out.shape, (B, T_q, num_heads, head_dim))
    self.assertFalse(jnp.any(jnp.isnan(attn_out)))


if __name__ == "__main__":
  absltest.main()
